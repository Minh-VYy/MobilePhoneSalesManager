@model QuanLyBanDienThoai.Models.DienThoaiModel
@{
    ViewData["Title"] = "Thêm Sản Phẩm Mới (XML)";
}

<div class="admin-card" style="max-width: 920px; margin: 0 auto;">
    <div class="admin-card-header">
        <div>
            <h3 class="admin-card-title">
                <i class="fa-solid fa-circle-plus text-primary"></i>
                <span>Thêm điện thoại mới vào cơ sở dữ liệu XML</span>
            </h3>
            <div class="admin-card-desc">Ghi trực tiếp vào file DienThoai.xml và tự động kiểm tra tính hợp lệ với DienThoai.xsd</div>
        </div>
        <a asp-action="Manage" class="admin-btn admin-btn-secondary admin-btn-sm">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Trở về kho XML</span>
        </a>
    </div>

    <div class="admin-card-body">
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger d-flex align-items-center gap-3 p-3 mb-4 rounded-3" style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.35); color: var(--admin-danger);">
                <i class="fa-solid fa-triangle-exclamation fs-4"></i>
                <div>
                    <strong>Lỗi XSD Schema Validation:</strong> @ViewBag.ErrorMessage
                </div>
            </div>
        }

        @if (ViewBag.ValidationResult != null)
        {
            var val = (QuanLyBanDienThoai.Models.ValidationResultModel)ViewBag.ValidationResult;
            if (!val.IsValid)
            {
                <div class="alert alert-danger p-3 mb-4 rounded-3" style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.35); color: var(--admin-danger);">
                    <strong>Chi tiết lỗi vi phạm Schema:</strong>
                    <ul class="mb-0 mt-2 ps-3">
                        @foreach (var err in val.Errors)
                        {
                            <li>[Dòng @err.LineNumber, Cột @err.LinePosition]: @err.Message</li>
                        }
                    </ul>
                </div>
            }
        }

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-6 mb-3">
                    <label class="admin-form-label">Mã Sản Phẩm (Định dạng XSD: SPxxx):</label>
                    <input asp-for="MaSP" class="admin-form-control" placeholder="Ví dụ: SP007 (Để trống để tự tăng)" />
                    <small class="text-muted" style="font-size: 11.5px;">Để trống hệ thống sẽ tự sinh mã SP tiếp theo.</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="admin-form-label">Tên Điện Thoại (*):</label>
                    <input asp-for="TenSP" class="admin-form-control" placeholder="Ví dụ: iPhone 16 Pro Max 256GB" required />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="admin-form-label">Hãng Sản Xuất (*):</label>
                    <select asp-for="MaHang" class="admin-form-control">
                        <option value="APPLE">Apple (iPhone)</option>
                        <option value="SAMSUNG">Samsung</option>
                        <option value="XIAOMI">Xiaomi</option>
                        <option value="OPPO">OPPO</option>
                        <option value="GOOGLE">Google Pixel</option>
                        <option value="KHAC">Hãng khác</option>
                    </select>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="admin-form-label">Giá Bán (VNĐ) (*):</label>
                    <input asp-for="GiaBan" type="number" step="100000" class="admin-form-control" required />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="admin-form-label">Số Lượng Tồn Kho (*):</label>
                    <input asp-for="SoLuongTon" type="number" class="admin-form-control" required />
                </div>

                <div class="col-12 mt-2 mb-2">
                    <div class="d-flex align-items-center gap-2 pb-2 border-bottom" style="border-color: var(--admin-card-border) !important;">
                        <i class="fa-solid fa-microchip text-primary"></i>
                        <h4 class="mb-0 fw-bold" style="font-size: 14.5px; color: var(--admin-text-main);">Thông Số Kỹ Thuật (Node XML ThongSoKyThuat)</h4>
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="admin-form-label">Màn hình:</label>
                    <input asp-for="ThongSo.ManHinh" class="admin-form-control" placeholder="Ví dụ: 6.9 inch OLED 120Hz" />
                </div>

                <div class="col-md-3 mb-3">
                    <label class="admin-form-label">Dung lượng RAM:</label>
                    <input asp-for="ThongSo.RAM" class="admin-form-control" placeholder="Ví dụ: 8GB" />
                </div>

                <div class="col-md-3 mb-3">
                    <label class="admin-form-label">Bộ nhớ trong (ROM):</label>
                    <input asp-for="ThongSo.BoNhoTrong" class="admin-form-control" placeholder="Ví dụ: 256GB" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="admin-form-label">Dung lượng Pin / Sạc:</label>
                    <input asp-for="ThongSo.Pin" class="admin-form-control" placeholder="Ví dụ: 4685 mAh, Sạc nhanh 45W" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="admin-form-label">Vi xử lý (Chip):</label>
                    <input asp-for="ThongSo.Chip" class="admin-form-control" placeholder="Ví dụ: Apple A18 Pro" />
                </div>

                <div class="col-md-12 mb-3">
                    <label class="admin-form-label">Đường dẫn Hình ảnh (URL):</label>
                    <input asp-for="HinhAnh" class="admin-form-control" placeholder="https://..." />
                </div>

                <div class="col-md-12 mb-4">
                    <label class="admin-form-label">Mô tả sản phẩm:</label>
                    <textarea asp-for="MoTa" rows="3" class="admin-form-control" style="height: auto;" placeholder="Mô tả chi tiết tính năng sản phẩm..."></textarea>
                </div>

                <div class="col-md-12 d-flex justify-content-end gap-2 pt-3 border-top" style="border-color: var(--admin-card-border) !important;">
                    <a asp-action="Manage" class="admin-btn admin-btn-secondary">Hủy bỏ</a>
                    <button type="submit" class="admin-btn admin-btn-primary">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>Lưu vào DienThoai.xml</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
