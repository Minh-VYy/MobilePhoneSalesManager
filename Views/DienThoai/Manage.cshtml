@model List<QuanLyBanDienThoai.Models.DienThoaiModel>
@{
    ViewData["Title"] = "Quản Lý Kho Điện Thoại XML";

    int tongSanPham = Model.Count;
    int tongTonKho = Model.Sum(x => x.SoLuongTon);
    int sapHetHang = Model.Count(x => x.SoLuongTon < 5);
    decimal tongGiaTri = Model.Sum(x => x.GiaBan * x.SoLuongTon);
}

<!-- ================= KPI STATS TELEMETRY ================= -->
<div class="admin-stats-grid">
    <div class="admin-stat-card icon-blue">
        <div class="admin-stat-top">
            <div class="admin-stat-icon">
                <i class="fa-solid fa-mobile-screen"></i>
            </div>
            <span class="admin-stat-pill pill-up">
                <i class="fa-solid fa-code"></i> XML Nodes
            </span>
        </div>
        <div class="admin-stat-value">@tongSanPham</div>
        <div class="admin-stat-label">Tổng Mẫu Điện Thoại XML</div>
    </div>

    <div class="admin-stat-card icon-emerald">
        <div class="admin-stat-top">
            <div class="admin-stat-icon">
                <i class="fa-solid fa-boxes-stacked"></i>
            </div>
            <span class="admin-stat-pill pill-up">
                <i class="fa-solid fa-cubes"></i> Tồn kho
            </span>
        </div>
        <div class="admin-stat-value">@tongTonKho.ToString("N0")</div>
        <div class="admin-stat-label">Tổng Số Lượng Tồn Kho</div>
    </div>

    <div class="admin-stat-card icon-rose">
        <div class="admin-stat-top">
            <div class="admin-stat-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <span class="admin-stat-pill pill-down">
                <span class="admin-pulse-dot"></span> Cảnh báo
            </span>
        </div>
        <div class="admin-stat-value" style="color: var(--admin-danger);">@sapHetHang</div>
        <div class="admin-stat-label">Mẫu Sắp Hết (Tồn &lt; 5)</div>
    </div>

    <div class="admin-stat-card icon-purple">
        <div class="admin-stat-top">
            <div class="admin-stat-icon">
                <i class="fa-solid fa-vault"></i>
            </div>
            <span class="admin-stat-pill pill-up">
                <i class="fa-solid fa-coins"></i> Định giá
            </span>
        </div>
        <div class="admin-stat-value" style="font-size: 20px;">@tongGiaTri.ToString("#,##0") <small style="font-size: 13px; font-weight: 500;">VNĐ</small></div>
        <div class="admin-stat-label">Tổng Giá Trị Kho Hàng XML</div>
    </div>
</div>

<!-- ================= MAIN INVENTORY CONTAINER ================= -->
<div class="admin-card">
    <!-- Header Bar with View Switcher & Action Links -->
    <div class="admin-card-header">
        <div>
            <h2 class="admin-card-title">
                <i class="fa-solid fa-boxes-packing"></i>
                <span>DANH MỤC THIẾT BỊ KHO XML (CRUD)</span>
            </h2>
            <div class="admin-card-desc">Quản lý trực tiếp cấu trúc XML node, thông số kỹ thuật, hình ảnh và phân loại thương hiệu</div>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <!-- View Mode Switcher -->
            <div class="view-toggle-group">
                <button type="button" class="view-toggle-btn active" id="btnTableView" onclick="switchManageView('table')" aria-label="Xem dạng bảng">
                    <i class="fa-solid fa-table-list"></i> Bảng Chi Tiết
                </button>
                <button type="button" class="view-toggle-btn" id="btnGridView" onclick="switchManageView('grid')" aria-label="Xem dạng thẻ">
                    <i class="fa-solid fa-grip"></i> Thẻ Mẫu Động
                </button>
            </div>

            <a asp-action="Create" class="admin-btn admin-btn-primary">
                <i class="fa-solid fa-circle-plus"></i> Thêm Sản Phẩm Mới
            </a>
            <a asp-action="ValidateXsd" class="admin-btn admin-btn-success">
                <i class="fa-solid fa-shield-halved"></i> Kiểm Tra XSD
            </a>
        </div>
    </div>

    <div class="admin-card-body" style="padding-top: 18px;">
        <!-- Live Search & Filter Rail -->
        <div class="filter-bar">
            <div>
                <label class="admin-form-label"><i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm thông số nhanh</label>
                <input type="text" id="manageSearchInput" class="admin-form-control" placeholder="Tên SP, mã SP, chip, RAM, ROM..." onkeyup="filterProducts()" />
            </div>
            <div>
                <label class="admin-form-label"><i class="fa-solid fa-copyright"></i> Hãng sản xuất</label>
                <select id="brandFilter" class="form-select-custom" onchange="filterProducts()">
                    <option value="ALL">-- Tất cả hãng --</option>
                    <option value="APPLE">Apple (iPhone)</option>
                    <option value="SAMSUNG">Samsung</option>
                    <option value="XIAOMI">Xiaomi</option>
                    <option value="OPPO">OPPO</option>
                    <option value="GOOGLE">Google Pixel</option>
                </select>
            </div>
            <div>
                <label class="admin-form-label"><i class="fa-solid fa-warehouse"></i> Trạng thái tồn kho</label>
                <select id="stockFilter" class="form-select-custom" onchange="filterProducts()">
                    <option value="ALL">-- Tất cả trạng thái --</option>
                    <option value="AVAILABLE">Còn hàng (&ge; 5 máy)</option>
                    <option value="LOW">Sắp hết (&lt; 5 máy)</option>
                </select>
            </div>
            <div class="d-flex align-items-end">
                <button type="button" class="admin-btn admin-btn-secondary w-100" onclick="resetFilters()">
                    <i class="fa-solid fa-rotate-right"></i> Đặt lại
                </button>
            </div>
        </div>

        <!-- ================= VIEW 1: HIGH-DENSITY TABLE VIEW ================= -->
        <div id="tableViewContainer" class="admin-table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">Mã SP</th>
                        <th style="width: 70px;">Hình Ảnh</th>
                        <th>Tên Sản Phẩm / Mô Tả</th>
                        <th style="width: 120px;">Hãng SX</th>
                        <th style="width: 130px;">Màu Sắc Mẫu</th>
                        <th style="text-align: right; width: 140px;">Đơn Giá (VNĐ)</th>
                        <th style="width: 120px;">Tồn Kho</th>
                        <th>Thông Số Kỹ Thuật</th>
                        <th style="text-align: right; width: 150px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="manageTableBody">
                    @foreach (var item in Model)
                    {
                        string brandClass = item.MaHang.ToUpper() switch
                        {
                            "APPLE" => "brand-apple",
                            "SAMSUNG" => "brand-samsung",
                            "XIAOMI" => "brand-xiaomi",
                            "OPPO" => "brand-oppo",
                            "GOOGLE" => "brand-google",
                            _ => "brand-other"
                        };

                        string searchStr = (item.MaSP + " " + item.TenSP + " " + item.TenHang + " " + item.ThongSo.RAM + " " + item.ThongSo.BoNhoTrong + " " + item.ThongSo.Chip).ToLower();

                        <tr class="product-row"
                            data-masp="@item.MaSP"
                            data-tensp="@item.TenSP"
                            data-tenhang="@item.TenHang"
                            data-mahang="@item.MaHang.ToUpper()"
                            data-giaban="@item.GiaBan.ToString("#,##0")"
                            data-giabanraw="@item.GiaBan"
                            data-stock="@item.SoLuongTon"
                            data-ram="@item.ThongSo.RAM"
                            data-bonho="@item.ThongSo.BoNhoTrong"
                            data-chip="@item.ThongSo.Chip"
                            data-manhinh="@item.ThongSo.ManHinh"
                            data-pin="@item.ThongSo.Pin"
                            data-hinhanh="@item.HinhAnh"
                            data-mota="@item.MoTa"
                            data-search="@searchStr">
                            <td class="cell-code">@item.MaSP</td>
                            <td>
                                <div style="width: 50px; height: 50px; border-radius: 8px; overflow: hidden; background: rgba(255,255,255,0.04); border: 1px solid var(--admin-card-border); display: flex; align-items: center; justify-content: center;">
                                    <img src="@item.HinhAnh" alt="@item.TenSP" class="product-thumb-img" style="max-width: 100%; max-height: 100%; object-fit: contain;"
                                         onerror="this.src='https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&amp;fit=crop&amp;w=600&amp;q=80'" />
                                </div>
                            </td>
                            <td>
                                <div style="font-weight: 600; color: var(--admin-text-main); margin-bottom: 2px;">@item.TenSP</div>
                                <div style="font-size: 11.5px; color: var(--admin-text-muted); max-width: 260px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@item.MoTa</div>
                            </td>
                            <td>
                                <span class="admin-badge-brand @brandClass">
                                    <i class="fa-solid fa-mobile"></i> @item.TenHang
                                </span>
                            </td>
                            <td>
                                <div class="color-swatch-list">
                                    <span class="color-dot" style="background: #2D3748;" title="Màu Tối Titan" onclick="changeRowImage(this, 'https://images.unsplash.com/photo-1695048133142-1a20484d2569?auto=format&amp;fit=crop&amp;w=600&amp;q=80')"></span>
                                    <span class="color-dot" style="background: #E2E8F0;" title="Màu Sáng Bạc" onclick="changeRowImage(this, 'https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&amp;fit=crop&amp;w=600&amp;q=80')"></span>
                                    <span class="color-dot" style="background: #3182CE;" title="Màu Xanh Biển Sâu" onclick="changeRowImage(this, 'https://images.unsplash.com/photo-1610945265064-0e34e5519bbf?auto=format&amp;fit=crop&amp;w=600&amp;q=80')"></span>
                                </div>
                            </td>
                            <td class="cell-num" style="color: var(--amber-500); font-size: 14px;">
                                @item.GiaBan.ToString("#,##0") <small style="font-size: 11px; color: var(--admin-text-faint);">đ</small>
                            </td>
                            <td>
                                @if (item.SoLuongTon < 5)
                                {
                                    <span class="admin-stat-pill pill-down">
                                        <span class="admin-pulse-dot"></span> @item.SoLuongTon (Sắp hết)
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-stat-pill pill-up">
                                        @item.SoLuongTon máy
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    <span class="spec-chip" title="Dung lượng RAM"><i class="fa-solid fa-memory"></i> @item.ThongSo.RAM</span>
                                    <span class="spec-chip" title="Bộ nhớ ROM"><i class="fa-solid fa-hard-drive"></i> @item.ThongSo.BoNhoTrong</span>
                                    <span class="spec-chip" title="Vi xử lý"><i class="fa-solid fa-microchip"></i> @item.ThongSo.Chip</span>
                                </div>
                            </td>
                            <td class="cell-actions">
                                <div class="d-inline-flex gap-1">
                                    <button type="button" class="admin-btn admin-btn-secondary admin-btn-sm"
                                            onclick="openVariantModalFromEl(this)"
                                            title="Xem mẫu màu & phiên bản động">
                                        <i class="fa-solid fa-sliders"></i> Mẫu
                                    </button>
                                    <a asp-action="Edit" asp-route-id="@item.MaSP" class="admin-btn admin-btn-warning admin-btn-sm" title="Chỉnh sửa XML node">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.MaSP" method="post" style="display:inline;" onsubmit="return confirm('Xác nhận xóa sản phẩm XML này khỏi kho?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm" title="Xóa sản phẩm">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ================= VIEW 2: DYNAMIC GRID CARDS VIEW ================= -->
        <div id="gridViewContainer" class="phone-grid" style="display: none;">
            @foreach (var item in Model)
            {
                string brandClass = item.MaHang.ToUpper() switch
                {
                    "APPLE" => "brand-apple",
                    "SAMSUNG" => "brand-samsung",
                    "XIAOMI" => "brand-xiaomi",
                    "OPPO" => "brand-oppo",
                    "GOOGLE" => "brand-google",
                    _ => "brand-other"
                };

                string searchStr = (item.MaSP + " " + item.TenSP + " " + item.TenHang + " " + item.ThongSo.RAM + " " + item.ThongSo.BoNhoTrong + " " + item.ThongSo.Chip).ToLower();

                <div class="phone-card product-card-item"
                     data-masp="@item.MaSP"
                     data-tensp="@item.TenSP"
                     data-tenhang="@item.TenHang"
                     data-mahang="@item.MaHang.ToUpper()"
                     data-giaban="@item.GiaBan.ToString("#,##0")"
                     data-giabanraw="@item.GiaBan"
                     data-stock="@item.SoLuongTon"
                     data-ram="@item.ThongSo.RAM"
                     data-bonho="@item.ThongSo.BoNhoTrong"
                     data-chip="@item.ThongSo.Chip"
                     data-manhinh="@item.ThongSo.ManHinh"
                     data-pin="@item.ThongSo.Pin"
                     data-hinhanh="@item.HinhAnh"
                     data-mota="@item.MoTa"
                     data-search="@searchStr">

                    <span class="phone-badge">@item.MaSP</span>

                    <div class="phone-img-box">
                        <img id="card-img-@item.MaSP" src="@item.HinhAnh" alt="@item.TenSP" onerror="this.src='https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&amp;fit=crop&amp;w=600&amp;q=80'" />
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="admin-badge-brand @brandClass">@item.TenHang</span>
                        @if (item.SoLuongTon < 5)
                        {
                            <span class="admin-stat-pill pill-down">
                                <span class="admin-pulse-dot"></span> Tồn: @item.SoLuongTon
                            </span>
                        }
                        else
                        {
                            <span class="admin-stat-pill pill-up">
                                Tồn: @item.SoLuongTon
                            </span>
                        }
                    </div>

                    <h3 class="phone-title">@item.TenSP</h3>

                    <!-- Interactive Dynamic Color Swatches -->
                    <div class="d-flex align-items-center justify-content-between mb-2 pb-2" style="border-bottom: 1px solid var(--admin-card-border);">
                        <small style="color: var(--admin-text-faint); font-size: 11.5px;">Màu mẫu:</small>
                        <div class="color-swatch-list">
                            <span class="color-dot active" style="background: #2D3748;" title="Màu Tối Titan" onclick="changeCardImage('@item.MaSP', 'https://images.unsplash.com/photo-1695048133142-1a20484d2569?auto=format&amp;fit=crop&amp;w=600&amp;q=80', this)"></span>
                            <span class="color-dot" style="background: #E2E8F0;" title="Màu Bạc Tự Nhiên" onclick="changeCardImage('@item.MaSP', 'https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&amp;fit=crop&amp;w=600&amp;q=80', this)"></span>
                            <span class="color-dot" style="background: #3182CE;" title="Màu Xanh Cực Quang" onclick="changeCardImage('@item.MaSP', 'https://images.unsplash.com/photo-1610945265064-0e34e5519bbf?auto=format&amp;fit=crop&amp;w=600&amp;q=80', this)"></span>
                        </div>
                    </div>

                    <div class="phone-specs mb-3">
                        <div><i class="fa-solid fa-microchip" style="color: var(--admin-primary); margin-right: 4px;"></i> @item.ThongSo.Chip</div>
                        <div><i class="fa-solid fa-memory" style="color: var(--admin-primary); margin-right: 4px;"></i> RAM: @item.ThongSo.RAM | ROM: @item.ThongSo.BoNhoTrong</div>
                    </div>

                    <div class="phone-footer">
                        <div class="phone-price">@item.GiaBan.ToString("#,##0") <small style="font-size: 11px;">đ</small></div>
                        <div class="d-flex gap-1">
                            <button type="button" class="admin-btn admin-btn-secondary admin-btn-sm"
                                    onclick="openVariantModalFromEl(this)"
                                    title="Xem chi tiết phiên bản">
                                <i class="fa-solid fa-eye"></i> Mẫu
                            </button>
                            <a asp-action="Edit" asp-route-id="@item.MaSP" class="admin-btn admin-btn-warning admin-btn-sm">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- ================= DYNAMIC VARIANT EXPLORER MODAL ================= -->
<div id="variantModal" class="modal-backdrop-custom" onclick="if(event.target === this) closeVariantModal()" role="dialog" aria-modal="true" aria-labelledby="modalPhoneTitle">
    <div class="modal-card-custom">
        <div class="modal-header-custom">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-sliders" style="color: var(--admin-primary); font-size: 18px;"></i>
                <h5 class="mb-0 fw-bold" id="modalPhoneTitle" style="color: var(--admin-text-main);">Khám Phá Các Mẫu Điện Thoại Động</h5>
            </div>
            <button type="button" class="admin-icon-btn" onclick="closeVariantModal()" aria-label="Đóng cửa sổ">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="modal-body-custom">
            <div class="row g-4">
                <div class="col-md-5 text-center">
                    <div style="background: rgba(255, 255, 255, 0.04); padding: 1.5rem; border-radius: var(--radius-md); border: 1px solid var(--admin-card-border); height: 260px; display: flex; align-items: center; justify-content: center;">
                        <img id="modalImgPreview" src="" alt="Phone preview" style="max-height: 100%; max-width: 100%; object-fit: contain; transition: transform 0.2s ease;" />
                    </div>
                    <div class="mt-3">
                        <label class="admin-form-label mb-2" style="font-size: 11px; letter-spacing: 0.5px; text-transform: uppercase;">CHỌN MẪU MÀU SẮC ĐỘNG</label>
                        <div class="d-flex justify-content-center gap-3" id="modalColorDots">
                            <!-- Populated dynamically via JS -->
                        </div>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span id="modalBrandBadge" class="admin-badge-brand brand-apple">Brand</span>
                        <span style="font-family: var(--font-mono); font-size: 12px; color: var(--admin-text-muted);">Mã SP: <strong id="modalMaSP" style="color: var(--admin-primary);">SP000</strong></span>
                    </div>

                    <h4 id="modalName" style="font-family: var(--font-display); font-weight: 700; color: var(--admin-text-main); margin-bottom: 12px;">Tên sản phẩm</h4>

                    <div class="mb-3">
                        <label class="admin-form-label mb-2" style="font-size: 11px; letter-spacing: 0.5px; text-transform: uppercase;">PHIÊN BẢN BỘ NHỚ (GIÁ ĐIỀU CHỈNH)</label>
                        <div class="d-flex gap-2" id="modalStorageChips">
                            <button type="button" class="variant-btn-chip active" onclick="selectStorageTier(this, 0)">256GB (Gốc)</button>
                            <button type="button" class="variant-btn-chip" onclick="selectStorageTier(this, 3000000)">512GB (+3Tr)</button>
                            <button type="button" class="variant-btn-chip" onclick="selectStorageTier(this, 8000000)">1TB (+8Tr)</button>
                        </div>
                    </div>

                    <div class="p-3 mb-3" style="background: rgba(255, 255, 255, 0.03); border-radius: var(--radius-sm); border: 1px solid var(--admin-card-border);">
                        <div class="row g-2" style="font-size: 13px; color: var(--admin-text-muted);">
                            <div class="col-6"><strong style="color: var(--admin-text-main);">Màn hình:</strong> <span id="modalManHinh">-</span></div>
                            <div class="col-6"><strong style="color: var(--admin-text-main);">Chip vi xử lý:</strong> <span id="modalChip">-</span></div>
                            <div class="col-6"><strong style="color: var(--admin-text-main);">RAM / ROM:</strong> <span id="modalRamRom">-</span></div>
                            <div class="col-6"><strong style="color: var(--admin-text-main);">Pin & Sạc:</strong> <span id="modalPin">-</span></div>
                        </div>
                    </div>

                    <p id="modalMoTa" style="font-size: 12.5px; line-height: 1.6; color: var(--admin-text-muted);"></p>

                    <div class="d-flex justify-content-between align-items-center pt-3 mt-4" style="border-top: 1px solid var(--admin-card-border);">
                        <div>
                            <small style="color: var(--admin-text-faint); display: block; font-size: 11px;">Giá ước tính phiên bản:</small>
                            <span style="font-family: var(--font-mono); font-size: 20px; font-weight: 700; color: var(--amber-500);" id="modalPrice">0 VNĐ</span>
                        </div>
                        <div class="d-flex gap-2">
                            <a id="modalEditBtn" href="#" class="admin-btn admin-btn-primary">
                                <i class="fa-solid fa-pen-to-square"></i> Sửa Dữ Liệu XML
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let basePriceNumeric = 0;

        // Dynamic view switcher (Table vs Grid Cards)
        function switchManageView(viewType) {
            const tableCont = document.getElementById('tableViewContainer');
            const gridCont = document.getElementById('gridViewContainer');
            const btnTable = document.getElementById('btnTableView');
            const btnGrid = document.getElementById('btnGridView');

            if (viewType === 'grid') {
                tableCont.style.display = 'none';
                gridCont.style.display = 'grid';
                btnGrid.classList.add('active');
                btnTable.classList.remove('active');
            } else {
                tableCont.style.display = 'block';
                gridCont.style.display = 'none';
                btnTable.classList.add('active');
                btnGrid.classList.remove('active');
            }
        }

        // Realtime filter and search
        function filterProducts() {
            const searchVal = document.getElementById('manageSearchInput').value.toLowerCase().trim();
            const brandVal = document.getElementById('brandFilter').value;
            const stockVal = document.getElementById('stockFilter').value;

            // Filter Table rows
            const rows = document.querySelectorAll('#manageTableBody tr.product-row');
            rows.forEach(row => {
                const searchData = row.getAttribute('data-search') || '';
                const mahang = row.getAttribute('data-mahang') || '';
                const stock = parseInt(row.getAttribute('data-stock') || '0');

                let matchSearch = !searchVal || searchData.includes(searchVal);
                let matchBrand = brandVal === 'ALL' || mahang === brandVal;
                let matchStock = true;
                if (stockVal === 'AVAILABLE') matchStock = stock >= 5;
                if (stockVal === 'LOW') matchStock = stock < 5;

                if (matchSearch && matchBrand && matchStock) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });

            // Filter Grid cards
            const cards = document.querySelectorAll('#gridViewContainer .product-card-item');
            cards.forEach(card => {
                const searchData = card.getAttribute('data-search') || '';
                const mahang = card.getAttribute('data-mahang') || '';
                const stock = parseInt(card.getAttribute('data-stock') || '0');

                let matchSearch = !searchVal || searchData.includes(searchVal);
                let matchBrand = brandVal === 'ALL' || mahang === brandVal;
                let matchStock = true;
                if (stockVal === 'AVAILABLE') matchStock = stock >= 5;
                if (stockVal === 'LOW') matchStock = stock < 5;

                if (matchSearch && matchBrand && matchStock) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function resetFilters() {
            document.getElementById('manageSearchInput').value = '';
            document.getElementById('brandFilter').value = 'ALL';
            document.getElementById('stockFilter').value = 'ALL';
            filterProducts();
        }

        // Change table row image on color dot click
        function changeRowImage(dotEl, newSrc) {
            const tr = dotEl.closest('tr');
            const img = tr.querySelector('.product-thumb-img');
            if (img) img.src = newSrc;

            const dots = tr.querySelectorAll('.color-dot');
            dots.forEach(d => d.classList.remove('active'));
            dotEl.classList.add('active');
        }

        // Change card image on color dot click
        function changeCardImage(maSp, newSrc, dotEl) {
            const img = document.getElementById(`card-img-${maSp}`);
            if (img) img.src = newSrc;

            const dots = dotEl.closest('.color-swatch-list').querySelectorAll('.color-dot');
            dots.forEach(d => d.classList.remove('active'));
            dotEl.classList.add('active');
        }

        // Open Dynamic Variant Explorer Modal from Element
        function openVariantModalFromEl(btn) {
            const el = btn.closest('[data-masp]');
            if (!el) return;

            const maSp = el.getAttribute('data-masp');
            const tenSp = el.getAttribute('data-tensp');
            const tenHang = el.getAttribute('data-tenhang');
            const giaBan = el.getAttribute('data-giaban');
            const giaBanRaw = parseFloat(el.getAttribute('data-giabanraw') || '0');
            const tonKho = el.getAttribute('data-stock');
            const ram = el.getAttribute('data-ram');
            const boNho = el.getAttribute('data-bonho');
            const chip = el.getAttribute('data-chip');
            const manHinh = el.getAttribute('data-manhinh');
            const pin = el.getAttribute('data-pin');
            const hinhAnh = el.getAttribute('data-hinhanh');
            const moTa = el.getAttribute('data-mota');

            document.getElementById('modalMaSP').innerText = maSp;
            document.getElementById('modalPhoneTitle').innerText = `Mẫu Động — ${tenSp}`;
            document.getElementById('modalName').innerText = tenSp;
            document.getElementById('modalBrandBadge').innerText = tenHang;
            document.getElementById('modalImgPreview').src = hinhAnh;
            document.getElementById('modalManHinh').innerText = manHinh || '6.7 inch High Refresh Rate';
            document.getElementById('modalChip').innerText = chip;
            document.getElementById('modalRamRom').innerText = `${ram} / ${boNho}`;
            document.getElementById('modalPin').innerText = pin || '5000 mAh';
            document.getElementById('modalMoTa').innerText = moTa;
            document.getElementById('modalEditBtn').href = `/DienThoai/Edit/${maSp}`;

            basePriceNumeric = giaBanRaw || 25000000;
            document.getElementById('modalPrice').innerText = giaBan + ' VNĐ';

            // Populate sample color dots dynamically
            const colorContainer = document.getElementById('modalColorDots');
            colorContainer.innerHTML = `
                <span class="color-dot active" style="background: #2c3e50;" title="Màu Xám Không Gian" onclick="selectModalColor(this, '${hinhAnh}')"></span>
                <span class="color-dot" style="background: #ecf0f1;" title="Màu Bạc Tinh Khiết" onclick="selectModalColor(this, 'https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&fit=crop&w=600&q=80')"></span>
                <span class="color-dot" style="background: #3498db;" title="Màu Xanh Thạch Anh" onclick="selectModalColor(this, 'https://images.unsplash.com/photo-1610945265064-0e34e5519bbf?auto=format&fit=crop&w=600&q=80')"></span>
                <span class="color-dot" style="background: #f1c40f;" title="Màu Vàng Ánh Kim" onclick="selectModalColor(this, 'https://images.unsplash.com/photo-1592750475338-74b7b21085ab?auto=format&fit=crop&w=600&q=80')"></span>
            `;

            // Reset storage tier buttons
            const storageChips = document.querySelectorAll('#modalStorageChips .variant-btn-chip');
            storageChips.forEach((b, idx) => {
                if (idx === 0) b.classList.add('active');
                else b.classList.remove('active');
            });

            document.getElementById('variantModal').classList.add('show');
        }

        function closeVariantModal() {
            document.getElementById('variantModal').classList.remove('show');
        }

        function selectModalColor(dotEl, imgSrc) {
            const preview = document.getElementById('modalImgPreview');
            preview.style.transform = 'scale(0.95)';
            setTimeout(() => {
                preview.src = imgSrc;
                preview.style.transform = 'scale(1)';
            }, 100);

            const dots = document.querySelectorAll('#modalColorDots .color-dot');
            dots.forEach(d => d.classList.remove('active'));
            dotEl.classList.add('active');
        }

        function selectStorageTier(btnEl, priceDiff) {
            const chips = document.querySelectorAll('#modalStorageChips .variant-btn-chip');
            chips.forEach(c => c.classList.remove('active'));
            btnEl.classList.add('active');

            const finalPrice = basePriceNumeric + priceDiff;
            document.getElementById('modalPrice').innerText = finalPrice.toLocaleString('vi-VN') + ' VNĐ';
        }

        // Close modal on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeVariantModal();
            }
        });
    </script>
}

