@model List<DienThoaiModel>
@using System.Globalization
@using System.Text.Json
@{ ViewData["Title"] = "Sản phẩm & tồn kho"; var vi = CultureInfo.GetCultureInfo("vi-VN"); }
<header class="overview-heading"><div><p class="overview-eyebrow">Danh mục kinh doanh</p><h1>Sản phẩm & tồn kho</h1><p>Quản lý từng phiên bản, giá bán, thông số và số máy khả dụng.</p></div><a asp-action="Create" class="btn-saas btn-saas-primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> Thêm sản phẩm</a></header>
<section class="overview-metrics" aria-label="Tình trạng kho">
    <article class="overview-metric"><span>Phiên bản kinh doanh</span><strong>@Model.Count</strong><p>@Model.Select(x => x.MaHang).Distinct().Count() thương hiệu</p><i class="fa-solid fa-mobile-screen" aria-hidden="true"></i></article>
    <article class="overview-metric"><span>Tổng số máy trong kho</span><strong>@Model.Sum(x => x.SoLuongTon).ToString("N0", vi)</strong><p>Số lượng có thể phân bổ cho đơn hàng</p><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i></article>
    <article class="overview-metric"><span>Cần nhập thêm (dưới 5 máy)</span><strong>@Model.Count(x => x.SoLuongTon < 5)</strong><p>@Model.Count(x => x.SoLuongTon == 0) phiên bản đã hết hàng</p><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></article>
    <article class="overview-metric"><span>Giá trị tồn theo giá bán</span><strong>@Model.Sum(x => x.SoLuongTon * x.GiaBan).ToString("N0", vi) ₫</strong><p>Giá bán hiện tại × số máy còn kho</p><i class="fa-solid fa-coins" aria-hidden="true"></i></article>
</section>
<section class="admin-card inventory" data-inventory>
    <header class="overview-section-heading"><div><h2>Danh sách phiên bản</h2><p>Lọc và xem nhanh thông tin mà không tải lại trang.</p></div><div class="inventory-view-toggle" role="group" aria-label="Cách hiển thị"><button type="button" data-inventory-view="table" aria-pressed="true"><i class="fa-solid fa-list" aria-hidden="true"></i> Bảng</button><button type="button" data-inventory-view="cards" aria-pressed="false"><i class="fa-solid fa-grip" aria-hidden="true"></i> Thẻ</button></div></header>
    <div class="admin-list-controls"><label>Tìm sản phẩm<input type="search" data-inventory-search placeholder="Tên, mã phiên bản, cấu hình…" /></label><label>Thương hiệu<select data-inventory-brand><option value="ALL">Tất cả thương hiệu</option>@foreach (var brand in Model.GroupBy(x => x.MaHang).OrderBy(x => x.First().TenHang)) { <option value="@brand.Key">@brand.First().TenHang</option> }</select></label><label>Tồn kho<select data-inventory-stock><option value="ALL">Tất cả trạng thái</option><option value="AVAILABLE">Còn hàng</option><option value="LOW">Cần nhập thêm (&lt; 5)</option><option value="OUT">Hết hàng</option></select></label><label>Sắp xếp<select data-inventory-sort><option value="name">Tên sản phẩm</option><option value="priceAsc">Giá tăng dần</option><option value="priceDesc">Giá giảm dần</option><option value="stockAsc">Tồn kho thấp trước</option></select></label><button type="button" class="btn-saas btn-saas-secondary" data-inventory-reset>Đặt lại</button><span data-inventory-count role="status">@Model.Count phiên bản</span></div>
    <div class="admin-table-scroll"><table class="admin-data-table inventory-table"><thead><tr><th>Sản phẩm / mã phiên bản</th><th>Thương hiệu</th><th>Cấu hình</th><th class="num">Giá bán</th><th>Tồn kho</th><th>Thao tác</th></tr></thead><tbody data-inventory-rows>
    @foreach (var phone in Model)
    {
        <tr data-inventory-row="@phone.MaSP"><td><div class="inventory-product"><img src="@phone.HinhAnh" alt="" loading="lazy" /><span><b>@phone.TenSP</b><small>@phone.MaSP</small></span></div></td><td data-label="Thương hiệu">@phone.TenHang</td><td data-label="Cấu hình">@phone.ThongSo.RAM · @phone.ThongSo.BoNhoTrong<small>@phone.ThongSo.Chip</small></td><td class="num" data-label="Giá bán"><b>@phone.GiaBan.ToString("N0", vi) ₫</b></td><td data-label="Tồn kho"><span class="inventory-stock @(phone.SoLuongTon == 0 ? "is-empty" : phone.SoLuongTon < 5 ? "is-low" : "")">@(phone.SoLuongTon == 0 ? "Hết hàng" : $"{phone.SoLuongTon} máy")</span></td><td><div class="inventory-actions"><button type="button" class="admin-row-link" data-inventory-preview="@phone.MaSP">Chi tiết</button><a asp-action="Edit" asp-route-id="@phone.MaSP" class="admin-row-link">Sửa</a><form asp-action="Delete" method="post" data-confirm="Xóa phiên bản @phone.TenSP?"><input type="hidden" name="id" value="@phone.MaSP" /><button type="submit" class="admin-row-link inventory-delete" aria-label="Xóa @phone.TenSP"><i class="fa-regular fa-trash-can" aria-hidden="true"></i></button></form></div></td></tr>
    }
    </tbody></table></div><p class="admin-empty-note" data-inventory-empty hidden>Không có phiên bản phù hợp. Hãy đổi từ khóa hoặc đặt lại bộ lọc.</p>
</section>
<dialog class="inventory-preview" id="inventory-preview" aria-labelledby="inventory-preview-title"><div class="inventory-preview-header"><div><small data-inventory-field="id"></small><h2 id="inventory-preview-title" data-inventory-field="name"></h2></div><button type="button" class="admin-icon-btn" data-dialog-close aria-label="Đóng chi tiết"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div><div class="inventory-preview-body"><div class="inventory-preview-image"><img data-inventory-image alt="" /><i class="fa-solid fa-mobile-screen" data-inventory-no-image aria-hidden="true" hidden></i></div><p class="inventory-preview-price" data-inventory-field="price"></p><p data-inventory-field="description"></p><dl class="inventory-preview-specs"><div><dt>Thương hiệu</dt><dd data-inventory-field="brand"></dd></div><div><dt>Tồn kho</dt><dd data-inventory-field="stock"></dd></div><div><dt>Màn hình</dt><dd data-inventory-field="screen"></dd></div><div><dt>Vi xử lý</dt><dd data-inventory-field="chip"></dd></div><div><dt>RAM</dt><dd data-inventory-field="ram"></dd></div><div><dt>Bộ nhớ</dt><dd data-inventory-field="storage"></dd></div><div><dt>Pin</dt><dd data-inventory-field="battery"></dd></div></dl></div><footer class="inventory-preview-footer"><a data-inventory-customer-link class="btn-saas btn-saas-secondary">Xem trang bán hàng</a><a data-inventory-edit-link class="btn-saas btn-saas-primary">Chỉnh sửa phiên bản</a></footer></dialog>
<script type="application/json" id="inventory-data">@Html.Raw(JsonSerializer.Serialize(Model.Select(p => new { id = p.MaSP, name = p.TenSP, brandCode = p.MaHang, brand = p.TenHang, price = p.GiaBan, stock = p.SoLuongTon, image = p.HinhAnh, description = p.MoTa, screen = p.ThongSo.ManHinh, chip = p.ThongSo.Chip, ram = p.ThongSo.RAM, storage = p.ThongSo.BoNhoTrong, battery = p.ThongSo.Pin, editUrl = Url.Action("Edit", new { id = p.MaSP }), customerUrl = Url.Action("Details", new { id = p.MaSP }) })))</script>
@section Scripts { <script src="~/js/admin-inventory.js" asp-append-version="true"></script> }
