@model QuanLyBanDienThoai.Models.SearchFilterViewModel
@{
    ViewData["Title"] = !string.IsNullOrWhiteSpace(Model.Keyword) ? "Kết quả tìm kiếm" : Model.Category == "IPHONE" ? "Điện thoại iPhone" : Model.Category == "ANDROID" ? "Điện thoại Android đề xuất" : "Tìm sản phẩm";
    Layout = ViewBag.IsAdmin == true ? "_Layout" : "_LayoutUser";
    
    // Dynamic XPath expression query preview
    string xpathQuery = "//DienThoai";
    List<string> xpathConditions = new List<string>();

    if (!string.IsNullOrEmpty(Model.Keyword))
    {
        xpathConditions.Add($"contains(translate(TenSP, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), '{Model.Keyword.ToLower()}')");
    }
    if (!string.IsNullOrEmpty(Model.MaHang) && Model.MaHang != "ALL")
    {
        xpathConditions.Add($"MaHang='{Model.MaHang}'");
    }
    if (Model.MaxGia.HasValue)
    {
        xpathConditions.Add($"GiaBan <= {Model.MaxGia.Value}");
    }
    if (Model.MinGia.HasValue)
    {
        xpathConditions.Add($"GiaBan >= {Model.MinGia.Value}");
    }

    string currentBrand = string.IsNullOrWhiteSpace(Model.MaHang) ? "ALL" : Model.MaHang.ToUpperInvariant();
    var catalogBrands = (ViewBag.AllItems as List<QuanLyBanDienThoai.Models.DienThoaiModel> ?? new List<QuanLyBanDienThoai.Models.DienThoaiModel>())
        .Where(phone => Model.Category == "ALL" || (Model.Category == "IPHONE"
            ? string.Equals(phone.MaHang, "APPLE", StringComparison.OrdinalIgnoreCase)
            : !string.Equals(phone.MaHang, "APPLE", StringComparison.OrdinalIgnoreCase)))
        .GroupBy(phone => phone.MaHang, StringComparer.OrdinalIgnoreCase)
        .Select(group => new { Id = group.Key, Name = group.First().TenHang })
        .OrderBy(brand => brand.Name)
        .ToList();

    if (xpathConditions.Count > 0)
    {
        xpathQuery += "[" + string.Join(" and ", xpathConditions) + "]";
    }


}

@if (ViewBag.IsAdmin == true) { <link rel="stylesheet" href="~/css/filter-dock.css" asp-append-version="true" /> }

@if (ViewBag.IsAdmin == true)
{
<!-- ACTIVE FILTER TAGS -->
@if (currentBrand != "ALL" || Model.MinGia.HasValue || Model.MaxGia.HasValue)
{
    <div class="fd-active">
        @if (currentBrand != "ALL")
        {
            <a class="fd-tag" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-minGia="@Model.MinGia" asp-route-maxGia="@Model.MaxGia" asp-route-category="@Model.Category" title="Bỏ lọc hãng">@currentBrand <i class="fa-solid fa-xmark"></i></a>
        }
        @if (Model.MinGia.HasValue || Model.MaxGia.HasValue)
        {
            <a class="fd-tag" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-maHang="@currentBrand" asp-route-category="@Model.Category" title="Bỏ lọc giá">
                @(Model.MinGia.HasValue ? (Model.MinGia.Value / 1000000).ToString("0") + "tr" : "0") – @(Model.MaxGia.HasValue ? (Model.MaxGia.Value / 1000000).ToString("0") + "tr" : "∞")
                <i class="fa-solid fa-xmark"></i>
            </a>
        }
    </div>
}

<partial name="_FilterDock" model="Model" />
}

@if (ViewBag.IsAdmin == true)
{
<div class="mb-3 d-flex align-items-center justify-content-between p-3 rounded-2" style="background: var(--bg-surface); border: 1px solid var(--border-default);">
    <div style="font-size: 13px; color: var(--text-body);">
        <i class="fa-solid fa-filter text-primary me-2"></i>
        <span>Bộ lọc kết quả: Tìm thấy <strong>@Model.Items.Count</strong> mẫu điện thoại phù hợp</span>
    </div>
    <a asp-action="Manage" class="btn-table-details">
        <i class="fa-solid fa-boxes-stacked"></i> Mở bảng quản lý kho
    </a>
</div>
}
@{
    var heading = !string.IsNullOrWhiteSpace(Model.Keyword) ? "Kết quả tìm kiếm" : Model.Category == "IPHONE" ? "iPhone" : Model.Category == "ANDROID" ? "Điện thoại Android" : "Điện thoại";
    var description = !string.IsNullOrWhiteSpace(Model.Keyword) ? $"Có {Model.Items.Count} kết quả cho “{Model.Keyword}”." : Model.Category == "IPHONE" ? "Chọn mẫu iPhone theo dung lượng, màu sắc và tình trạng." : Model.Category == "ANDROID" ? "Chọn điện thoại theo mẫu, dung lượng và mức giá." : "Các mẫu điện thoại đang có tại cửa hàng.";
}
<section class="catalog-page">
<header class="catalog-heading">
    <div class="catalog-heading__copy">
        <h1>@heading</h1>
        <p>@description</p>
    </div>
    <div class="catalog-heading__actions">
        <span class="catalog-heading__count">@Model.Items.Count mẫu máy</span>
        <details class="catalog-filter @(currentBrand != "ALL" || Model.MinGia.HasValue || Model.MaxGia.HasValue ? "has-active-filter" : "")">
            <summary aria-label="Lọc sản phẩm" title="Lọc sản phẩm"><i class="fa-solid fa-filter" aria-hidden="true"></i></summary>
            <form method="get" asp-action="Index" class="catalog-filter__panel">
                <input type="hidden" name="category" value="@Model.Category" />
                <input type="hidden" name="keyword" value="@Model.Keyword" />
                <strong>Lọc sản phẩm</strong>
                <label for="catalog-brand-filter">Hãng</label>
                <select id="catalog-brand-filter" name="maHang">
                    <option value="ALL">Tất cả hãng</option>
                    @foreach (var brand in catalogBrands)
                    {
                        <option value="@brand.Id" selected="@(currentBrand == brand.Id ? "selected" : null)">@brand.Name</option>
                    }
                </select>
                <div class="catalog-filter__prices">
                    <label>Giá từ<input type="number" name="minGia" min="0" step="500000" value="@(Model.MinGia?.ToString(System.Globalization.CultureInfo.InvariantCulture))" placeholder="0 ₫" /></label>
                    <label>Đến giá<input type="number" name="maxGia" min="0" step="500000" value="@(Model.MaxGia?.ToString(System.Globalization.CultureInfo.InvariantCulture))" placeholder="Không giới hạn" /></label>
                </div>
                <div class="catalog-filter__footer">
                    <a asp-action="Index" asp-route-category="@Model.Category" asp-route-keyword="@Model.Keyword">Xóa lọc</a>
                    <button type="submit">Áp dụng</button>
                </div>
            </form>
        </details>
    </div>
</header>

<!-- PRODUCT GRID CARDS -->
@if (Model.Items == null || Model.Items.Count == 0)
{
    <div class="catalog-empty glass">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <b>@(string.IsNullOrWhiteSpace(Model.Keyword) && Model.Category == "ALL" ? "Bạn đang tìm điện thoại nào?" : "Chưa tìm thấy sản phẩm phù hợp")</b>
        <span>@(string.IsNullOrWhiteSpace(Model.Keyword) && Model.Category == "ALL" ? "Nhập tên sản phẩm, dòng máy hoặc chip vào ô tìm kiếm phía trên." : "Thử một từ khóa khác để xem thêm sản phẩm.")</span>
    </div>
}
else
{
    <div class="product-grid">
        @foreach (var phone in Model.Items)
        {
            <a asp-action="Details" asp-route-id="@phone.MaSP" class="product-card product-card-link" aria-label="Xem chi tiết @phone.ModelSeries">
                <div class="product-media">
                    <img src="@phone.HinhAnh" alt="@phone.ModelSeries" onerror="this.onerror=null; this.parentNode.innerHTML='<svg viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'1.6\'><rect x=\'7\' y=\'2\' width=\'10\' height=\'20\' rx=\'2.4\'/></svg>'" />
                </div>
                <div class="product-card__meta">
                    <span class="product-brand">@phone.TenHang</span>
                    @if (phone.VariantCount > 1)
                    {
                        <span class="product-variant-count">@phone.VariantCount phiên bản</span>
                    }
                </div>
                <div class="product-name">@(string.IsNullOrWhiteSpace(phone.ModelSeries) ? phone.TenSP : phone.ModelSeries)</div>
                <div class="spec-row">
                    <span class="spec-tag">@phone.ThongSo.RAM</span>
                    <span class="spec-tag">@(string.IsNullOrWhiteSpace(phone.VariantSummary) ? phone.ThongSo.BoNhoTrong : phone.VariantSummary)</span>
                    <span class="spec-tag">@phone.ThongSo.Chip</span>
                </div>
                <div class="price-row">
                    <span class="price">@(phone.VariantCount > 1 ? "Từ " : "")@phone.GiaBan.ToString("#,##0")đ</span>
                    <span class="stock-tag @(phone.SoLuongTon > 0 ? "in-stock" : "out-of-stock")">@(phone.SoLuongTon > 0 ? $"Còn {phone.SoLuongTon} máy" : "Hết hàng")</span>
                </div>
                <span class="product-detail-cta">Xem sản phẩm <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
            </a>
        }
    </div>
}

</section>
