@model DienThoaiModel
@{ var editing = ViewData["ProductFormAction"]?.ToString() == "Edit"; }
<header class="overview-heading"><div><p class="overview-eyebrow">Sản phẩm &amp; tồn kho</p><h1>@(editing ? "Chỉnh sửa sản phẩm" : "Thêm sản phẩm")</h1><p>@(editing ? $"Cập nhật thông tin cho {Model.MaSP}." : "Nhập thông tin niêm yết và cấu hình của phiên bản điện thoại.")</p></div><a asp-action="Manage" class="btn-saas btn-saas-secondary"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Trở về kho</a></header>
@if (editing) { <div class="admin-notice admin-variant-notice"><i class="fa-solid fa-sliders" aria-hidden="true"></i><div><b>Thiết lập phiên bản bán hàng</b><p>Quản lý dòng máy, mới/cũ, màu sắc, dung lượng, bảo hành và các thông số mở rộng.</p></div><a asp-action="VariantSettings" asp-route-id="@Model.MaSP" class="btn-saas btn-saas-secondary">Mở thiết lập phiên bản</a></div> }
<form asp-action="@(editing ? "Edit" : "Create")" method="post" class="admin-product-form">
    @if (editing) { <p class="admin-muted admin-unit-product-link"><a asp-controller="StockUnits" asp-action="Index" asp-route-productId="@Model.MaSP" class="admin-row-link"><i class="fa-solid fa-barcode" aria-hidden="true"></i> Đăng ký / tra cứu IMEI của phiên bản này</a></p> }
    <div asp-validation-summary="All" class="admin-form-errors" role="alert"></div>
    @if (ViewBag.ErrorMessage != null) { <p class="admin-feedback admin-feedback--error" role="alert">@ViewBag.ErrorMessage</p> }
    @if (ViewBag.ValidationResult is ValidationResultModel validation && !validation.IsValid) { <ul class="admin-form-errors">@foreach (var error in validation.Errors) { <li>@error.Message</li> }</ul> }
    <section class="admin-card"><header class="overview-section-heading"><div><h2>Thông tin bán hàng</h2><p>Tên, giá bán và tồn kho của phiên bản này.</p></div></header><div class="admin-form-grid">
        <div class="admin-form-field"><label asp-for="MaSP">Mã sản phẩm</label><input asp-for="MaSP" class="form-input" readonly="@editing" pattern="[A-Z][A-Z0-9-]{2,63}" aria-describedby="product-code-help" /><small id="product-code-help">@(editing ? "Mã định danh được giữ nguyên khi cập nhật." : "Có thể để trống để hệ thống tự tạo mã. Ví dụ: IPHONE-15-PM-256.")</small><span asp-validation-for="MaSP"></span></div>
        <div class="admin-form-field"><label asp-for="TenSP">Tên sản phẩm <span aria-hidden="true">*</span></label><input asp-for="TenSP" class="form-input" required placeholder="iPhone 15 Pro Max 256GB" /><span asp-validation-for="TenSP"></span></div>
        <div class="admin-form-field"><label asp-for="MaHang">Hãng sản xuất <span aria-hidden="true">*</span></label><select asp-for="MaHang" class="form-select" required><option value="APPLE">Apple</option><option value="SAMSUNG">Samsung</option><option value="XIAOMI">Xiaomi</option><option value="OPPO">OPPO</option><option value="GOOGLE">Google</option><option value="GAMING">ASUS / Gaming</option><option value="KHAC">Hãng khác</option></select><span asp-validation-for="MaHang"></span></div>
        <div class="admin-form-field"><label asp-for="GiaBan">Giá bán (₫) <span aria-hidden="true">*</span></label><input asp-for="GiaBan" type="number" class="form-input" min="0" step="1" required /><span asp-validation-for="GiaBan"></span></div>
        <div class="admin-form-field"><label asp-for="SoLuongTon">Số lượng tồn kho <span aria-hidden="true">*</span></label><input asp-for="SoLuongTon" type="number" class="form-input" min="0" step="1" required /><small>Đặt bằng 0 nếu phiên bản đã hết hàng.</small><span asp-validation-for="SoLuongTon"></span></div>
    </div></section>
    <section class="admin-card"><header class="overview-section-heading"><div><h2>Thông số kỹ thuật</h2><p>Nội dung hiển thị trong chi tiết sản phẩm của khách hàng.</p></div></header><div class="admin-form-grid">
        <div class="admin-form-field"><label asp-for="ThongSo.ManHinh">Màn hình</label><input asp-for="ThongSo.ManHinh" class="form-input" placeholder="6.7 inch OLED, 120Hz" /><span asp-validation-for="ThongSo.ManHinh"></span></div>
        <div class="admin-form-field"><label asp-for="ThongSo.Chip">Vi xử lý</label><input asp-for="ThongSo.Chip" class="form-input" placeholder="Apple A17 Pro" /><span asp-validation-for="ThongSo.Chip"></span></div>
        <div class="admin-form-field"><label asp-for="ThongSo.RAM">RAM</label><input asp-for="ThongSo.RAM" class="form-input" placeholder="8GB" /><span asp-validation-for="ThongSo.RAM"></span></div>
        <div class="admin-form-field"><label asp-for="ThongSo.BoNhoTrong">Bộ nhớ trong</label><input asp-for="ThongSo.BoNhoTrong" class="form-input" placeholder="256GB" /><span asp-validation-for="ThongSo.BoNhoTrong"></span></div>
        <div class="admin-form-field"><label asp-for="ThongSo.Pin">Pin và sạc</label><input asp-for="ThongSo.Pin" class="form-input" placeholder="4422 mAh, USB-C" /><span asp-validation-for="ThongSo.Pin"></span></div>
    </div></section>
    <section class="admin-card"><header class="overview-section-heading"><div><h2>Hình ảnh &amp; mô tả</h2><p>Sử dụng hình ảnh rõ nét và thông tin đúng với sản phẩm.</p></div></header><div class="admin-form-grid">
        <div class="admin-form-field admin-form-field--full"><label asp-for="HinhAnh">Đường dẫn hình ảnh</label><input asp-for="HinhAnh" class="form-input" placeholder="/images/ten-san-pham.jpg hoặc https://…" /><span asp-validation-for="HinhAnh"></span></div>
        <div class="admin-form-field admin-form-field--full"><label asp-for="MoTa">Mô tả sản phẩm</label><textarea asp-for="MoTa" class="form-textarea" rows="6" placeholder="Thông tin nổi bật, tình trạng máy và phụ kiện đi kèm…"></textarea><span asp-validation-for="MoTa"></span></div>
    </div></section>
    <footer class="admin-form-actions"><a asp-action="Manage" class="btn-saas btn-saas-secondary">Hủy</a><button type="submit" class="btn-saas btn-saas-primary"><i class="fa-solid fa-check" aria-hidden="true"></i> @(editing ? "Lưu thay đổi" : "Thêm sản phẩm")</button></footer>
</form>
