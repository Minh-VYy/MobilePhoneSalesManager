@{ ViewData["Title"] = "Mua hàng & bảo hành"; Layout = "_LayoutUser"; }
<section class="customer-page"><header class="customer-heading"><h1>Mua hàng & bảo hành</h1><p>Kiểm tra thông tin trước khi chọn mua sản phẩm.</p></header>
    <div class="order-card glass"><h2>Phiên bản và tình trạng</h2><p>Màu sắc, dung lượng, tình trạng mới/đã sử dụng và thời hạn bảo hành được hiển thị cho từng phiên bản trên trang chi tiết sản phẩm. Những phiên bản hết hàng không thể chọn mua.</p>
    <h2>Đặt hàng và giao nhận</h2><p>Sau khi bạn đặt hàng, nhân viên kiểm tra tồn kho và liên hệ xác nhận thông tin nhận hàng, chi phí vận chuyển trước khi giao. Bạn thanh toán khi nhận hàng. Theo dõi tiến độ tại “Đơn hàng của tôi”; có thể tự hủy đơn đang chờ xác nhận.</p>
    <h2>Bảo hành và hỗ trợ sau mua</h2><p>Thời hạn bảo hành theo đúng phiên bản đã chọn và được ghi lại trong đơn hàng. Với yêu cầu bảo hành, đổi trả hoặc thay đổi đơn đã xác nhận, hãy gửi mã đơn qua chat để nhân viên kiểm tra và hướng dẫn theo tình trạng sản phẩm.</p>
    <a asp-controller="Support" asp-action="Index" class="btn btn-primary">Chat với nhân viên</a><a href="tel:0901176222" class="btn">Gọi 0901.176.222</a></div>
</section>
