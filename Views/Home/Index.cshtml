@{
    ViewData["Title"] = "Trang Chủ — PhoneStore 3D";
    Layout = "_LayoutUser";
}

<!-- Fixed Background Canvas & Vignette (Tech Background) -->
<canvas id="gl-tech"></canvas>
<div id="vignette-tech"></div>

<!-- ================= HERO FLAGSHIP SHOWCASE ================= -->
<section id="sec-hero" class="sec-chapter hero-3d-banner" data-rv="fade" style="position: relative; margin-top: 10px;">
    
    <!-- Floating Peek Detail Window -->
    <a href="#sec-exploded" class="peek-tech">
        <span class="peek-tech-fr">
            <img src="~/images/phone_exploded_chipset.png" alt="Xem Chi Tiết 3D" style="width: 100%; height: 100%; object-fit: cover;" />
            <span class="peek-tech-play">
                <svg viewBox="0 0 44 44" fill="none">
                    <circle cx="22" cy="22" r="20" fill="rgba(108,107,245,0.7)" stroke="#fff" stroke-width="1.5"/>
                    <polygon points="18,14 30,22 18,30" fill="#fff"/>
                </svg>
            </span>
        </span>
        <span class="peek-tech-cap">
            <b>BÓC TÁCH 3D</b>
            <i>Khám phá linh kiện →</i>
        </span>
    </a>

    <div class="hero-content">
        <div class="hero-tag" data-rv="up">
            <i class="fa-solid fa-sparkles"></i> ĐỘT PHÁ CÔNG NGHỆ FLAGSHIP 2026
        </div>
        
        <!-- Clip-Mask Word Reveal Heading -->
        <h1 class="hero-title word-reveal" data-rv="up">
            ĐỈNH CAO THIẾT KẾ & VI XỬ LÝ 3NM
        </h1>
        
        <p class="hero-desc" data-rv="up">
            Trải nghiệm dòng điện thoại Flagship thế hệ mới nhất với chất liệu Titan siêu bền nhẹ, cụm camera cảm biến 200MP và hiệu năng vi xử lý vượt trội. Hệ thống quản lý bán hàng & POS tích hợp dữ liệu XML hiện đại.
        </p>

        <!-- Interactive Color Swatches -->
        <div class="swatch-group" data-rv="up">
            <span class="swatch-label">Phiên bản màu:</span>
            <div class="swatch-list">
                <button type="button" class="swatch-btn active" data-color-name="Titan Tự Nhiên" data-img="/images/phone_hero_3d.png" style="background: #A0A5AD;" title="Titan Tự Nhiên"></button>
                <button type="button" class="swatch-btn" data-color-name="Titan Sa Mạc" data-img="/images/phone_color_variants.png" style="background: #C4A482;" title="Titan Sa Mạc"></button>
                <button type="button" class="swatch-btn" data-color-name="Đen Nhám Midnight" data-img="/images/phone_hero_3d.png" style="background: #1C1E24;" title="Đen Nhám Midnight"></button>
            </div>
        </div>

        <div style="display: flex; gap: 12px; flex-wrap: wrap;" data-rv="up">
            <a asp-controller="DienThoai" asp-action="Index" class="btn btn-primary">
                <span>Xem Tất Cả Sản Phẩm</span>
                <svg viewBox="0 0 16 16" aria-hidden="true" style="fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;"><path d="M3.2 8h9.1M8.6 4.3 12.4 8l-3.8 3.7" /></svg>
            </a>
            <a asp-controller="HoaDon" asp-action="Create" class="btn btn-ghost">
                <span><i class="fa-solid fa-cart-shopping"></i> Mua Hàng & POS</span>
            </a>
        </div>
    </div>

    <!-- 3D Stage Right -->
    <div class="hero-stage">
        <div class="floating-badge b-top-right">
            <div class="badge-icon">
                <i class="fa-solid fa-camera-retro"></i>
            </div>
            <div class="badge-text">
                <b>200 MP</b>
                <small>Triple Camera 3D</small>
            </div>
        </div>

        <div class="hero-phone-img-wrap">
            <img src="~/images/phone_hero_3d.png" id="hero-main-phone" alt="Flagship 3D Smartphone" class="hero-phone-img" />
        </div>

        <div class="floating-badge b-bottom-left">
            <div class="badge-icon" style="background: linear-gradient(135deg, #00C2A8, #2ECC71);">
                <i class="fa-solid fa-microchip"></i>
            </div>
            <div class="badge-text">
                <b>3 nm Chipset</b>
                <small>Bionic A18 / Snapdragon 8</small>
            </div>
        </div>
    </div>
</section>

<!-- ================= EXPLODED TECH & LIGHT GLOWS ================= -->
<section id="sec-exploded" class="sec-chapter feature-chapter" data-rv="fade" style="margin-top: 50px;">
    <div class="chapter-media" style="position: relative;">
        <!-- Pulsing Light Spot Hotspots -->
        <div class="glow-spot" style="top: 35%; left: 45%;"></div>
        <div class="glow-spot" style="top: 65%; left: 70%; animation-delay: -1.5s;"></div>

        <img src="~/images/phone_exploded_chipset.png" alt="Phân rã linh kiện 3D Chipset" />
    </div>

    <div class="chapter-info">
        <div class="hero-tag" style="background: rgba(0, 194, 168, 0.12); color: #00C2A8; border-color: rgba(0, 194, 168, 0.3);">
            <i class="fa-solid fa-layer-group"></i> KIẾN TRÚC VI XỬ LÝ & CẢM BIẾN
        </div>
        
        <h2 class="word-reveal" style="font-family: var(--font-head); font-size: 28px; font-weight: 800; margin: 0 0 14px;">
            BÓC TÁCH CHI TIẾT LINH KIỆN 3D
        </h2>
        
        <p style="color: var(--text-muted); font-size: 15px; line-height: 1.7; margin: 0 0 20px;">
            Hệ thống camera thấu kính 5 lớp kết hợp ống kính zoom quang học 5x, vi xử lý tiến trình 3nm tối ưu dung lượng pin và cụm tản nhiệt buồng hơi hiệu suất cao.
        </p>

        <div class="tech-grid-specs">
            <div class="spec-box">
                <div class="val">3 nm</div>
                <div class="lbl">Tiến trình Chipset</div>
            </div>
            <div class="spec-box">
                <div class="val">200 MP</div>
                <div class="lbl">Ống kính chính</div>
            </div>
            <div class="spec-box">
                <div class="val">5000 mAh</div>
                <div class="lbl">Dung lượng Pin</div>
            </div>
        </div>
    </div>
</section>

<!-- ================= HỆ SINH THÁI THIẾT BỊ ================= -->
<section id="sec-ecosystem" class="sec-chapter" data-rv="fade" style="margin-top: 50px; margin-bottom: 50px;">
    <div class="section-header-wrap">
        <div>
            <div class="hero-tag" style="background: rgba(240, 180, 41, 0.12); color: #F0B429; border-color: rgba(240, 180, 41, 0.3); margin-bottom: 10px;">
                <i class="fa-solid fa-cubes"></i> KẾT NỐI HỆ SINH THÁI THÔNG MINH
            </div>
            <h2 class="section-title word-reveal" style="font-size: 26px; margin: 0;">
                Hệ Sinh Thái Thiết Bị Điện Tử Thông Minh
            </h2>
        </div>
    </div>

    <div class="glass" style="padding: 28px; border-radius: var(--radius-lg); display: grid; grid-template-columns: 1fr 1.2fr; gap: 28px; align-items: center;">
        <div>
            <h3 style="font-family: var(--font-head); font-size: 21px; font-weight: 700; margin: 0 0 12px;">
                TƯƠNG THÍCH HOÀN HẢO MỌI THIẾT BỊ
            </h3>
            <p style="color: var(--text-muted); font-size: 14.5px; line-height: 1.65; margin-bottom: 22px;">
                Quản lý đồng bộ danh mục phụ kiện, tai nghe không dây, đồng hồ thông minh và bộ sạc nhanh. Dễ dàng tìm kiếm và bán hàng POS trọn bộ sản phẩm.
            </p>
            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                <span class="spec-tag" style="padding: 8px 14px; font-size: 12.5px;"><i class="fa-solid fa-headphones"></i> Tai nghe Noise-Canceling</span>
                <span class="spec-tag" style="padding: 8px 14px; font-size: 12.5px;"><i class="fa-solid fa-clock"></i> Smartwatch Ultra</span>
                <span class="spec-tag" style="padding: 8px 14px; font-size: 12.5px;"><i class="fa-solid fa-bolt"></i> Sạc nhanh 120W</span>
            </div>
        </div>
        <div style="border-radius: var(--radius-md); overflow: hidden; height: 250px; border: 1px solid var(--border-strong); position: relative;">
            <img src="~/images/gadgets_ecosystem.png" alt="Hệ sinh thái thiết bị thông minh" style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
    </div>
</section>

<!-- ================= SẢN PHẨM NỔI BẬT ================= -->
<section id="sec-catalog" class="sec-chapter" data-rv="fade" style="margin-top: 50px;">
    <div class="section-header-wrap">
        <div>
            <div class="hero-tag" style="margin-bottom: 10px;">
                <i class="fa-solid fa-mobile"></i> DANH MỤC SẢN PHẨM NỔI BẬT
            </div>
            <h2 class="section-title word-reveal" style="font-size: 26px; margin: 0;">
                Sản Phẩm Điện Thoại Bán Chạy
            </h2>
        </div>
        <a asp-controller="DienThoai" asp-action="Index" class="btn btn-ghost">
            Xem Tất Cả <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
    </div>

    <div class="product-grid">
        <!-- Product 1 -->
        <div class="product-card-3d">
            <span class="product-chip-badge">A17 Pro · 3nm</span>
            <div class="product-img-box">
                <img src="https://store.storeimages.cdn-apple.com/4982/as-images.apple.com/is/iphone-15-pro-finish-select-202309-6-7inch-naturaltitanium" alt="iPhone 15 Pro Max" />
            </div>
            <div class="product-brand">APPLE</div>
            <div class="product-name">iPhone 15 Pro Max 256GB - Titan Tự Nhiên</div>
            <div class="spec-row">
                <span class="spec-tag">Titan Tự Nhiên</span>
                <span class="spec-tag">Mới 100% VN/A</span>
            </div>
            <div class="price-row">
                <div class="price">29.490.000 ₫</div>
                <span class="stock-tag in-stock">Còn 25 máy</span>
            </div>
            <button class="btn btn-primary add-cart-btn-dynamic" onclick="showToast('Đã thêm iPhone 15 Pro Max vào giỏ hàng!')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 8H6"/></svg>
                Thêm Vào Giỏ
            </button>
        </div>

        <!-- Product 2 -->
        <div class="product-card-3d">
            <span class="product-chip-badge" style="background: rgba(0, 194, 168, 0.18); color: #00C2A8; border-color: rgba(0, 194, 168, 0.3);">Snapdragon 8 Gen 3</span>
            <div class="product-img-box">
                <img src="https://images.samsung.com/is/image/samsung/p6pim/vn/2401/gallery/vn-galaxy-s24-s928-sm-s928bztaxxv-thumb-539304991" alt="Galaxy S24 Ultra" />
            </div>
            <div class="product-brand">SAMSUNG</div>
            <div class="product-name">Samsung Galaxy S24 Ultra 5G</div>
            <div class="spec-row">
                <span class="spec-tag">Titan Xám</span>
                <span class="spec-tag">Galaxy AI</span>
            </div>
            <div class="price-row">
                <div class="price">26.990.000 ₫</div>
                <span class="stock-tag in-stock">Còn 18 máy</span>
            </div>
            <button class="btn btn-primary add-cart-btn-dynamic" onclick="showToast('Đã thêm Samsung Galaxy S24 Ultra vào giỏ hàng!')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 8H6"/></svg>
                Thêm Vào Giỏ
            </button>
        </div>

        <!-- Product 3 -->
        <div class="product-card-3d">
            <span class="product-chip-badge" style="background: rgba(240, 180, 41, 0.18); color: #F0B429; border-color: rgba(240, 180, 41, 0.3);">Leica 1-Inch</span>
            <div class="product-img-box">
                <img src="https://images.unsplash.com/photo-1598327105666-5b89351aff97?auto=format&amp;fit=crop&amp;w=600&amp;q=80" alt="Xiaomi 14 Ultra" />
            </div>
            <div class="product-brand">XIAOMI</div>
            <div class="product-name">Xiaomi 14 Ultra 512GB Leica</div>
            <div class="spec-row">
                <span class="spec-tag">Đen Giả Da</span>
                <span class="spec-tag">Sạc 90W</span>
            </div>
            <div class="price-row">
                <div class="price">27.990.000 ₫</div>
                <span class="stock-tag low-stock">Còn 8 máy</span>
            </div>
            <button class="btn btn-primary add-cart-btn-dynamic" onclick="showToast('Đã thêm Xiaomi 14 Ultra vào giỏ hàng!')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 8H6"/></svg>
                Thêm Vào Giỏ
            </button>
        </div>

        <!-- Product 4 -->
        <div class="product-card-3d">
            <span class="product-chip-badge" style="background: rgba(240, 89, 107, 0.18); color: #F0596B; border-color: rgba(240, 89, 107, 0.3);">Hasselblad Camera</span>
            <div class="product-img-box">
                <img src="https://images.unsplash.com/photo-1546054454-aa26e2b734c7?auto=format&amp;fit=crop&amp;w=600&amp;q=80" alt="OPPO Find X7 Ultra" />
            </div>
            <div class="product-brand">OPPO</div>
            <div class="product-name">OPPO Find X7 Ultra 256GB</div>
            <div class="spec-row">
                <span class="spec-tag">Nâu Da</span>
                <span class="spec-tag">Kính Tiềm Vọng Kép</span>
            </div>
            <div class="price-row">
                <div class="price">22.890.000 ₫</div>
                <span class="stock-tag in-stock">Còn 6 máy</span>
            </div>
            <button class="btn btn-primary add-cart-btn-dynamic" onclick="showToast('Đã thêm OPPO Find X7 Ultra vào giỏ hàng!')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 8H6"/></svg>
                Thêm Vào Giỏ
            </button>
        </div>
    </div>
</section>

<!-- ================= THỐNG KÊ TỔNG QUAN HỆ THỐNG ================= -->
<section id="sec-stats" class="sec-chapter" data-rv="fade" style="margin-top: 50px;">
    <div class="section-header-wrap">
        <div>
            <div class="hero-tag" style="background: rgba(62, 207, 142, 0.12); color: #3ECF8E; border-color: rgba(62, 207, 142, 0.3); margin-bottom: 10px;">
                <i class="fa-solid fa-chart-line"></i> BÁO CÁO & THỐNG KÊ CỬA HÀNG
            </div>
            <h2 class="section-title word-reveal" style="font-size: 26px; margin: 0;">
                Chỉ Số Hoạt Động Cửa Hàng
            </h2>
        </div>
    </div>

    <div class="stat-row">
        <div class="glass stat-card" style="--stat-accent: #6C6BF5;">
            <div class="stat-top">
                <div class="stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><rect x="7" y="2" width="10" height="20" rx="2.4"/><line x1="11" y1="18.3" x2="13" y2="18.3"/></svg>
                </div>
                <span class="stat-trend trend-up"><i class="fa-solid fa-arrow-up"></i> +29 Dòng Máy</span>
            </div>
            <div class="stat-value">29 Dòng Máy</div>
            <div class="stat-label">Sản phẩm trong cơ sở dữ liệu XML</div>
        </div>

        <div class="glass stat-card" style="--stat-accent: #00C2A8;">
            <div class="stat-top">
                <div class="stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 8H6"/></svg>
                </div>
                <span class="stat-trend trend-up"><i class="fa-solid fa-arrow-up"></i> Hôm nay</span>
            </div>
            <div class="stat-value">158 Hóa Đơn</div>
            <div class="stat-label">Giao dịch POS xử lý tự động</div>
        </div>

        <div class="glass stat-card" style="--stat-accent: #F0B429;">
            <div class="stat-top">
                <div class="stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                </div>
                <span class="stat-trend trend-up">Kiểm kê 100%</span>
            </div>
            <div class="stat-value">842 Máy</div>
            <div class="stat-label">Tổng tồn kho điện thoại an toàn</div>
        </div>

        <div class="glass stat-card" style="--stat-accent: #3ECF8E;">
            <div class="stat-top">
                <div class="stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <span class="stat-trend trend-up">+18.4%</span>
            </div>
            <div class="stat-value">1.48 tỷ ₫</div>
            <div class="stat-label">Doanh thu tổng hợp cửa hàng</div>
        </div>
    </div>
</section>
