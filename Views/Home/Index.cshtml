@model QuanLyBanDienThoai.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "PhoneStore — Flagship Điện Thoại Cao Cấp";
    Layout = "_LayoutHome";
}

@* ── PROGRESS RAIL ── *@
<nav class="rail" aria-label="Điều hướng trang">
    <button type="button" class="on" data-target="sec-hero"     title="Trang Chủ"><i></i></button>
    <button type="button"           data-target="sec-flash"    title="Flash Sale"><i></i></button>
    <button type="button"           data-target="sec-iphone"   title="iPhone / iPad"><i></i></button>
    <button type="button"           data-target="sec-android"  title="Android"><i></i></button>
    <button type="button"           data-target="sec-phukien"  title="Phụ Kiện"><i></i></button>
    <button type="button"           data-target="sec-news"     title="Tin Tức"><i></i></button>
</nav>

@* ── SEC 1 · HERO ── *@
<section id="sec-hero" class="ps-hero">

    @* Left copy *@
    <div class="ps-hero__copy" data-ad-copy-stack>
        @for (var i = 0; i < Model.QuangCao.Count; i++)
        {
            var ad = Model.QuangCao[i];
            <article class="ps-ad-copy @(i == 0 ? "is-active" : "")" data-ad-copy data-duration="@ad.ThoiGianChuyenGiay">
                <div class="ps-eyebrow">
                    <span class="ps-eyebrow__dot"></span>
                    Tin công nghệ &amp; sản phẩm nổi bật
                </div>
                <h1 class="ps-hero__h1">@ad.TieuDe</h1>
                <p class="ps-hero__sub">@ad.MoTa</p>
                <div class="ps-hero__actions">
                    <a href="#sec-flash" class="store-action">
                        <span>Khám phá ngay</span>
                        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
                    </a>
                </div>
            </article>
        }
    </div>
    <div class="ps-hero__stage">
        <div class="ps-phone-wrap">
            @if (Model.QuangCao.Count > 0)
            {
                <div class="ps-phone-carousel" data-carousel aria-label="Banner quảng cáo và tin công nghệ">
                    @for (var i = 0; i < Model.QuangCao.Count; i++)
                    {
                        var ad = Model.QuangCao[i];
                        <img src="@ad.HinhAnh" alt="@ad.TieuDe" class="ps-phone-img @(i == 0 ? "is-active" : "")" data-duration="@ad.ThoiGianChuyenGiay" loading="@(i == 0 ? "eager" : "lazy")" />
                    }
                    <div class="ps-carousel-controls" aria-label="Điều khiển banner">
                        <button type="button" class="ps-carousel-toggle" data-carousel-toggle aria-label="Tạm dừng trình chiếu" aria-pressed="false"><span aria-hidden="true">Ⅱ</span></button>
                        <div class="ps-carousel-dots" role="group" aria-label="Chọn banner">
                            @for (var i = 0; i < Model.QuangCao.Count; i++)
                            {
                                <button type="button" class="@(i == 0 ? "is-active" : "")" data-slide-to="@i" aria-label="Banner @(i + 1)" aria-pressed="@(i == 0 ? "true" : "false")"></button>
                            }
                        </div>
                    </div>
                </div>
            }
            <div class="ps-phone-glow"></div>
        </div>
    </div>

    @* Scroll cue *@
    <div class="ps-scroll-cue" aria-hidden="true">
        <span class="ps-scroll-cue__track"><i></i></span>
        <span class="ps-scroll-cue__label">Cuộn xuống</span>
    </div>
</section>

@* ── SEC 2 · PERKS & CAM KẾT CHÍNH HÃNG ── *@
<div class="ps-sec" style="padding-top: 10px; padding-bottom: 20px;">
    <div class="ps-perks-bar" data-rv="fade">
        <div class="ps-perk-item">
            <div class="ps-perk-icon"><i class="fa-solid fa-truck-fast"></i></div>
            <div class="ps-perk-text">
                <h4>Miễn Phí Vận Chuyển</h4>
                <p>Giao hàng tận nơi toàn quốc</p>
            </div>
        </div>
        <div class="ps-perk-item">
            <div class="ps-perk-icon"><i class="fa-solid fa-shield-halved"></i></div>
            <div class="ps-perk-text">
                <h4>Bảo Hành 12 Tháng</h4>
                <p>1 đổi 1 trong 30 ngày đầu</p>
            </div>
        </div>
        <div class="ps-perk-item">
            <div class="ps-perk-icon"><i class="fa-solid fa-credit-card"></i></div>
            <div class="ps-perk-text">
                <h4>Trả Góp 0% Lãi Suất</h4>
                <p>Duyệt hồ sơ nhanh 5 phút</p>
            </div>
        </div>
        <div class="ps-perk-item">
            <div class="ps-perk-icon"><i class="fa-solid fa-arrows-rotate"></i></div>
            <div class="ps-perk-text">
                <h4>Thu Cũ Đổi Mới</h4>
                <p>Trợ giá lên đến 3.000.000đ</p>
            </div>
        </div>
    </div>
</div>

@* ── SEC 3 · FLASH SALE TRONG NGÀY ── *@
<section id="sec-flash" class="ps-sec" data-rv="fade">
    <div class="flash-sale-head">
        <div class="flash-sale-title">
            <i class="fa-solid fa-bolt text-warning fs-4"></i>
            <span>FLASH SALE TRONG NGÀY</span>
            <span class="flash-sale-badge">GIẢM ĐẾN 25%</span>
        </div>
        <div class="flash-sale-timer">
            <span>Kết thúc trong:</span>
            <span class="timer-box" id="flashHours">05</span> :
            <span class="timer-box" id="flashMins">42</span> :
            <span class="timer-box" id="flashSecs">19</span>
        </div>
    </div>

    <div class="cat-products-grid" style="border-radius: 0 0 16px 16px; background: rgba(15, 23, 42, 0.4); padding: 16px; border: 1px solid rgba(255,255,255,0.1); border-top: none;">
        @foreach (var item in Model.FlashSale)
        {
            var origPrice = item.GiaBan * 1.15m;
            <a asp-controller="DienThoai" asp-action="Details" asp-route-id="@item.MaSP" class="cat-product-card">
                <span class="cat-sale-badge">Hot Sale</span>
                <div class="cat-img-wrap">
                    <img src="@item.HinhAnh" alt="@item.TenSP" onerror="this.onerror=null; this.src='/images/products/IPH-16PM-100-256-DES.png';" />
                </div>
                <div class="cat-title">@item.TenSP</div>
                <div class="cat-price-wrap">
                    <span class="cat-price-sale">@item.GiaBan.ToString("#,##0") đ</span>
                    <span class="cat-price-old">@origPrice.ToString("#,##0") đ</span>
                </div>
                <div class="cat-card-foot">
                    <span><i class="fa-solid fa-truck-fast me-1"></i> Còn @item.SoLuongTon máy &middot; Giao ngay</span>
                </div>
            </a>
        }
    </div>
</section>

@* ── SEC 4 · CATEGORY: IPHONE / IPAD ── *@
<section id="sec-iphone" class="ps-sec" data-rv="fade">
    <div class="cat-ribbon-bar">
        <div class="cat-ribbon-badge">IPHONE CHÍNH HÃNG VN/A</div>
        <a class="store-action store-action--catalog" asp-controller="DienThoai" asp-action="Index" asp-route-category="IPHONE">
            <span>Xem tất cả iPhone</span>
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
    </div>

    <div class="cat-products-grid">
        @foreach (var item in Model.ApplePhones)
        {
            var origPrice = item.GiaBan * 1.12m;
            <a asp-controller="DienThoai" asp-action="Details" asp-route-id="@item.MaSP" class="cat-product-card">
                <span class="cat-sale-badge">Apple VN/A</span>
                <div class="cat-img-wrap">
                    <img src="@item.HinhAnh" alt="@item.TenSP" onerror="this.onerror=null; this.src='/images/products/IPH-16PM-100-256-DES.png';" />
                </div>
                <div class="cat-title">@item.TenSP</div>
                <div class="cat-price-wrap">
                    <span class="cat-price-sale">@item.GiaBan.ToString("#,##0") đ</span>
                    <span class="cat-price-old">@origPrice.ToString("#,##0") đ</span>
                </div>
                <div class="cat-card-foot">
                    <span><i class="fa-solid fa-microchip me-1"></i> @item.ThongSo.Chip</span>
                </div>
            </a>
        }
    </div>
</section>

@* ── SEC 5 · CATEGORY: ANDROID FLAGSHIPS (SAMSUNG / XIAOMI / OPPO / GOOGLE) ── *@
<section id="sec-android" class="ps-sec" data-rv="fade">
    <div class="cat-ribbon-bar">
        <div class="cat-ribbon-badge">ANDROID FLAGSHIPS (SAMSUNG / XIAOMI / OPPO / GOOGLE)</div>
        <a class="store-action store-action--catalog" asp-controller="DienThoai" asp-action="Index" asp-route-category="ANDROID">
            <span>Xem tất cả Android</span>
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
    </div>

    <div class="cat-products-grid">
        @foreach (var item in Model.AndroidPhones)
        {
            var origPrice = item.GiaBan * 1.15m;
            <a asp-controller="DienThoai" asp-action="Details" asp-route-id="@item.MaSP" class="cat-product-card">
                <span class="cat-sale-badge">@item.TenHang</span>
                <div class="cat-img-wrap">
                    <img src="@item.HinhAnh" alt="@item.TenSP" onerror="this.onerror=null; this.src='/images/products/SS-S24U-100-256-GRY.png';" />
                </div>
                <div class="cat-title">@item.TenSP</div>
                <div class="cat-price-wrap">
                    <span class="cat-price-sale">@item.GiaBan.ToString("#,##0") đ</span>
                    <span class="cat-price-old">@origPrice.ToString("#,##0") đ</span>
                </div>
                <div class="cat-card-foot">
                    <span><i class="fa-solid fa-microchip me-1"></i> @item.ThongSo.Chip</span>
                </div>
            </a>
        }
    </div>
</section>

@* ── SEC 6 · CATEGORY: PHỤ KIỆN CHÍNH HÃNG ── *@
<section id="sec-phukien" class="ps-sec" data-rv="fade">
    <div class="cat-ribbon-bar">
        <div class="cat-ribbon-badge">PHỤ KIỆN CHÍNH HÃNG</div>
    </div>

    <div class="cat-products-grid">
        @foreach (var item in Model.Phukien)
        {
            var origPrice = item.GiaBan * 1.25m;
            <a asp-controller="DienThoai" asp-action="Details" asp-route-id="@item.MaSP" class="cat-product-card">
                <span class="cat-sale-badge">Phụ Kiện Zin</span>
                <div class="cat-img-wrap">
                    <img src="@item.HinhAnh" alt="@item.TenSP" onerror="this.onerror=null; this.src='/images/gadgets_ecosystem.png';" />
                </div>
                <div class="cat-title">@item.TenSP</div>
                <div class="cat-price-wrap">
                    <span class="cat-price-sale">@item.GiaBan.ToString("#,##0") đ</span>
                    <span class="cat-price-old">@origPrice.ToString("#,##0") đ</span>
                </div>
                <div class="cat-card-foot">
                    <span><i class="fa-solid fa-shield-halved me-1"></i> Bảo hành 12 tháng</span>
                </div>
            </a>
        }
        <!-- Fallback accessory items for rich display -->
        <a asp-controller="DienThoai" asp-action="Index" class="cat-product-card">
            <span class="cat-sale-badge">Sale 30%</span>
            <div class="cat-img-wrap">
                <img src="~/images/phone_color_variants.png" alt="Ốp lưng MagSafe" />
            </div>
            <div class="cat-title">Ốp Lưng MagSafe Silicon Trong Suốt Kháng Ố Vàng</div>
            <div class="cat-price-wrap">
                <span class="cat-price-sale">350.000 đ</span>
                <span class="cat-price-old">500.000 đ</span>
            </div>
            <div class="cat-card-foot">
                <span><i class="fa-solid fa-truck-fast me-1"></i> Miễn phí giao hàng</span>
            </div>
        </a>
        <a asp-controller="DienThoai" asp-action="Index" class="cat-product-card">
            <span class="cat-sale-badge">Sale 40%</span>
            <div class="cat-img-wrap">
                <img src="~/images/phone_exploded_chipset.png" alt="Kính Cường Lực 9D" />
            </div>
            <div class="cat-title">Kính Cường Lực 9D Sapphire Chống Va Đập &amp; Chống Nhìn Trộm</div>
            <div class="cat-price-wrap">
                <span class="cat-price-sale">120.000 đ</span>
                <span class="cat-price-old">200.000 đ</span>
            </div>
            <div class="cat-card-foot">
                <span><i class="fa-solid fa-shield-halved me-1"></i> Độ cứng 9H siêu bền</span>
            </div>
        </a>
    </div>
</section>

@* ── SEC 7 · TIN TỨC & BÀI VIẾT CÔNG NGHỆ NỔI BẬT THỜI GIAN THỰC ── *@
<section id="sec-news" class="ps-sec sec-tech-news" data-rv="fade">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="ps-sec__rule mb-0" style="flex: 1;">
            <span class="ps-sec__k"><i class="fa-solid fa-newspaper text-primary me-2"></i> TIN TỨC &amp; ĐÁNH GIÁ CÔNG NGHỆ THỜI GIAN THỰC</span>
            <span class="ps-rule"></span>
        </div>
        <a asp-controller="TinTuc" asp-action="Index" class="store-action" style="margin-left: 16px;">
            <span>Xem chuyên trang tin tức</span>
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
    </div>

    <div class="news-grid">
        @foreach (var article in Model.TinTuc)
        {
            <a asp-controller="TinTuc" asp-action="Details" asp-route-id="@article.MaTT" class="news-card">
                <img src="@article.HinhAnh" alt="@article.TieuDe" class="news-img" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1598327105666-5b89351aff97?auto=format&fit=crop&w=600&q=80';" />
                <div class="news-body">
                    <div class="news-meta">
                        <span><i class="fa-regular fa-clock me-1"></i> @article.NgayDang.ToString("dd/MM/yyyy HH:mm")</span>
                        <span class="badge bg-primary bg-opacity-75" style="font-size: 11px;">@article.DanhMuc</span>
                    </div>
                    <h3 class="news-title">@article.TieuDe</h3>
                    <p class="news-desc">@article.TomTat</p>
                    <div class="news-link">Đọc chi tiết <i class="fa-solid fa-arrow-right"></i></div>
                </div>
            </a>
        }
    </div>
</section>

@* ── FOOTER ── *@
@await Html.PartialAsync("_Footer")
