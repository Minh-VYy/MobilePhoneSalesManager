@model List<BuyerOrder>
@{ var admin = User.IsInRole("Admin"); ViewData["Title"] = admin ? "Đơn đặt hàng trực tuyến" : "Đơn hàng của tôi"; Layout = admin ? "_Layout" : "_LayoutUser"; }
@if (admin) { <partial name="_AdminOrders" model="Model" /> }
else
{
<section class="customer-page">
    <header class="customer-heading"><h1>@ViewData["Title"]</h1><p>@(admin ? "Xác nhận tồn kho và cập nhật quá trình giao hàng." : "Theo dõi các đơn mua từ tài khoản của bạn.")</p></header>
    @if (!admin) { <partial name="_BuyerNav" /> }
    @if (Model.Count == 0) { <div class="account-card glass"><h2>Chưa có đơn hàng</h2><p>Các đơn đặt mua sẽ xuất hiện tại đây.</p><a asp-controller="Home" asp-action="Index" class="store-action btn">Về cửa hàng</a></div> }
    <div class="orders-list">
    @foreach (var order in Model)
    {
        <article class="order-card glass">
            <div class="order-card__head"><a asp-action="Details" asp-route-id="@order.Id"><b>@order.Id</b></a><span class="order-status" data-status="@order.Status">@order.StatusLabel</span></div>
            <p>@order.CreatedAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm") · @order.Items.Sum(x => x.Quantity) sản phẩm @if (admin) { <text>· @order.CustomerName</text> }</p>
            <div class="order-card__bottom"><strong>@order.Total.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ₫</strong><a asp-action="Details" asp-route-id="@order.Id">Xem chi tiết <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div>
        </article>
    }
    </div>
</section>
}
