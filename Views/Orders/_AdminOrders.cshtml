@model List<BuyerOrder>
@using System.Globalization
@{ var vi = CultureInfo.GetCultureInfo("vi-VN"); }
<header class="overview-heading"><div><p class="overview-eyebrow">Bán hàng trực tuyến</p><h1>Đơn hàng khách mua</h1><p>Kiểm tra thông tin nhận hàng và cập nhật tiến độ xử lý.</p></div><a asp-controller="Support" asp-action="Index" class="btn-saas btn-saas-secondary"><i class="fa-regular fa-comments" aria-hidden="true"></i> Mở hỗ trợ khách hàng</a></header>
<section class="overview-metrics" aria-label="Tình trạng đơn trực tuyến">
    <article class="overview-metric"><span>Chờ xác nhận</span><strong>@Model.Count(x => x.Status == "Pending")</strong><p>Cần kiểm tra hàng và liên hệ khách</p><i class="fa-regular fa-clock" aria-hidden="true"></i></article>
    <article class="overview-metric"><span>Đã xác nhận / đang giao</span><strong>@Model.Count(x => x.Status is "Confirmed" or "Shipping")</strong><p>Đơn đã được phân bổ tồn kho</p><i class="fa-solid fa-truck-fast" aria-hidden="true"></i></article>
    <article class="overview-metric"><span>Đã giao thành công</span><strong>@Model.Count(x => x.Status == "Delivered")</strong><p>Đơn có trạng thái đã giao</p><i class="fa-solid fa-circle-check" aria-hidden="true"></i></article>
    <article class="overview-metric"><span>Giá trị đơn đã giao</span><strong>@Model.Where(x => x.Status == "Delivered").Sum(x => x.Total).ToString("N0", vi) ₫</strong><p>Tiền sản phẩm, chưa gồm phí giao hàng</p><i class="fa-solid fa-coins" aria-hidden="true"></i></article>
</section>
<section class="admin-card" data-admin-list><header class="overview-section-heading"><div><h2>Danh sách đơn hàng</h2><p>Tìm theo mã đơn, họ tên hoặc số điện thoại.</p></div></header><div class="admin-list-controls"><label>Tìm đơn hàng<input type="search" data-admin-keyword placeholder="Mã đơn, khách hàng, số điện thoại…" /></label><label>Trạng thái<select data-admin-status><option value="">Tất cả trạng thái</option>@foreach (var status in new[] { "Pending", "Confirmed", "Shipping", "Delivered", "Cancelled" }) { <option value="@status">@BuyerOrder.StatusName(status)</option> }</select></label><span data-admin-list-count role="status">@Model.Count đơn</span></div><div class="admin-table-scroll"><table class="admin-data-table"><thead><tr><th>Mã đơn / thời gian</th><th>Khách hàng</th><th class="num">Số máy</th><th class="num">Tiền sản phẩm</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var order in Model) { <tr data-admin-row data-status="@order.Status" data-search="@order.Id @order.CustomerName @order.Phone"><td><b>@order.Id</b><small>@order.CreatedAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</small></td><td>@order.CustomerName<small>@order.Phone</small></td><td class="num">@order.Items.Sum(x => x.Quantity)</td><td class="num">@order.Total.ToString("N0", vi) ₫</td><td><span class="order-status" data-status="@order.Status">@order.StatusLabel</span></td><td><a asp-action="Details" asp-route-id="@order.Id" class="admin-row-link">Chi tiết / xử lý</a></td></tr> }</tbody></table></div><p class="admin-empty-note" data-admin-empty hidden>Chưa có đơn hàng phù hợp với điều kiện hiển thị.</p><partial name="_AdminPagination" /></section>
