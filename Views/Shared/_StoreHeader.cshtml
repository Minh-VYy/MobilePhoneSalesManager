    <header class="atd-modern-wrapper" id="site-header">
        <div class="atd-modern__aurora" aria-hidden="true"></div>
        <nav class="atd-modern__bar" aria-label="Primary Navigation">
            <!-- Brand Left -->
            <a asp-controller="Home" asp-action="Index" class="atd-modern__brand" title="Trang chủ">
                <img src="~/images/logo.png" alt="Logo" class="site-logo-img" />
            </a>

            <!-- Dock Items Center (Capsule Proximity Dock - Desktop & Tablet) -->
            <!-- Dock Center (Search & Actions) -->
            <div class="atd-modern__dock ps-nav-new" aria-label="Primary">
                <!-- Danh mục / Bộ lọc (mở mega menu kính) -->
                

                <!-- Khu vực -->
                <button type="button" class="ps-nav-item fd-trigger" id="fd-trigger" aria-haspopup="true" aria-expanded="false" aria-controls="fd-mega">
                    <div class="ps-nav-icon"><i class="fa-solid fa-table-cells-large"></i></div>
                    <div class="ps-nav-tx"><span>Danh mục</span><b>Bộ lọc <i class="fa-solid fa-caret-down"></i></b></div>
                </button>                <div class="ps-nav-loc">
                    <span>Khu vực</span>
                    <b>Đà Nẵng <i class="fa-solid fa-caret-down"></i></b>
                </div>

                <!-- Search -->
                <form class="ps-nav-search" method="get" asp-controller="DienThoai" asp-action="Index" role="search">
                    <input type="hidden" name="category" value="ALL" />
                    <input type="search" name="keyword" placeholder="Tìm điện thoại..." aria-label="Tìm sản phẩm" />
                    <button type="submit" aria-label="Tìm kiếm"><i class="fa-solid fa-magnifying-glass"></i></button>
                </form>

                <!-- Hotline -->
                <a href="tel:0901176222" class="ps-nav-item">
                    <div class="ps-nav-icon"><i class="fa-solid fa-phone-volume"></i></div>
                    <div class="ps-nav-tx"><span>Hotline</span><b>0901.176.222</b></div>
                </a>

                <!-- Bảo hành -->
                <a asp-controller="Home" asp-action="Policies" class="ps-nav-item">
                    <div class="ps-nav-icon"><i class="fa-solid fa-shield-halved"></i></div>
                    <div class="ps-nav-tx"><span>Chính sách</span><b>bảo hành</b></div>
                </a>

                <!-- Tin tức công nghệ -->
                <a asp-controller="TinTuc" asp-action="Index" class="ps-nav-item">
                    <div class="ps-nav-icon"><i class="fa-solid fa-newspaper"></i></div>
                    <div class="ps-nav-tx"><span>Tin tức</span><b>Công nghệ</b></div>
                </a>

                <!-- Kiểm tra đơn hàng -->
                <a asp-controller="Orders" asp-action="Index" class="ps-nav-item ps-nav-item--box">
                    <div class="ps-nav-icon"><i class="fa-solid fa-box-open"></i></div>
                    <div class="ps-nav-tx"><span>Kiểm Tra</span><b>Đơn Hàng</b></div>
                </a>
                
                <!-- Giỏ hàng -->
                <a asp-controller="DienThoai" asp-action="Cart" class="ps-nav-item" aria-label="Mở giỏ hàng">
                    <div class="ps-nav-icon ps-nav-cart">
                        <i class="fa-solid fa-cart-shopping"></i>
                        <span class="ps-cart-badge" data-cart-badge hidden>0</span>
                    </div>
                    <div class="ps-nav-tx"><span>Giỏ</span><b>Hàng</b></div>
                </a>
            </div>

            <!-- Actions Right (Theme Toggle, Auth Capsule & Mobile Toggle) -->
            <div class="atd-modern__actions">
                <!-- Theme Toggle -->
                <button class="icon-btn" id="theme-toggle" aria-label="Đổi giao diện sáng/tối" title="Đổi giao diện sáng/tối" style="width: 34px; height: 34px; border-radius: 50%;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 15px; height: 15px;"><circle cx="12" cy="12" r="4.5"/><path d="M12 2.5v2.5M12 19v2.5M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2.5 12H5M19 12h2.5M4.2 19.8L6 18M18 6l1.8-1.8"/></svg>
                </button>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Account" asp-action="Profile" class="atd-modern__ghost desktop-only" title="Thông tin tài khoản">@User.Identity?.Name</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="nav-logout desktop-only"><button type="submit" class="store-action store-action--compact">
                        <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i><span>Đăng xuất</span>
                    </button></form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="store-action store-action--compact desktop-only">
                        <i class="fa-regular fa-user" aria-hidden="true"></i><span>Đăng nhập</span>
                    </a>
                }

                <!-- Mobile Menu Hamburger Toggle Button -->
                <button class="atd-mobile-toggle" id="mobile-menu-toggle" aria-label="Mở menu điều hướng" aria-expanded="false" aria-controls="mobile-drawer-menu">
                    <i class="fa-solid fa-bars icon-open"></i>
                    <i class="fa-solid fa-xmark icon-close" style="display: none;"></i>
                </button>
            </div>
        </nav>

        <!-- Mobile Drawer Glass Menu Card (Aperture Dock Style) -->
        <div class="atd-mobile-drawer" id="mobile-drawer-menu" aria-hidden="true" inert>
            <div class="atd-mobile-drawer__content">
                <div class="atd-drawer-header">
                    <div class="atd-drawer-brand">
                        <img src="~/images/logo.png" alt="Logo" class="site-logo-img" />
                    </div>
                </div>
                <form class="atd-mobile-search" method="get" asp-controller="DienThoai" asp-action="Index" role="search">
                    <input type="hidden" name="category" value="ALL" />
                    <input type="search" name="keyword" placeholder="Tìm điện thoại..." aria-label="Tìm sản phẩm" />
                    <button type="submit" aria-label="Tìm kiếm"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                </form>
                <a asp-controller="Home" asp-action="Index" class="atd-mobile-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    <i class="fa-solid fa-house"></i> Trang Chủ
                </a>
                <a asp-controller="DienThoai" asp-action="Index" class="atd-mobile-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "DienThoai" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="fa-solid fa-mobile-screen"></i> Sản Phẩm Điện Thoại
                </a>
                <a asp-controller="DienThoai" asp-action="Cart" class="atd-mobile-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Cart" ? "active" : "")">
                    <i class="fa-solid fa-cart-shopping"></i> Giỏ hàng
                </a>
                <a asp-controller="Orders" asp-action="Index" class="atd-mobile-item @(ViewContext.RouteData.Values["action"]?.ToString() == "XsltView" ? "active" : "")">
                    <i class="fa-solid fa-receipt"></i> Tra Cứu Đơn Hàng
                </a>
                <a href="tel:0901176222" class="atd-mobile-item">
                    <i class="fa-solid fa-phone-volume"></i> Hotline 0901.176.222
                </a>
                <div class="atd-mobile-drawer__divider"></div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Account" asp-action="Profile" class="atd-mobile-item">
                        <i class="fa-solid fa-user"></i> @User.Identity?.Name
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="nav-logout"><button type="submit" class="store-action store-action--drawer">
                        <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> Đăng xuất
                    </button></form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="store-action store-action--drawer">
                        <span>Đăng nhập</span> <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </a>
                }
            </div>
        </div>

        <div class="fd-mega" id="fd-mega" aria-hidden="true">
            <partial name="_FilterDock" model="new QuanLyBanDienThoai.Models.SearchFilterViewModel()" />
        </div>
    </header>
