<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="PhoneStore — Cửa hàng điện thoại flagship cao cấp. iPhone, Samsung, Xiaomi. Hệ thống bán lẻ và bảo hành chính hãng." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/commerce.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/filter-dock.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storefront-buttons.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        /* ── Home-page layout override ── */
        html, body { overflow-x: hidden; }
        /* The body already has the dark radial background from site.css.
           We just need to make sure the page wrapper does NOT add any
           extra padding/max-width on the home page. */
        body { padding: 0; margin: 0; }
    </style>
</head>
<body class="storefront-body">
    <!-- ===================================================
         FIXED CANVAS + VIGNETTE (rendered here so they are
         truly fixed to the viewport, not inside <main>)
         =================================================== -->
    <canvas id="gl-tech" aria-hidden="true"></canvas>
    <div id="vignette-tech" aria-hidden="true"></div>

    <!-- ===================================================
         ANIMATED TOP DOCK — same as _LayoutUser but
         we need it here too for the full-page layout
         =================================================== -->
    <partial name="_StoreHeader" />

    <!-- ===================================================
         PAGE BODY — full-bleed, no padding wrapper
         =================================================== -->
    @RenderBody()

    <!-- Toast -->
    <partial name="_SupportWidget" />
    <script src="~/js/account.js" asp-append-version="true"></script>
    <script src="~/js/support-chat.js" asp-append-version="true"></script>
    <script src="~/js/filter-dock.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/product-cart.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
