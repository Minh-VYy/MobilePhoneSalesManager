<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] - PhoneStore XML</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
</head>
<body>
    <div class="app">
        <!-- ================= SIDEBAR ================= -->
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-mark">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="7" y="2" width="10" height="20" rx="2.4"/>
                        <line x1="11" y1="18.3" x2="13" y2="18.3"/>
                    </svg>
                </div>
                <div>
                    <div class="brand-text">PhoneStore</div>
                    <div class="brand-sub">XML · XSD · XSLT · XPath</div>
                </div>
            </div>

            <div class="nav-group-label">TỔNG QUAN</div>
            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "ThongKe" ? "active" : "")" 
               asp-controller="ThongKe" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 13a9 9 0 0 1 18 0"/><path d="M12 13l4-4"/><circle cx="12" cy="13" r=".6" fill="currentColor"/>
                </svg>
                Bảng điều khiển
            </a>

            <div class="nav-group-label">BÁN HÀNG</div>
            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "DienThoai" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
               asp-controller="DienThoai" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>
                </svg>
                Danh mục sản phẩm
            </a>
            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "HoaDon" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")" 
               asp-controller="HoaDon" asp-action="Create">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 8H6"/>
                </svg>
                Bán hàng (POS)
            </a>
            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "HoaDon" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
               asp-controller="HoaDon" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 3h9l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M9 8h6M9 12h6M9 16h3"/>
                </svg>
                Hóa đơn XML
            </a>

            <div class="nav-group-label">QUẢN TRỊ</div>
            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "DienThoai" && ViewContext.RouteData.Values["action"]?.ToString() == "Manage" ? "active" : "")" 
               asp-controller="DienThoai" asp-action="Manage">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="7" width="18" height="14" rx="1.5"/><path d="M3 7l2-4h14l2 4"/><path d="M10 11h4"/>
                </svg>
                Quản lý kho XML
                <span class="nav-badge">CRUD</span>
            </a>
            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "DienThoai" && ViewContext.RouteData.Values["action"]?.ToString() == "XsltView" ? "active" : "")" 
               asp-controller="DienThoai" asp-action="XsltView">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline>
                </svg>
                XSLT Transform View
            </a>

            <div class="sidebar-foot">
                <div class="foot-hint">DienThoai.xsd ✓<br>HoaDon.xsd ✓<br>.NET 9 · MVC</div>
            </div>
        </aside>

        <!-- ================= MAIN ================= -->
        <div class="main">
            <div class="topbar">
                <h1 class="page-heading">
                    @ViewData["Title"]
                    <span>Hệ thống Quản lý Bán Điện thoại Di động XML</span>
                </h1>

                <!-- Quick Role Switcher Button to Storefront -->
                <a asp-controller="Account" asp-action="SwitchRole" asp-route-role="User" class="btn btn-sm" style="background: rgba(108,107,245,0.15); border-color: rgba(108,107,245,0.35); color: var(--primary-2); font-weight: 700;" title="Quay lại giao diện Khách hàng (User View)">
                    <i class="fa-solid fa-store"></i> Sang User View (Storefront)
                </a>

                <div class="search-box">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>
                    </svg>
                    <input type="text" id="global-search-input" placeholder="Tìm mã SP, tên máy..." />
                </div>

                <button class="icon-btn" id="theme-toggle" aria-label="Đổi giao diện sáng/tối" title="Đổi giao diện sáng/tối">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="4.5"/><path d="M12 2.5v2.5M12 19v2.5M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2.5 12H5M19 12h2.5M4.2 19.8L6 18M18 6l1.8-1.8"/>
                    </svg>
                </button>

                <div class="profile-pill">
                    <div class="avatar">AD</div>
                    <div class="who"><b>Admin</b><small>Quản trị viên</small></div>
                </div>
            </div>

            <main role="main" class="view">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="validate-line v-ok mb-4" style="border-radius: 12px;">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.3 2.3 4.7-5.6"/></svg>
                        <div><b>Thành công!</b><span>@TempData["SuccessMessage"]</span></div>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="validate-line v-err mb-4" style="border-radius: 12px;">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.8L2.8 17a1.6 1.6 0 0 0 1.4 2.4h15.6a1.6 1.6 0 0 0 1.4-2.4L13.7 3.8a1.6 1.6 0 0 0-2.8 0z"/></svg>
                        <div><b>Lỗi hệ thống:</b><span>@TempData["ErrorMessage"]</span></div>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
