<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] — PhoneStore XML Enterprise</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fira+Code:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
</head>
<body>
    <div class="admin-shell">
        <!-- ================= SIDEBAR (MATCHING SCREENSHOT 3) ================= -->
        <aside class="admin-sidebar" id="adminSidebar">
            <a asp-controller="ThongKe" asp-action="Index" class="admin-sidebar-header">
                <div class="admin-brand-icon">
                    <i class="fa-solid fa-bolt"></i>
                </div>
                <div class="admin-brand-title">PhoneStore Admin</div>
            </a>

            <nav class="admin-sidebar-nav">
                <!-- Main Items -->
                <a class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "ThongKe" ? "active" : "")"
                   asp-controller="ThongKe" asp-action="Index">
                    <i class="fa-solid fa-gauge-high"></i>
                    <span>Dashboard</span>
                </a>

                <div class="admin-nav-category">QUẢN LÝ KHO DỮ LIỆU</div>

                <a class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "DienThoai" && ViewContext.RouteData.Values["action"]?.ToString() == "Manage" ? "active" : "")"
                   asp-controller="DienThoai" asp-action="Manage">
                    <i class="fa-solid fa-table-columns"></i>
                    <span>Kho XML (Kanban)</span>
                </a>

                <div class="admin-nav-sublist">
                    <a class="admin-nav-sublink @(ViewContext.RouteData.Values["controller"]?.ToString() == "DienThoai" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")"
                       asp-controller="DienThoai" asp-action="Create">
                        <span>+ Thêm sản phẩm</span>
                    </a>
                    <a class="admin-nav-sublink @(ViewContext.RouteData.Values["controller"]?.ToString() == "DienThoai" && ViewContext.RouteData.Values["action"]?.ToString() == "ValidateXsd" ? "active" : "")"
                       asp-controller="DienThoai" asp-action="ValidateXsd">
                        <span>Kiểm tra XSD Schema</span>
                    </a>
                    <a class="admin-nav-sublink @(ViewContext.RouteData.Values["controller"]?.ToString() == "DienThoai" && ViewContext.RouteData.Values["action"]?.ToString() == "XsltView" ? "active" : "")"
                       asp-controller="DienThoai" asp-action="XsltView">
                        <span>XSLT Catalogue</span>
                    </a>
                </div>

                <div class="admin-nav-category">GIAO DỊCH & HÓA ĐƠN</div>

                <a class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "HoaDon" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")"
                   asp-controller="HoaDon" asp-action="Create">
                    <i class="fa-solid fa-cash-register"></i>
                    <span>Bán hàng (POS XML)</span>
                </a>

                <a class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "HoaDon" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                   asp-controller="HoaDon" asp-action="Index">
                    <i class="fa-solid fa-receipt"></i>
                    <span>Danh sách hóa đơn</span>
                </a>

                <div class="admin-nav-category">NỘI DUNG & DỊCH VỤ</div>

                <a class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "QuangCao" ? "active" : "")"
                   asp-controller="QuangCao" asp-action="Index">
                    <i class="fa-solid fa-images"></i>
                    <span>Banner quảng cáo</span>
                </a>

                <a class="admin-nav-item" asp-controller="DienThoai" asp-action="RssFeed" target="_blank">
                    <i class="fa-solid fa-rss"></i>
                    <span>RSS 2.0 XML Feed</span>
                </a>

                <a class="admin-nav-item" asp-controller="DienThoai" asp-action="XmlApi" target="_blank">
                    <i class="fa-solid fa-network-wired"></i>
                    <span>Web Service API</span>
                </a>
            </nav>

            <!-- Sidebar User Profile (Matching Screenshot 3) -->
            <div class="admin-sidebar-footer">
                <div class="admin-user-cell">
                    <div class="admin-avatar">
                        AD
                        <span class="admin-avatar-dot"></span>
                    </div>
                    <div class="admin-user-meta">
                        <div class="admin-user-name">Quản Trị Viên</div>
                        <div class="admin-user-role">Administrator</div>
                    </div>
                </div>
                <a asp-controller="Account" asp-action="Logout" class="admin-icon-btn" title="Đăng xuất" style="width: 30px; height: 30px;">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </a>
            </div>
        </aside>

        <!-- ================= MAIN CONTENT ================= -->
        <div class="admin-main">
            <!-- Topbar (Matching Screenshot 3) -->
            <header class="admin-topbar">
                <div class="admin-topbar-left">
                    <button type="button" class="admin-icon-btn d-lg-none" id="mobileSidebarToggle" aria-label="Menu">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <nav class="admin-breadcrumb">
                        <a asp-controller="ThongKe" asp-action="Index">Admin</a>
                        <i class="fa-solid fa-chevron-right" style="font-size: 10px; color: var(--text-faint);"></i>
                        <span class="admin-breadcrumb-current">@ViewData["Title"]</span>
                    </nav>
                </div>

                <div class="admin-topbar-right">
                    <!-- Search Input -->
                    <div class="admin-top-search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" id="globalAdminSearch" placeholder="Tìm kiếm nhanh... (Ctrl+K)" />
                    </div>

                    <!-- Storefront Switch -->
                    <a asp-controller="Account" asp-action="SwitchRole" asp-route-role="User" class="admin-storefront-btn" title="Xem giao diện khách hàng">
                        <i class="fa-solid fa-store"></i>
                        <span>Storefront ↗</span>
                    </a>

                    <!-- Notification Bell -->
                    <button type="button" class="admin-icon-btn" title="Thông báo hệ thống">
                        <i class="fa-regular fa-bell"></i>
                        <span class="admin-badge-dot"></span>
                    </button>

                    <!-- Theme Toggle -->
                    <button type="button" class="admin-icon-btn" id="theme-toggle" title="Đổi giao diện sáng/tối">
                        <i class="fa-regular fa-moon"></i>
                    </button>

                    <!-- Profile Avatar -->
                    <div class="admin-avatar" style="width: 32px; height: 32px; font-size: 12px; cursor: pointer;" title="Tài khoản Admin">
                        AD
                    </div>
                </div>
            </header>

            <!-- Main Workspace -->
            <main role="main" class="admin-content-view">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="admin-card p-3 mb-4 d-flex align-items-center gap-3" style="background: var(--status-success-bg); border-color: var(--status-success-border); color: var(--status-success);">
                        <i class="fa-solid fa-circle-check fs-5"></i>
                        <div>
                            <strong>Thành công:</strong> @TempData["SuccessMessage"]
                        </div>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="admin-card p-3 mb-4 d-flex align-items-center gap-3" style="background: var(--status-danger-bg); border-color: var(--status-danger-border); color: var(--status-danger);">
                        <i class="fa-solid fa-triangle-exclamation fs-5"></i>
                        <div>
                            <strong>Lưu ý:</strong> @TempData["ErrorMessage"]
                        </div>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Mobile Sidebar Toggle
        const toggleBtn = document.getElementById('mobileSidebarToggle');
        const sidebar = document.getElementById('adminSidebar');
        if (toggleBtn && sidebar) {
            toggleBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                sidebar.classList.toggle('open');
            });
            document.addEventListener('click', (e) => {
                if (!sidebar.contains(e.target) && !toggleBtn.contains(e.target)) {
                    sidebar.classList.remove('open');
                }
            });
        }

        // Global search shortcut (Ctrl + K)
        document.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                e.preventDefault();
                const s = document.getElementById('globalAdminSearch');
                if (s) s.focus();
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
