<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] - PhoneStore Flagship</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/commerce.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/filter-dock.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storefront-buttons.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="storefront-body">
    <!-- ================= PUBLIC ANIMATED TOP DOCK COMMAND BAR ================= -->
    <partial name="_StoreHeader" />


    <!-- ================= MAIN STOREFRONT VIEW ================= -->
    <main role="main" class="view">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="validate-line v-ok mb-4" style="border-radius: 12px; margin-bottom: 20px;">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.3 2.3 4.7-5.6"/></svg>
                <div><b>Thành công!</b><span>@TempData["SuccessMessage"]</span></div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="validate-line v-err mb-4" style="border-radius: 12px; margin-bottom: 20px;">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.8L2.8 17a1.6 1.6 0 0 0 1.4 2.4h15.6a1.6 1.6 0 0 0 1.4-2.4L13.7 3.8a1.6 1.6 0 0 0-2.8 0z"/></svg>
                <div><b>Thông báo:</b><span>@TempData["ErrorMessage"]</span></div>
            </div>
        }

        @RenderBody()
    </main>

    <!-- ================= SHARED FOOTER ================= -->
    @await Html.PartialAsync("_Footer")

    <partial name="_SupportWidget" />
    <script src="~/js/account.js" asp-append-version="true"></script>
    <script src="~/js/support-chat.js" asp-append-version="true"></script>
    <script src="~/js/filter-dock.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/product-cart.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
