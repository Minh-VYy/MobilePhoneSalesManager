<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] - PhoneStore 3D XML</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/filter-dock.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        /* Public Storefront Navbar Specific Styles */
        .user-header {
            position: sticky;
            top: 0;
            z-index: 50;
            background: color-mix(in srgb, var(--bg-0) 85%, transparent);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            padding: 14px 32px;
        }

        .user-nav-wrap {
            max-width: 1360px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .user-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-menu-links {
            display: flex;
            align-items: center;
            gap: 28px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .user-menu-links a {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-muted);
            transition: color 0.2s ease;
            position: relative;
        }

        .user-menu-links a:hover, .user-menu-links a.active {
            color: var(--primary-2);
        }

        .user-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .role-switch-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(108, 107, 245, 0.12);
            border: 1px solid rgba(108, 107, 245, 0.3);
            padding: 5px 12px;
            border-radius: 99px;
            font-size: 12.5px;
            font-weight: 600;
            color: var(--primary-2);
        }

        .role-switch-btn {
            background: linear-gradient(135deg, #F0596B, #E0231C);
            color: #fff;
            border: none;
            padding: 6px 14px;
            border-radius: 99px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(240, 89, 107, 0.35);
            transition: transform 0.15s ease;
        }
        .role-switch-btn:hover {
            transform: scale(1.05);
        }
    </style>
</head>
<body>
    <!-- ================= PUBLIC ANIMATED TOP DOCK COMMAND BAR ================= -->
    <header class="atd-modern-wrapper">
        <div class="atd-modern__aurora" aria-hidden="true"></div>
        <nav class="atd-modern__bar" aria-label="Primary Navigation">
            <!-- Brand Left -->
            <a asp-controller="Home" asp-action="Index" class="atd-modern__brand" title="Trang chủ">
                <img src="~/images/logo.png" alt="Logo" class="site-logo-img" />
            </a>

            <!-- Dock Items Center (Capsule Proximity Dock - Desktop & Tablet) -->
            <!-- Dock Center (Search & Actions) -->
            <div class="atd-modern__dock ps-nav-new" aria-label="Primary">
                <!-- Danh mục / Bộ lọc (mở mega menu kính) -->
                

                <!-- Khu vực -->
                <button type="button" class="ps-nav-item fd-trigger" id="fd-trigger" aria-haspopup="true" aria-expanded="false" aria-controls="fd-mega">
                    <div class="ps-nav-icon"><i class="fa-solid fa-table-cells-large"></i></div>
                    <div class="ps-nav-tx"><span>Danh mục</span><b>Bộ lọc <i class="fa-solid fa-caret-down"></i></b></div>
                </button>                <div class="ps-nav-loc">
                    <span>Khu vực</span>
                    <b>Đà Nẵng <i class="fa-solid fa-caret-down"></i></b>
                </div>

                <!-- Search -->
                <form class="ps-nav-search" method="get" asp-controller="DienThoai" asp-action="Index" role="search">
                    <input type="hidden" name="category" value="ALL" />
                    <input type="search" name="keyword" placeholder="Tìm điện thoại..." aria-label="Tìm sản phẩm" />
                    <button type="submit" aria-label="Tìm kiếm"><i class="fa-solid fa-magnifying-glass"></i></button>
                </form>

                <!-- Hotline -->
                <a href="tel:0901176222" class="ps-nav-item">
                    <div class="ps-nav-icon"><i class="fa-solid fa-phone-volume"></i></div>
                    <div class="ps-nav-tx"><span>Hotline</span><b>0901.176.222</b></div>
                </a>

                <!-- Bảo hành -->
                <a href="#" class="ps-nav-item">
                    <div class="ps-nav-icon"><i class="fa-solid fa-shield-halved"></i></div>
                    <div class="ps-nav-tx"><span>Chính sách</span><b>bảo hành</b></div>
                </a>

                <!-- Kiểm tra đơn hàng -->
                <a asp-controller="DienThoai" asp-action="XsltView" class="ps-nav-item ps-nav-item--box">
                    <div class="ps-nav-icon"><i class="fa-solid fa-box-open"></i></div>
                    <div class="ps-nav-tx"><span>Kiểm Tra</span><b>Đơn Hàng</b></div>
                </a>
                
                <!-- Giỏ hàng -->
                <a asp-controller="DienThoai" asp-action="Cart" class="ps-nav-item" aria-label="Mở giỏ hàng">
                    <div class="ps-nav-icon ps-nav-cart">
                        <i class="fa-solid fa-cart-shopping"></i>
                        <span class="ps-cart-badge" data-cart-badge hidden>0</span>
                    </div>
                    <div class="ps-nav-tx"><span>Giỏ</span><b>Hàng</b></div>
                </a>
            </div>

            <!-- Actions Right (Theme Toggle, Auth Capsule & Mobile Toggle) -->
            <div class="atd-modern__actions">
                <!-- Theme Toggle -->
                <button class="icon-btn" id="theme-toggle" aria-label="Đổi giao diện sáng/tối" title="Đổi giao diện sáng/tối" style="width: 34px; height: 34px; border-radius: 50%;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 15px; height: 15px;"><circle cx="12" cy="12" r="4.5"/><path d="M12 2.5v2.5M12 19v2.5M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2.5 12H5M19 12h2.5M4.2 19.8L6 18M18 6l1.8-1.8"/></svg>
                </button>

                @if (Context.Session.GetString("IsLoggedIn") == "true")
                {
                    <span class="atd-modern__ghost desktop-only">@Context.Session.GetString("Username")</span>
                    <a asp-controller="Account" asp-action="Logout" class="atd-modern__cta desktop-only">
                        <span>Đăng Xuất</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="ps-nav-login desktop-only">
                        <div class="ps-nav-icon"><i class="fa-regular fa-user"></i></div>
                        <div class="ps-nav-tx"><span>Đăng</span><b>Nhập</b></div>
                    </a>
                }

                <!-- Mobile Menu Hamburger Toggle Button -->
                <button class="atd-mobile-toggle" id="mobile-menu-toggle" aria-label="Mở menu điều hướng" aria-expanded="false">
                    <i class="fa-solid fa-bars icon-open"></i>
                    <i class="fa-solid fa-xmark icon-close" style="display: none;"></i>
                </button>
            </div>
        </nav>

        <!-- Mobile Drawer Glass Menu Card (Aperture Dock Style) -->
        <div class="atd-mobile-drawer" id="mobile-drawer-menu" aria-hidden="true" inert>
            <div class="atd-mobile-drawer__content">
                <div class="atd-drawer-header">
                    <div class="atd-drawer-brand">
                        <img src="~/images/logo.png" alt="Logo" class="site-logo-img" />
                    </div>
                </div>
                <form class="atd-mobile-search" method="get" asp-controller="DienThoai" asp-action="Index" role="search">
                    <input type="hidden" name="category" value="ALL" />
                    <input type="search" name="keyword" placeholder="Tìm điện thoại..." aria-label="Tìm sản phẩm" />
                    <button type="submit" aria-label="Tìm kiếm"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                </form>
                <a asp-controller="Home" asp-action="Index" class="atd-mobile-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    <i class="fa-solid fa-house"></i> Trang Chủ
                </a>
                <a asp-controller="DienThoai" asp-action="Index" class="atd-mobile-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "DienThoai" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="fa-solid fa-mobile-screen"></i> Sản Phẩm Điện Thoại
                </a>
                <a asp-controller="DienThoai" asp-action="Cart" class="atd-mobile-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Cart" ? "active" : "")">
                    <i class="fa-solid fa-cart-shopping"></i> Giỏ hàng
                </a>
                <a asp-controller="DienThoai" asp-action="XsltView" class="atd-mobile-item @(ViewContext.RouteData.Values["action"]?.ToString() == "XsltView" ? "active" : "")">
                    <i class="fa-solid fa-receipt"></i> Tra Cứu Đơn Hàng
                </a>
                <a href="tel:0901176222" class="atd-mobile-item">
                    <i class="fa-solid fa-phone-volume"></i> Hotline 0901.176.222
                </a>
                <a asp-controller="Account" asp-action="SwitchRole" asp-route-role="Admin" class="atd-mobile-item" hidden>
                    <i class="fa-solid fa-user-shield"></i> Tài Khoản & Quản Lý
                </a>

                <div class="atd-mobile-drawer__divider"></div>

                @if (Context.Session.GetString("IsLoggedIn") == "true")
                {
                    <div class="atd-mobile-item" style="cursor:default;opacity:0.85">
                        <i class="fa-solid fa-user"></i> @Context.Session.GetString("Username")
                    </div>
                    <a asp-controller="Account" asp-action="Logout" class="atd-mobile-item atd-drawer-logout">
                        <i class="fa-solid fa-right-from-bracket"></i> Đăng Xuất
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="atd-drawer-cta">
                        <span>Đăng Nhập</span> <i class="fa-solid fa-arrow-right"></i>
                    </a>
                }
            </div>
        </div>

        <div class="fd-mega" id="fd-mega" aria-hidden="true">
            <partial name="_FilterDock" model="new QuanLyBanDienThoai.Models.SearchFilterViewModel()" />
        </div>
    </header>


    <!-- ================= MAIN STOREFRONT VIEW ================= -->
    <main role="main" class="view">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="validate-line v-ok mb-4" style="border-radius: 12px; margin-bottom: 20px;">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.3 2.3 4.7-5.6"/></svg>
                <div><b>Thành công!</b><span>@TempData["SuccessMessage"]</span></div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="validate-line v-err mb-4" style="border-radius: 12px; margin-bottom: 20px;">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.8L2.8 17a1.6 1.6 0 0 0 1.4 2.4h15.6a1.6 1.6 0 0 0 1.4-2.4L13.7 3.8a1.6 1.6 0 0 0-2.8 0z"/></svg>
                <div><b>Thông báo:</b><span>@TempData["ErrorMessage"]</span></div>
            </div>
        }

        @RenderBody()
    </main>

    <!-- ================= SHARED FOOTER ================= -->
    @await Html.PartialAsync("_Footer")

    <script src="~/js/filter-dock.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/product-cart.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
