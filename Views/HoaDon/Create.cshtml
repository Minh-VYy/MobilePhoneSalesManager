@model QuanLyBanDienThoai.Models.CreateHoaDonInputModel
@{
    ViewData["Title"] = "Lập Hóa Đơn Bán Hàng (POS XML)";
    var phoneList = (List<QuanLyBanDienThoai.Models.DienThoaiModel>)ViewBag.PhoneList;
}

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-3 p-3 mb-4 rounded-3" style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.35); color: var(--admin-danger);">
        <i class="fa-solid fa-triangle-exclamation fs-4"></i>
        <div>
            <strong>Không thể lập hóa đơn XML:</strong> @ViewBag.ErrorMessage
        </div>
    </div>
}

<form asp-action="Create" method="post" id="posForm">
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <!-- LEFT: PRODUCT PICK CATALOGUE -->
        <div class="col-lg-7 col-xl-8">
            <div class="admin-card">
                <div class="admin-card-header">
                    <div>
                        <h2 class="admin-card-title">
                            <i class="fa-solid fa-cash-register" style="color: var(--admin-primary);"></i>
                            <span>CHỌN SẢN PHẨM BÁN HÀNG</span>
                        </h2>
                        <div class="admin-card-desc">Nhấp chọn thiết bị để đưa trực tiếp vào danh sách chi tiết hóa đơn (ChiTietHoaDon node)</div>
                    </div>
                    <span class="admin-badge-brand brand-apple">
                        <i class="fa-solid fa-boxes-stacked"></i> Kho: @(phoneList?.Count ?? 0) mẫu
                    </span>
                </div>

                <div class="admin-card-body">
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px;" id="pick-grid">
                        @if (phoneList != null)
                        {
                            foreach (var phone in phoneList)
                            {
                                string brandClass = phone.MaHang.ToUpper() switch
                                {
                                    "APPLE" => "brand-apple",
                                    "SAMSUNG" => "brand-samsung",
                                    "XIAOMI" => "brand-xiaomi",
                                    "OPPO" => "brand-oppo",
                                    "GOOGLE" => "brand-google",
                                    _ => "brand-other"
                                };

                                <div class="admin-card p-3 d-flex flex-column justify-content-between cursor-pointer"
                                     style="margin-bottom: 0; background: rgba(255,255,255,0.03); border: 1px solid var(--admin-card-border); transition: all 0.2s ease; cursor: pointer;"
                                     onmouseover="this.style.borderColor='var(--admin-primary)'; this.style.transform='translateY(-2px)';"
                                     onmouseout="this.style.borderColor='var(--admin-card-border)'; this.style.transform='none';"
                                     onclick="addToCart('@phone.MaSP', '@phone.TenSP', @phone.GiaBan, '@phone.HinhAnh', @phone.SoLuongTon)">
                                    
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="admin-badge-brand @brandClass" style="font-size: 10px; padding: 2px 6px;">@phone.TenHang</span>
                                        <span style="font-family: var(--font-mono); font-size: 11px; color: @(phone.SoLuongTon < 5 ? "var(--admin-danger)" : "var(--admin-accent)"); font-weight: 600;">
                                            Tồn: @phone.SoLuongTon
                                        </span>
                                    </div>

                                    <div style="height: 100px; display: flex; align-items: center; justify-content: center; margin-bottom: 8px;">
                                        <img src="@phone.HinhAnh" alt="@phone.TenSP" style="max-height: 100%; max-width: 100%; object-fit: contain;"
                                             onerror="this.src='https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&amp;fit=crop&amp;w=600&amp;q=80'" />
                                    </div>

                                    <div>
                                        <div style="font-weight: 600; font-size: 13px; color: var(--admin-text-main); line-height: 1.3; margin-bottom: 4px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                            @phone.TenSP
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center pt-2" style="border-top: 1px solid var(--admin-card-border);">
                                            <span style="font-family: var(--font-mono); font-size: 13.5px; font-weight: 700; color: var(--amber-500);">
                                                @phone.GiaBan.ToString("#,##0")đ
                                            </span>
                                            <span class="admin-btn admin-btn-primary admin-btn-sm" style="width: 28px; height: 28px; padding: 0; border-radius: 50%;">
                                                <i class="fa-solid fa-plus" style="font-size: 11px;"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: LIVE CART & CUSTOMER ORDER FORM -->
        <div class="col-lg-5 col-xl-4">
            <div class="admin-card" style="position: sticky; top: 90px;">
                <div class="admin-card-header">
                    <div>
                        <h2 class="admin-card-title">
                            <i class="fa-solid fa-receipt" style="color: var(--admin-accent);"></i>
                            <span>HÓA ĐƠN ĐANG LẬP</span>
                        </h2>
                        <div class="admin-card-desc" id="cart-count">Chưa có sản phẩm nào</div>
                    </div>
                </div>

                <div class="admin-card-body">
                    <!-- DYNAMIC CART ITEMS -->
                    <div id="cart-items" style="max-height: 240px; overflow-y: auto; padding-right: 4px; margin-bottom: 16px;">
                        <div class="text-center py-4" style="color: var(--admin-text-faint);">
                            <i class="fa-solid fa-cart-arrow-down fs-2 mb-2 d-block opacity-50"></i>
                            <div style="font-size: 13px;">Nhấp chọn sản phẩm bên trái để thêm vào đơn hàng</div>
                        </div>
                    </div>

                    <!-- HIDDEN INPUTS FOR ASP.NET BINDING -->
                    <div id="hidden-inputs-container"></div>

                    <!-- CUSTOMER INFORMATION -->
                    <div class="pt-3" style="border-top: 1px solid var(--admin-card-border);">
                        <div class="mb-2">
                            <label class="admin-form-label">Tên khách hàng (*):</label>
                            <input asp-for="TenKH" class="admin-form-control" placeholder="Nguyễn Văn A" required />
                        </div>
                        <div class="mb-2">
                            <label class="admin-form-label">Số điện thoại (*):</label>
                            <input asp-for="SoDienThoai" class="admin-form-control" placeholder="09xxxxxxxx" required />
                            <small style="color: var(--admin-text-faint); font-size: 11px; font-family: var(--font-mono);">XSD: (0[3|5|7|8|9])+[0-9]{8}</small>
                        </div>
                        <div class="mb-2">
                            <label class="admin-form-label">Địa chỉ giao hàng (*):</label>
                            <input asp-for="DiaChi" class="admin-form-control" placeholder="123 Nguyễn Huệ, Q.1, TP.HCM" required />
                        </div>
                        <div class="mb-2">
                            <label class="admin-form-label">Thu ngân lập đơn:</label>
                            <input asp-for="NhanVien" class="admin-form-control" value="Phạm Minh Thu (Admin)" />
                        </div>
                        <div class="mb-3">
                            <label class="admin-form-label">Ghi chú:</label>
                            <input asp-for="GhiChu" class="admin-form-control" placeholder="Giao giờ hành chính..." />
                        </div>
                    </div>

                    <!-- TOTAL AND CHECKOUT -->
                    <div class="p-3 mb-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--admin-card-border); display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-size: 13px; color: var(--admin-text-muted); font-weight: 500;">Tổng tiền hóa đơn:</span>
                        <b style="font-family: var(--font-mono); font-size: 18px; color: var(--amber-500);" id="cart-total">0 VNĐ</b>
                    </div>

                    <button type="submit" class="admin-btn admin-btn-primary w-100" id="btn-checkout" style="height: 44px; font-size: 14.5px;" disabled>
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                        <span>Lập &amp; Lưu Hóa Đơn XML</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        const cartState = {}; // maSp -> { maSp, tenSp, giaBan, qty, img, maxStock }

        function addToCart(maSp, tenSp, giaBan, img, maxStock) {
            if (!cartState[maSp]) {
                cartState[maSp] = { maSp, tenSp, giaBan, qty: 1, img, maxStock };
            } else {
                if (cartState[maSp].qty < maxStock) {
                    cartState[maSp].qty++;
                } else {
                    if (typeof showToast === 'function') {
                        showToast(`Sản phẩm ${tenSp} chỉ còn tồn ${maxStock} máy trong kho!`);
                    } else {
                        alert(`Sản phẩm ${tenSp} chỉ còn tồn ${maxStock} máy trong kho!`);
                    }
                }
            }
            renderCart();
        }

        function changeQty(maSp, delta) {
            if (cartState[maSp]) {
                cartState[maSp].qty += delta;
                if (cartState[maSp].qty <= 0) {
                    delete cartState[maSp];
                }
            }
            renderCart();
        }

        function renderCart() {
            const container = document.getElementById('cart-items');
            const hiddenContainer = document.getElementById('hidden-inputs-container');
            const checkoutBtn = document.getElementById('btn-checkout');
            const cartCountEl = document.getElementById('cart-count');
            const cartTotalEl = document.getElementById('cart-total');

            const keys = Object.keys(cartState);
            hiddenContainer.innerHTML = '';

            if (keys.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-4" style="color: var(--admin-text-faint);">
                        <i class="fa-solid fa-cart-arrow-down fs-2 mb-2 d-block opacity-50"></i>
                        <div style="font-size: 13px;">Nhấp chọn sản phẩm bên trái để thêm vào đơn hàng</div>
                    </div>
                `;
                checkoutBtn.disabled = true;
                cartCountEl.innerText = 'Chưa có sản phẩm nào';
                cartTotalEl.innerText = '0 VNĐ';
                return;
            }

            checkoutBtn.disabled = false;
            let total = 0;
            let totalQty = 0;
            let html = '';

            keys.forEach((maSp, index) => {
                const item = cartState[maSp];
                const itemTotal = item.giaBan * item.qty;
                total += itemTotal;
                totalQty += item.qty;

                html += `
                    <div class="d-flex align-items-center justify-content-between p-2 mb-2 rounded-2" style="background: rgba(255,255,255,0.03); border: 1px solid var(--admin-card-border);">
                        <div style="width: 36px; height: 36px; border-radius: 6px; overflow: hidden; background: rgba(0,0,0,0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 10px;">
                            <img src="${item.img}" style="max-height: 100%; max-width: 100%; object-fit: contain;" onerror="this.src='https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&fit=crop&w=600&q=80'" />
                        </div>
                        <div style="flex: 1; min-width: 0; margin-right: 8px;">
                            <div style="font-size: 12.5px; font-weight: 600; color: var(--admin-text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${item.tenSp}</div>
                            <div style="font-size: 11.5px; font-family: var(--font-mono); color: var(--amber-500);">${item.giaBan.toLocaleString('vi-VN')}đ</div>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <button type="button" class="admin-btn admin-btn-secondary" style="width: 24px; height: 24px; padding: 0; font-size: 12px; border-radius: 4px;" onclick="changeQty('${item.maSp}', -1)">-</button>
                            <span style="font-family: var(--font-mono); font-size: 12px; font-weight: 600; min-width: 20px; text-align: center;">${item.qty}</span>
                            <button type="button" class="admin-btn admin-btn-secondary" style="width: 24px; height: 24px; padding: 0; font-size: 12px; border-radius: 4px;" onclick="changeQty('${item.maSp}', 1)">+</button>
                        </div>
                    </div>
                `;

                hiddenContainer.innerHTML += `
                    <input type="hidden" name="Items[${index}].MaSP" value="${item.maSp}" />
                    <input type="hidden" name="Items[${index}].SoLuong" value="${item.qty}" />
                `;
            });

            container.innerHTML = html;
            cartCountEl.innerText = `${keys.length} mẫu sản phẩm (${totalQty} máy)`;
            cartTotalEl.innerText = total.toLocaleString('vi-VN') + ' VNĐ';
        }
    </script>
}

