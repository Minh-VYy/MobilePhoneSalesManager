@model CreateHoaDonInputModel
@using System.Globalization
@using System.Text.Json
@{
    ViewData["Title"] = "Bán hàng tại quầy";
    var phones = ViewBag.PhoneList as List<DienThoaiModel> ?? [];
    var vi = CultureInfo.GetCultureInfo("vi-VN");
}
<header class="overview-heading"><div><p class="overview-eyebrow">Bán hàng tại quầy</p><h1>Lập hóa đơn bán hàng</h1><p>Tìm phiên bản, chọn số lượng và kiểm tra thông tin khách trước khi lưu.</p></div><a asp-action="Index" class="btn-saas btn-saas-secondary"><i class="fa-solid fa-receipt" aria-hidden="true"></i> Lịch sử hóa đơn</a></header>
@if (ViewBag.ErrorMessage != null) { <p class="admin-feedback admin-feedback--error" role="alert">@ViewBag.ErrorMessage</p> }
<form asp-action="Create" method="post" class="admin-pos" data-pos data-pos-lookup-url="@Url.Action("Lookup", "StockUnits")">
    <input type="hidden" asp-for="CheckoutToken" />
    <div asp-validation-summary="All" class="admin-form-errors" role="alert"></div>
    @if (ViewBag.ValidationResult is ValidationResultModel validation && !validation.IsValid) { <ul class="admin-form-errors">@foreach (var error in validation.Errors) { <li>@error.Message</li> }</ul> }
    <section class="admin-card admin-pos-scanner" aria-labelledby="pos-scanner-title">
        <div><h2 id="pos-scanner-title"><i class="fa-solid fa-barcode" aria-hidden="true"></i> Quét IMEI / serial</h2><p>Đặt con trỏ vào ô dưới, quét bằng máy quét dạng bàn phím và kết thúc bằng Enter. Có thể nhập mã thủ công.</p></div>
        <div class="admin-pos-scan-input"><label for="pos-scan-code" class="sr-only">IMEI hoặc serial máy cần bán</label><input type="text" id="pos-scan-code" data-pos-scan-code maxlength="80" placeholder="Quét mã trên hộp hoặc thân máy…" autocomplete="off" spellcheck="false" autofocus="@ViewData.ModelState.IsValid" /><button type="button" class="btn-saas btn-saas-primary" data-pos-scan-button>Kiểm tra &amp; thêm máy</button></div>
        <p class="admin-pos-scan-result" data-pos-scan-result role="status" hidden></p>
        <a class="admin-row-link" data-pos-scan-reference hidden>Xem giao dịch liên quan</a>
        <a asp-controller="StockUnits" asp-action="Index" class="admin-row-link">Đăng ký / tra cứu mã máy</a>
    </section>
    <div class="admin-pos-layout">
        <section class="admin-card">
            <header class="overview-section-heading"><div><h2>Chọn sản phẩm</h2><p>Giá và tồn kho được kiểm tra lại khi lưu hóa đơn.</p></div><span class="admin-muted">@phones.Count phiên bản</span></header>
            <div class="admin-list-controls"><label>Tìm trong kho<input type="search" placeholder="Tên, mã, cấu hình…" data-pos-search /></label><label>Thương hiệu<select data-pos-brand><option value="">Tất cả</option>@foreach (var brand in phones.GroupBy(x => x.MaHang)) { <option value="@brand.Key">@brand.First().TenHang</option> }</select></label></div>
            <div class="admin-pos-products">
            @foreach (var phone in phones.OrderByDescending(x => x.SoLuongTon > 0).ThenBy(x => x.TenSP))
            {
                <button type="button" class="admin-pos-product" data-pos-pick="@phone.MaSP" disabled="@(phone.SoLuongTon <= 0)">
                    <span class="admin-pos-product-top"><small>@phone.TenHang</small><small data-pos-stock>@(phone.SoLuongTon > 0 ? $"Còn {phone.SoLuongTon} máy" : "Hết hàng")</small></span>
                    <img src="@phone.HinhAnh" alt="" loading="lazy" />
                    <b>@phone.TenSP</b><small>@phone.ThongSo.RAM · @phone.ThongSo.BoNhoTrong</small>
                    <span class="admin-pos-product-price"><strong>@phone.GiaBan.ToString("N0", vi) ₫</strong><i class="fa-solid fa-plus" aria-hidden="true"></i></span>
                </button>
            }
            </div>
            <p class="admin-empty-note" data-pos-no-results hidden>Không có sản phẩm phù hợp với bộ lọc.</p>
        </section>
        <aside class="admin-card admin-pos-checkout">
            <header class="overview-section-heading"><div><h2>Hóa đơn đang lập</h2><p data-pos-count>Chưa có sản phẩm được chọn.</p></div></header>
            <div class="admin-pos-cart" data-pos-cart></div>
            <div data-pos-inputs></div>
            <p class="admin-form-errors admin-pos-error" data-pos-error role="alert" hidden></p>
            <div class="admin-form-grid">
                <div class="admin-form-field admin-form-field--full"><label asp-for="TenKH">Tên khách hàng *</label><input asp-for="TenKH" class="form-input" maxlength="100" autocomplete="name" required /><span asp-validation-for="TenKH"></span></div>
                <div class="admin-form-field admin-form-field--full"><label asp-for="SoDienThoai">Số điện thoại *</label><input asp-for="SoDienThoai" class="form-input" type="tel" inputmode="tel" pattern="0[35789][0-9]{8}" maxlength="10" autocomplete="tel" required /><span asp-validation-for="SoDienThoai"></span></div>
                <div class="admin-form-field admin-form-field--full"><label asp-for="DiaChi">Địa chỉ nhận hàng</label><input asp-for="DiaChi" class="form-input" maxlength="250" autocomplete="street-address" /><small>Có thể để trống nếu khách nhận trực tiếp tại quầy.</small><span asp-validation-for="DiaChi"></span></div>
                <div class="admin-form-field admin-form-field--full"><label asp-for="NhanVien">Nhân viên lập hóa đơn</label><input asp-for="NhanVien" class="form-input" readonly /></div>
                <div class="admin-form-field admin-form-field--full"><label asp-for="GhiChu">Ghi chú</label><textarea asp-for="GhiChu" class="form-textarea" rows="2" maxlength="1000"></textarea><span asp-validation-for="GhiChu"></span></div>
            </div>
            <footer class="admin-pos-summary"><div><span>Tổng tiền sản phẩm</span><strong data-pos-total>0 ₫</strong></div><p data-pos-unit-summary>Quét đủ mã máy trước khi xuất hóa đơn.</p><div class="admin-form-field"><label asp-for="PaymentMethod">Hình thức đã thanh toán</label><select asp-for="PaymentMethod" class="form-select"><option value="Cash">Tiền mặt</option><option value="BankTransfer">Chuyển khoản</option></select></div><label class="admin-check-field admin-pos-payment-check"><input asp-for="PaymentConfirmed" required /> Khách đã thanh toán đủ số tiền trên</label><span asp-validation-for="PaymentConfirmed" class="field-error"></span><p>Xác nhận sẽ đánh dấu các mã máy đã bán, trừ tồn và ghi nhận doanh thu tại quầy.</p><button type="submit" class="btn-saas btn-saas-primary" data-pos-submit disabled><i class="fa-solid fa-check" aria-hidden="true"></i> Xác nhận bán &amp; xuất hóa đơn</button></footer>
        </aside>
    </div>
</form>
<template id="pos-line-template"><article class="admin-pos-line"><div><b data-line-name></b><small data-line-price></small></div><div class="admin-pos-quantity"><button type="button" data-line-minus aria-label="Giảm số lượng">−</button><input type="number" min="1" data-line-quantity aria-label="Số lượng sản phẩm" /><button type="button" data-line-plus aria-label="Tăng số lượng">+</button><button type="button" data-line-remove aria-label="Xóa khỏi hóa đơn"><i class="fa-regular fa-trash-can" aria-hidden="true"></i></button></div></article></template>
<script type="application/json" id="pos-products">@Html.Raw(JsonSerializer.Serialize(phones.Select(x => new { id = x.MaSP, name = x.TenSP, brand = x.MaHang, brandName = x.TenHang, price = x.GiaBan, stock = x.SoLuongTon, storage = x.ThongSo.BoNhoTrong })))</script>
<script type="application/json" id="pos-selected">@Html.Raw(JsonSerializer.Serialize(Model.Items.Select(x => new { id = x.MaSP, quantity = x.SoLuong, codes = x.UnitCodes })))</script>
@section Scripts { <script src="~/js/admin-pos.js" asp-append-version="true"></script> }

