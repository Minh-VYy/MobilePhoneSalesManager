@model HoaDonModel
@{ ViewData["Title"] = "Hóa đơn " + Model.MaHD; }
<header class="overview-heading no-print">
    <div><p class="overview-eyebrow">Hóa đơn tại quầy</p><h1>@Model.MaHD</h1><p>Đối chiếu thông tin và in hóa đơn bán hàng cho khách.</p></div>
    <div class="overview-heading-actions"><a asp-action="Index" class="btn-saas btn-saas-secondary"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Danh sách hóa đơn</a><button type="button" onclick="window.print()" class="btn-saas btn-saas-primary"><i class="fa-solid fa-print" aria-hidden="true"></i> In hóa đơn</button></div>
</header>
@Html.Raw(ViewBag.HtmlContent)

