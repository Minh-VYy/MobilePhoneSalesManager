@{
    ViewData["Title"] = "Xem & In Hóa Đơn " + ViewBag.InvoiceCode;
}

<div class="admin-card no-print">
    <div class="admin-card-header" style="border-bottom: none; padding-bottom: 0;">
        <div>
            <h2 class="admin-card-title">
                <i class="fa-solid fa-print" style="color: var(--primary-blue);"></i>
                <span>Hóa đơn bán lẻ (Transform từ XSLT): @ViewBag.InvoiceCode</span>
            </h2>
        </div>
        <div class="d-flex gap-2">
            <button onclick="printInvoice()" class="admin-btn admin-btn-primary admin-btn-sm">
                <i class="fa-solid fa-print"></i>
                <span>In Hóa Đơn</span>
            </button>
            <a asp-action="Index" class="admin-btn admin-btn-secondary admin-btn-sm">
                <i class="fa-solid fa-arrow-left"></i>
                <span>Danh sách Hóa Đơn</span>
            </a>
        </div>
    </div>
</div>

<div class="invoice-container-wrapper">
    @Html.Raw(ViewBag.HtmlContent)
</div>

