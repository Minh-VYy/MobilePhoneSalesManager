@{
    ViewData["Title"] = "Xem & In Hóa Đơn " + ViewBag.InvoiceCode;
}

<div class="glass-card no-print">
    <div class="glass-card-header mb-0" style="border-bottom: none; padding-bottom: 0;">
        <div class="glass-card-title">
            <i class="fa-solid fa-print text-primary"></i>
            <span>HÓA ĐƠN BÁN LẺ (TRANSFORM TỪ XSLT): @ViewBag.InvoiceCode</span>
        </div>
        <div class="d-flex gap-2">
            <button onclick="printInvoice()" class="btn-custom btn-primary-custom">
                <i class="fa-solid fa-print"></i> In Hóa Đơn Trực Tiếp
            </button>
            <a asp-action="Index" class="btn-custom btn-secondary-custom">
                <i class="fa-solid fa-arrow-left"></i> Danh sách Hóa Đơn
            </a>
        </div>
    </div>
</div>

<div class="invoice-container-wrapper">
    @Html.Raw(ViewBag.HtmlContent)
</div>
