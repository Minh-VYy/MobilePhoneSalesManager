@model QuanLyBanDienThoai.Models.ValidationResultModel
@{
    ViewData["Title"] = "Kiểm Tra Dữ Liệu Đơn Hàng";
}

<div class="admin-card">
    <div class="admin-card-header">
        <div>
            <h2 class="admin-card-title">
                <i class="fa-solid fa-shield-halved" style="color: var(--status-success);"></i>
                <span>Báo Cáo Kiểm Tra Toàn Vẹn Đơn Hàng</span>
            </h2>
            <div class="admin-card-desc">Kiểm tra tính hợp lệ dữ liệu hóa đơn, mã khách hàng, số điện thoại và tổng tiền</div>
        </div>
        <a asp-action="Index" class="btn-saas btn-saas-secondary">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Trở về Danh sách</span>
        </a>
    </div>

    <div class="admin-card-body">
        <div class="d-flex flex-wrap gap-4 mb-4" style="font-size: 13.5px; color: var(--text-body);">
            <div><strong style="color: var(--text-muted);">Tập tin dữ liệu:</strong>&nbsp;
                <code style="background: var(--bg-surface-subtle); padding: 2px 8px; border-radius: var(--radius-sm); font-size: 12.5px;">@Model.FileName</code>
            </div>
            <div><strong style="color: var(--text-muted);">Quy tắc chuẩn hóa:</strong>&nbsp;
                <code style="background: var(--bg-surface-subtle); padding: 2px 8px; border-radius: var(--radius-sm); font-size: 12.5px;">@Model.SchemaName</code>
            </div>
        </div>

        @if (Model.IsValid)
        {
            <div class="d-flex align-items-center gap-3 p-4 rounded-3" style="background: var(--status-success-bg); border: 1px solid var(--status-success-border);">
                <i class="fa-solid fa-circle-check" style="font-size: 2.2rem; color: var(--status-success);"></i>
                <div>
                    <h4 style="margin: 0 0 4px; font-weight: 700; color: var(--status-success); font-size: 16px;">TẤT CẢ DỮ LIỆU ĐƠN HÀNG HOÀN TOÀN HỢP LỆ!</h4>
                    <p style="margin: 0; font-size: 13.5px; color: var(--text-body);">
                        Các hóa đơn và lịch sử giao dịch đều tuân thủ chính xác 100% quy tắc nghiệp vụ hệ thống.
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="p-4 rounded-3 mb-3" style="background: var(--status-danger-bg); border: 1px solid var(--status-danger-border);">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="fa-solid fa-circle-xmark" style="font-size: 1.6rem; color: var(--status-danger);"></i>
                    <h4 style="margin: 0; font-weight: 700; color: var(--status-danger); font-size: 15px;">PHÁT HIỆN SAI LỆCH DỮ LIỆU HÓA ĐƠN!</h4>
                </div>
                <p style="font-size: 13.5px; color: var(--text-body); margin-bottom: 16px;">
                    Có <strong style="color: var(--status-danger);">@Model.Errors.Count</strong> cảnh báo vi phạm ràng buộc dữ liệu:
                </p>

                <div class="table-wrapper">
                    <table class="table-saas">
                        <thead>
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Dòng</th>
                                <th>Cột</th>
                                <th>Mức độ</th>
                                <th>Nội dung thông báo lỗi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Errors.Count; i++)
                            {
                                var err = Model.Errors[i];
                                <tr>
                                    <td class="cell-code">@(i + 1)</td>
                                    <td class="cell-code">@err.LineNumber</td>
                                    <td class="cell-code">@err.LinePosition</td>
                                    <td>
                                        <span class="badge-pill danger">
                                            @err.Severity
                                        </span>
                                    </td>
                                    <td style="color: var(--status-danger); font-size: 13px;">@err.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
