@model List<QuanLyBanDienThoai.Models.HoaDonModel>
@{
    ViewData["Title"] = "Danh Sách Hóa Đơn (XML)";
}

<div class="glass-card">
    <div class="glass-card-header">
        <div class="glass-card-title">
            <i class="fa-solid fa-receipt text-success"></i>
            <span>QUẢN LÝ HÓA ĐƠN BÁN HÀNG XML</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn-custom btn-success-custom">
                <i class="fa-solid fa-cart-shopping"></i> Lập Hóa Đơn Mới (POS)
            </a>
            <a asp-action="ValidateXsd" class="btn-custom btn-secondary-custom">
                <i class="fa-solid fa-shield-check"></i> Validate XSD Hóa Đơn
            </a>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert-custom alert-warning">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <div>Chưa có hóa đơn nào trong tệp XML.</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Mã HĐ</th>
                        <th>Ngày Lập</th>
                        <th>Khách Hàng</th>
                        <th>Số Điện Thoại</th>
                        <th>Thu Ngân</th>
                        <th>Số Sản Phẩm</th>
                        <th>Tổng Tiền (VNĐ)</th>
                        <th style="text-align: right;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model)
                    {
                        <tr>
                            <td><strong class="text-success">@inv.MaHD</strong></td>
                            <td>@inv.NgayLap.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><strong>@inv.KhachHang.TenKH</strong></td>
                            <td><span class="text-muted">@inv.KhachHang.SoDienThoai</span></td>
                            <td>@inv.NhanVien</td>
                            <td><span class="badge-xml">@inv.ChiTiet.Sum(x => x.SoLuong) SP</span></td>
                            <td><strong style="color: #34d399; font-size: 1.05rem;">@inv.TongTien.ToString("#,##0")</strong></td>
                            <td style="text-align: right;">
                                <a asp-action="Print" asp-route-id="@inv.MaHD" class="btn-custom btn-primary-custom" style="padding: 6px 14px; font-size: 0.85rem;">
                                    <i class="fa-solid fa-print"></i> Xem &amp; In XSLT
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
