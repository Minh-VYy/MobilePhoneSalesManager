@model List<HoaDonModel>
@using System.Globalization
@{ ViewData["Title"] = "Hóa đơn tại quầy"; var vi = CultureInfo.GetCultureInfo("vi-VN"); var total = Model.Sum(x => x.TongTien); }
<header class="overview-heading">
    <div><p class="overview-eyebrow">Bán hàng tại quầy</p><h1>Hóa đơn bán hàng</h1><p>Tra cứu giao dịch POS và in lại hóa đơn cho khách.</p></div>
    <a asp-action="Create" class="btn-saas btn-saas-primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> Lập hóa đơn</a>
</header>
<section class="overview-metrics overview-metrics--three" aria-label="Tổng hợp hóa đơn POS">
    <article class="overview-metric"><span>Hóa đơn đã lập</span><strong>@Model.Count</strong><p>Toàn bộ giao dịch tại quầy</p><i class="fa-solid fa-receipt" aria-hidden="true"></i></article>
    <article class="overview-metric"><span>Doanh số tại quầy</span><strong>@total.ToString("N0", vi) ₫</strong><p>Tổng tiền các hóa đơn đã lập</p><i class="fa-solid fa-coins" aria-hidden="true"></i></article>
    <article class="overview-metric"><span>Giá trị trung bình / hóa đơn</span><strong>@(Model.Count > 0 ? (total / Model.Count).ToString("N0", vi) : "0") ₫</strong><p>Theo toàn bộ hóa đơn hiện có</p><i class="fa-solid fa-chart-simple" aria-hidden="true"></i></article>
</section>
<section class="admin-card" data-admin-list data-admin-list-noun="hóa đơn">
    <header class="overview-section-heading"><div><h2>Lịch sử hóa đơn POS</h2><p>Sắp xếp theo thời gian lập mới nhất.</p></div></header>
    <div class="admin-list-controls"><label>Tìm hóa đơn<input type="search" data-admin-keyword placeholder="Mã hóa đơn, khách hàng, số điện thoại…" /></label><span data-admin-list-count role="status">@Model.Count hóa đơn</span></div>
    <div class="admin-table-scroll">
        <table class="admin-data-table">
            <thead><tr><th>Mã hóa đơn / thời gian</th><th>Khách hàng</th><th>Nhân viên</th><th>Thanh toán</th><th class="num">Số máy</th><th class="num">Tổng tiền</th><th>Thao tác</th></tr></thead>
            <tbody>
            @foreach (var invoice in Model)
            {
                <tr data-admin-row data-search="@invoice.MaHD @invoice.KhachHang.TenKH @invoice.KhachHang.SoDienThoai @invoice.NhanVien @string.Join(" ", invoice.ChiTiet.SelectMany(line => line.UnitCodes))">
                    <td><b>@invoice.MaHD</b><small>@invoice.NgayLap.ToString("dd/MM/yyyy HH:mm")</small></td>
                    <td>@invoice.KhachHang.TenKH<small>@invoice.KhachHang.SoDienThoai</small></td>
                    <td>@invoice.NhanVien</td>
                    <td>@(invoice.PaymentMethod switch { "Cash" => "Tiền mặt", "BankTransfer" => "Chuyển khoản", _ => "Chưa ghi nhận" })</td>
                    <td class="num">@invoice.ChiTiet.Sum(x => x.SoLuong)</td>
                    <td class="num"><b>@invoice.TongTien.ToString("N0", vi) ₫</b></td>
                    <td><a asp-action="Print" asp-route-id="@invoice.MaHD" class="admin-row-link"><i class="fa-solid fa-print" aria-hidden="true"></i>&nbsp; Xem / in hóa đơn</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <p class="admin-empty-note" data-admin-empty hidden>Chưa có hóa đơn phù hợp với nội dung tìm kiếm.</p>
    <partial name="_AdminPagination" />
</section>
