@model ThongKeViewModel
@using System.Globalization
@using System.Text.Json
@{
    ViewData["Title"] = "Tổng quan cửa hàng";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    string Money(decimal value) => value.ToString("N0", vi) + " ₫";
    string Share(decimal value) => Model.TongDoanhThu == 0 ? "0%" : (value / Model.TongDoanhThu).ToString("P1", vi);
    string Change(decimal value, decimal previous) => previous == 0 ? (value == 0 ? "Không đổi · hai kỳ bằng 0" : "Kỳ trước bằng 0 · không tính %") : ((value - previous) / previous).ToString("+0.0%;-0.0%;0.0%", vi) + " so với kỳ trước";
    string Direction(decimal value, decimal previous) => value == previous ? "flat" : value > previous ? "up" : "down";
    var soldBrands = Model.DoanhThuTheoHang.Where(x => x.SoLuongDaBan > 0).ToList();
    var chartBrands = soldBrands.Take(soldBrands.Count > 6 ? 5 : 6)
        .Select(x => new { label = x.TenHang, amount = x.TongTienBan, pos = x.DoanhThuPos, online = x.DoanhThuOnline }).ToList();
    if (soldBrands.Count > 6) { chartBrands.Add(new { label = "Các hãng còn lại", amount = soldBrands.Skip(5).Sum(x => x.TongTienBan), pos = soldBrands.Skip(5).Sum(x => x.DoanhThuPos), online = soldBrands.Skip(5).Sum(x => x.DoanhThuOnline) }); }
}
<header class="overview-heading">
    <div><p class="overview-eyebrow">Cửa hàng của bạn</p><h1>Tổng quan kinh doanh</h1><p>@Model.TuNgay.ToString("dd/MM/yyyy") – @Model.DenNgay.ToString("dd/MM/yyyy") · Giờ Việt Nam (UTC+7)</p></div>
    <div class="overview-heading-actions">
        <form method="get" asp-action="Index" class="overview-period">
            <label for="dashboard-days" class="sr-only">Khoảng thời gian thống kê</label>
            <select id="dashboard-days" name="days">
                @foreach (var days in new[] { 7, 30, 90 }) { <option value="@days" selected="@(!Model.TuChon && days == Model.SoNgay)">@days ngày gần đây</option> }
                <option value="0" selected="@Model.TuChon">Chọn khoảng ngày</option>
            </select>
            <div class="overview-custom-dates" id="overview-custom-dates" hidden="@(!Model.TuChon)"><label>Từ ngày<input type="date" name="from" value="@Model.TuNgay.ToString("yyyy-MM-dd")" disabled="@(!Model.TuChon)" required /></label><label>Đến ngày<input type="date" name="to" value="@Model.DenNgay.ToString("yyyy-MM-dd")" max="@DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(7)).ToString("yyyy-MM-dd")" disabled="@(!Model.TuChon)" required /></label></div>
            <button type="submit" class="btn-saas btn-saas-secondary">Áp dụng</button>
        </form>
        <a asp-controller="HoaDon" asp-action="Create" class="btn-saas btn-saas-primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> Lập hóa đơn</a>
    </div>
</header>
<partial name="_AdminQuickActions" />
<div asp-validation-summary="All" class="admin-form-errors" role="alert"></div>
<p class="overview-comparison-range"><span>Kỳ hiện tại: <b>@Model.TuNgay.ToString("dd/MM/yyyy") – @Model.DenNgay.ToString("dd/MM/yyyy")</b></span><span>So sánh với: <b>@Model.TuNgayKyTruoc.ToString("dd/MM/yyyy") – @Model.DenNgayKyTruoc.ToString("dd/MM/yyyy")</b> (@Model.SoNgay ngày)</span></p>
<p class="overview-source-note">Doanh thu tiền sản phẩm sau giảm giá đã lưu trong đơn. Ghi nhận khi chốt hóa đơn tại quầy hoặc giao đơn online thành công; chưa bao gồm tính lợi nhuận.</p>
@if (Model.SoGiaoDich == 0 && Model.NgayGiaoDichGanNhat is { } latest)
{
    <p class="overview-period-empty">Không có giao dịch hoàn tất trong kỳ này. Giao dịch gần nhất: <b>@latest.ToString("dd/MM/yyyy")</b>. <a asp-action="Index" asp-route-days="0" asp-route-from="@latest.AddDays(-Math.Min(6, latest.DayNumber)).ToString("yyyy-MM-dd")" asp-route-to="@latest.ToString("yyyy-MM-dd")">Xem 7 ngày gần giao dịch mới nhất</a></p>
}
@if (Model.SoHoaDonLechTong > 0 || Model.SoDonThieuNgayGiao > 0)
{
    <div class="overview-data-warning" role="status">
        <strong>Dữ liệu cần đối chiếu</strong>
        @if (Model.SoHoaDonLechTong > 0) { <p>@Model.SoHoaDonLechTong hóa đơn trong hai kỳ có tổng tiền khác chi tiết. Các biểu đồ thống nhất tính theo tổng số lượng × đơn giá đã lưu trong từng dòng hóa đơn.</p> }
        @if (Model.SoDonThieuNgayGiao > 0) { <p>@Model.SoDonThieuNgayGiao đơn đã giao trong toàn bộ dữ liệu thiếu ngày giao trong lịch sử, chưa được cộng vào kỳ nào.</p> }
    </div>
}
<section class="overview-metrics" aria-label="Kết quả kinh doanh trong kỳ đã chọn">
    <article class="overview-metric"><span>Doanh thu trong kỳ</span><strong>@Money(Model.TongDoanhThu)</strong><p class="overview-trend" data-direction="@Direction(Model.TongDoanhThu, Model.KyTruoc.Revenue)">@Change(Model.TongDoanhThu, Model.KyTruoc.Revenue)</p><p>Kỳ trước: @Money(Model.KyTruoc.Revenue)</p><i class="fa-solid fa-chart-line" aria-hidden="true"></i></article>
    <article class="overview-metric"><span>Giao dịch hoàn tất</span><strong>@Model.SoGiaoDich.ToString("N0", vi)</strong><p class="overview-trend" data-direction="@Direction(Model.SoGiaoDich, Model.KyTruoc.Transactions)">@Change(Model.SoGiaoDich, Model.KyTruoc.Transactions)</p><p>Kỳ trước: @Model.KyTruoc.Transactions · @Model.TongSoHoaDon hóa đơn quầy + @Model.SoDonDaGiao đơn online trong kỳ này</p><i class="fa-solid fa-receipt" aria-hidden="true"></i></article>
    <article class="overview-metric"><span>Số máy đã bán</span><strong>@Model.SoMayDaBan.ToString("N0", vi)</strong><p class="overview-trend" data-direction="@Direction(Model.SoMayDaBan, Model.KyTruoc.Units)">@Change(Model.SoMayDaBan, Model.KyTruoc.Units)</p><p>Kỳ trước: @Model.KyTruoc.Units máy</p><i class="fa-solid fa-mobile-screen-button" aria-hidden="true"></i></article>
    <article class="overview-metric"><span>Giá trị trung bình / giao dịch</span><strong>@Money(Model.GiaTriTrungBinh)</strong><p class="overview-trend" data-direction="@Direction(Model.GiaTriTrungBinh, Model.KyTruoc.Average)">@Change(Model.GiaTriTrungBinh, Model.KyTruoc.Average)</p><p>Kỳ trước: @Money(Model.KyTruoc.Average)</p><i class="fa-solid fa-calculator" aria-hidden="true"></i></article>
</section>
<div class="overview-grid">
    <section class="admin-card overview-chart" aria-labelledby="revenue-heading">
        <header class="overview-section-heading">
            <div><h2 id="revenue-heading">Doanh thu theo thời gian</h2><p>Tại quầy theo ngày lập; online theo ngày giao thành công.</p></div>
            <div class="overview-chart-control" hidden>
                <label for="overview-revenue-mode" class="sr-only">Cách so sánh doanh thu</label><select id="overview-revenue-mode"><option value="period">So sánh hai kỳ</option><option value="channel">So sánh kênh bán</option></select>
                <label for="overview-grouping">Gộp dữ liệu</label>
                <select id="overview-grouping"><option value="1" selected="@(Model.SoNgay <= 30)">Từng ngày</option><option value="7" selected="@(Model.SoNgay > 30)">Mỗi 7 ngày</option></select>
            </div>
        </header>
        <div class="overview-chart-summary">
            <div><span><i class="overview-dot overview-dot--pos" aria-hidden="true"></i> Tại quầy kỳ này</span><b>@Money(Model.DoanhThuPos)</b></div>
            <div><span><i class="overview-dot overview-dot--online" aria-hidden="true"></i> Online đã giao kỳ này</span><b>@Money(Model.DoanhThuOnline)</b></div>
        </div>
        <div class="overview-chart-frame overview-chart-frame--main" data-chart-frame hidden><canvas id="overview-revenue-chart" aria-label="Doanh thu theo thời gian so sánh hai kỳ hoặc hai kênh; dùng bộ chọn điểm dữ liệu bên dưới để đọc chi tiết." role="img"></canvas></div>
        <div class="overview-inspector" id="overview-inspector" hidden><label for="overview-inspect">Xem chi tiết mốc thời gian</label><select id="overview-inspect"></select><dl id="overview-inspect-values" aria-live="polite"></dl></div>
        <details class="overview-chart-data">
            <summary>Xem số liệu từng ngày (@Model.SoNgay ngày)</summary>
            <div class="admin-table-scroll"><table class="admin-data-table"><caption class="sr-only">Doanh thu từng ngày và ngày tương ứng của kỳ trước, đơn vị đồng</caption><thead><tr><th scope="col">Ngày kỳ này</th><th scope="col" class="num">Tại quầy</th><th scope="col" class="num">Online đã giao</th><th scope="col" class="num">Tổng kỳ này</th><th scope="col" class="num">Kỳ trước tương ứng</th><th scope="col" class="num">Chênh lệch</th></tr></thead>
                <tbody>@foreach (var day in Model.TheoNgay) { <tr><th scope="row">@day.Label</th><td class="num">@Money(day.Pos)</td><td class="num">@Money(day.Online)</td><td class="num"><b>@Money(day.Pos + day.Online)</b></td><td class="num">@Money(day.PreviousRevenue)<small>@day.PreviousLabel</small></td><td class="num">@Money(day.Pos + day.Online - day.PreviousRevenue)</td></tr> }</tbody>
                <tfoot><tr><th scope="row">Tổng kỳ</th><td class="num">@Money(Model.DoanhThuPos)</td><td class="num">@Money(Model.DoanhThuOnline)</td><td class="num">@Money(Model.TongDoanhThu)</td><td class="num">@Money(Model.KyTruoc.Revenue)</td><td class="num">@Money(Model.TongDoanhThu - Model.KyTruoc.Revenue)</td></tr></tfoot>
            </table></div>
        </details>
        <footer class="overview-section-foot" id="overview-grouping-note">Ngày không phát sinh ghi là 0. Đối chiếu theo vị trí ngày trong hai kỳ; hôm nay có thể chưa đủ ngày.</footer>
    </section>
    <section class="admin-card overview-chart" aria-labelledby="channel-heading">
        <header class="overview-section-heading"><div><h2 id="channel-heading">Kênh bán hàng</h2><p>Tỷ trọng trong tổng doanh thu của kỳ.</p></div></header>
        @if (Model.TongDoanhThu > 0)
        {
            <div class="overview-chart-frame overview-chart-frame--channel" data-chart-frame hidden><canvas id="overview-channel-chart" aria-label="Tỷ trọng doanh thu tại quầy và online; số tiền và tỷ lệ có trong bảng bên dưới." role="img"></canvas></div>
        }
        else { <p class="overview-chart-empty">Chưa có doanh thu để tính tỷ trọng.</p> }
        <div class="admin-table-scroll"><table class="admin-data-table"><thead><tr><th scope="col">Kênh bán</th><th scope="col" class="num">Doanh thu</th><th scope="col" class="num">Tỷ trọng</th></tr></thead><tbody>
            <tr><th scope="row"><i class="overview-dot overview-dot--pos" aria-hidden="true"></i>Tại quầy<small>@Model.TongSoHoaDon hóa đơn</small></th><td class="num">@Money(Model.DoanhThuPos)</td><td class="num">@Share(Model.DoanhThuPos)</td></tr>
            <tr><th scope="row"><i class="overview-dot overview-dot--online" aria-hidden="true"></i>Online đã giao<small>@Model.SoDonDaGiao đơn</small></th><td class="num">@Money(Model.DoanhThuOnline)</td><td class="num">@Share(Model.DoanhThuOnline)</td></tr>
        </tbody></table></div>
        <details class="overview-chart-data"><summary>Thanh toán tại quầy</summary>
            @if (Model.ThanhToanPos.Count == 0) { <p class="admin-empty-note">Chưa có hóa đơn tại quầy trong kỳ.</p> }
            else
            {
                <div class="admin-table-scroll"><table class="admin-data-table"><thead><tr><th scope="col">Phương thức</th><th scope="col" class="num">Hóa đơn</th><th scope="col" class="num">Số tiền</th></tr></thead><tbody>
                @foreach (var payment in Model.ThanhToanPos) { <tr><th scope="row">@payment.Label</th><td class="num">@payment.Count</td><td class="num">@Money(payment.Amount)</td></tr> }
                </tbody></table></div>
            }
        </details>
    </section>
</div>
<div class="overview-grid overview-grid--balanced">
    <section class="admin-card overview-chart" aria-labelledby="volume-heading">
        <header class="overview-section-heading"><div><h2 id="volume-heading">Giao dịch và số máy đã bán</h2><p>Hai cột cạnh nhau đối chiếu kỳ hiện tại và kỳ trước.</p></div><div class="overview-chart-control" hidden><label for="overview-volume-metric" class="sr-only">Chỉ số số lượng</label><select id="overview-volume-metric"><option value="transactions">Giao dịch hoàn tất</option><option value="units">Số máy đã bán</option></select></div></header>
        <div class="overview-chart-frame" data-chart-frame hidden><canvas id="overview-volume-chart" role="img" aria-label="So sánh số giao dịch hoặc số máy giữa hai kỳ; bảng số lượng bên dưới."></canvas></div>
        <details class="overview-chart-data"><summary>Xem số lượng từng ngày</summary><div class="admin-table-scroll"><table class="admin-data-table"><thead><tr><th scope="col">Ngày kỳ này / trước</th><th scope="col" class="num">Giao dịch kỳ này</th><th scope="col" class="num">Kỳ trước</th><th scope="col" class="num">Máy kỳ này</th><th scope="col" class="num">Kỳ trước</th></tr></thead><tbody>
        @foreach (var day in Model.TheoNgay) { <tr><th scope="row">@day.Label<small>@day.PreviousLabel</small></th><td class="num">@day.Transactions</td><td class="num">@day.PreviousTransactions</td><td class="num">@day.Units</td><td class="num">@day.PreviousUnits</td></tr> }
        </tbody><tfoot><tr><th scope="row">Tổng</th><td class="num">@Model.SoGiaoDich</td><td class="num">@Model.KyTruoc.Transactions</td><td class="num">@Model.SoMayDaBan</td><td class="num">@Model.KyTruoc.Units</td></tr></tfoot></table></div></details>
        <footer class="overview-section-foot">Mỗi giao dịch hoàn tất là một hóa đơn tại quầy hoặc một đơn online đã giao; một giao dịch có thể mua nhiều máy. Cùng cách gộp ngày với biểu đồ doanh thu.</footer>
    </section>
    <section class="admin-card overview-chart" aria-labelledby="status-heading">
        <header class="overview-section-heading"><div><h2 id="status-heading">Tiến độ đơn online</h2><p>@Model.SoDonTrongKy đơn được tạo trong kỳ · trạng thái tại thời điểm xem.</p></div></header>
        <div class="overview-chart-frame" data-chart-frame hidden><canvas id="overview-status-chart" role="img" aria-label="Số đơn tạo trong kỳ theo trạng thái hiện tại; bảng chi tiết bên dưới."></canvas></div>
        <details class="overview-chart-data"><summary>Xem số đơn và giá trị theo trạng thái</summary><div class="admin-table-scroll"><table class="admin-data-table"><thead><tr><th scope="col">Trạng thái</th><th scope="col" class="num">Số đơn</th><th scope="col" class="num">Giá trị sản phẩm</th></tr></thead><tbody>
        @foreach (var status in Model.TrangThaiDon) { <tr><th scope="row">@status.Label</th><td class="num">@status.Count</td><td class="num">@Money(status.Amount)</td></tr> }
        </tbody><tfoot><tr><th scope="row">Tổng đơn tạo trong kỳ</th><td class="num">@Model.SoDonTrongKy</td><td class="num">@Money(Model.TrangThaiDon.Sum(x => x.Amount))</td></tr></tfoot></table></div></details>
        <footer class="overview-section-foot">Giá trị đơn theo trạng thái chưa phải doanh thu. Biểu đồ này chọn đơn theo ngày tạo; doanh thu online chọn theo ngày giao, nên số đơn hai biểu đồ có thể khác nhau.</footer>
    </section>
</div>
<div class="overview-grid overview-grid--balanced">
    <section class="admin-card overview-chart" aria-labelledby="brand-heading">
        <header class="overview-section-heading"><div><h2 id="brand-heading">So sánh thương hiệu và kênh bán</h2><p>Cột riêng cho tại quầy và online · cùng thang doanh thu.</p></div></header>
        @if (soldBrands.Count > 0)
        {
            <div class="overview-chart-frame overview-chart-frame--bars" data-chart-frame hidden><canvas id="overview-brand-chart" role="img" aria-label="Xếp hạng doanh thu theo thương hiệu; bảng đầy đủ bên dưới."></canvas></div>
        }
        else { <p class="overview-chart-empty">Chưa có máy bán ra trong kỳ.</p> }
        <details class="overview-chart-data"><summary>Xem tất cả thương hiệu và tồn kho</summary>
            <div class="admin-table-scroll"><table class="admin-data-table"><thead><tr><th scope="col">Thương hiệu</th><th scope="col" class="num">Đã bán</th><th scope="col" class="num">Còn kho</th><th scope="col" class="num">Tại quầy</th><th scope="col" class="num">Online đã giao</th><th scope="col" class="num">Tổng doanh thu</th></tr></thead><tbody>
            @foreach (var brand in Model.DoanhThuTheoHang) { <tr><th scope="row">@brand.TenHang</th><td class="num">@brand.SoLuongDaBan</td><td class="num">@brand.SoLuongTon</td><td class="num">@Money(brand.DoanhThuPos)</td><td class="num">@Money(brand.DoanhThuOnline)</td><td class="num">@Money(brand.TongTienBan)</td></tr> }
            </tbody><tfoot><tr><th scope="row">Tổng</th><td class="num">@Model.SoMayDaBan</td><td class="num">@Model.TongTonKho</td><td class="num">@Money(Model.DoanhThuPos)</td><td class="num">@Money(Model.DoanhThuOnline)</td><td class="num">@Money(Model.TongDoanhThu)</td></tr></tfoot></table></div>
        </details>
        <footer class="overview-section-foot">Hãng theo danh mục hiện tại; mã đã xóa vào “Không phân loại”. Tồn kho là số hiện tại, không giới hạn theo kỳ.</footer>
    </section>
    <section class="admin-card overview-chart" aria-labelledby="product-heading">
        <header class="overview-section-heading"><div><h2 id="product-heading">Sản phẩm bán tốt</h2><p>6 phiên bản dẫn đầu theo chỉ số đã chọn.</p></div><div class="overview-chart-control" hidden><label for="overview-product-metric" class="sr-only">Xếp hạng sản phẩm theo</label><select id="overview-product-metric"><option value="amount">Doanh thu</option><option value="quantity">Số máy bán</option></select></div></header>
        @if (Model.SanPhamBanChay.Count > 0)
        {
            <div class="overview-chart-frame overview-chart-frame--bars" data-chart-frame hidden><canvas id="overview-product-chart" role="img" aria-label="Sáu phiên bản có doanh thu cao nhất; tên, mã và số lượng trong bảng bên dưới."></canvas></div>
        }
        else { <p class="overview-chart-empty">Chưa có sản phẩm bán ra trong kỳ.</p> }
        <details class="overview-chart-data"><summary>Xem đầy đủ sản phẩm đã bán (@Model.SanPhamBanChay.Count phiên bản)</summary>
            <div class="admin-table-scroll"><table class="admin-data-table"><thead><tr><th scope="col">Sản phẩm / phiên bản</th><th scope="col" class="num">Số máy</th><th scope="col" class="num">Doanh thu</th></tr></thead><tbody>
            @foreach (var product in Model.SanPhamBanChay) { <tr><th scope="row">@product.Name<small>@product.Id</small></th><td class="num">@product.Quantity</td><td class="num">@Money(product.Amount)</td></tr> }
            </tbody><tfoot><tr><th scope="row">Tổng tất cả sản phẩm</th><td class="num">@Model.SoMayDaBan</td><td class="num">@Money(Model.TongDoanhThu)</td></tr></tfoot></table></div>
        </details>
        <footer class="overview-section-foot">Mỗi dòng là một mã phiên bản (SKU); tên và đơn giá lấy từ giao dịch đã lưu. Bảng đầy đủ bao gồm cả các sản phẩm ngoài top 6.</footer>
    </section>
</div>
<section class="admin-card">
    <header class="overview-section-heading"><div><h2>Đơn trực tuyến gần nhất</h2><p>@Model.SoDonTrongKy đơn tạo trong kỳ · @Model.SoKhachHang tài khoản khách đã đăng ký. Danh sách bên dưới là các đơn mới nhất, mọi trạng thái.</p></div><a asp-controller="Orders" asp-action="Manage" class="overview-section-link">Quản lý đơn hàng <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></header>
    @if (Model.DonGanNhat.Count == 0) { <p class="admin-empty-note">Chưa có đơn hàng trực tuyến.</p> }
    else
    {
        <div class="admin-table-scroll"><table class="admin-data-table"><thead><tr><th>Mã đơn / ngày đặt</th><th>Khách hàng</th><th class="num">Số máy</th><th class="num">Tiền sản phẩm</th><th>Trạng thái</th><th><span class="sr-only">Thao tác</span></th></tr></thead><tbody>
        @foreach (var order in Model.DonGanNhat)
        {
            <tr><td><b>@order.Id</b><small>@order.CreatedAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</small></td><td>@order.CustomerName<small>@order.Phone</small></td><td class="num">@order.Items.Sum(x => x.Quantity)</td><td class="num">@Money(order.Total)</td><td><span class="order-status" data-status="@order.Status">@order.StatusLabel</span></td><td><a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="admin-row-link">Chi tiết</a></td></tr>
        }
        </tbody></table></div>
    }
</section>
<div class="overview-grid overview-grid--balanced">
    <section class="admin-card">
        <header class="overview-section-heading"><div><h2>Tồn kho cần chú ý</h2><p>Còn @Model.TongTonKho máy / @Model.TongSoSanPham phiên bản · @Model.SoSanPhamHetHang hết hàng · @Model.SoSanPhamSapHetHang sắp hết (dưới 5 máy)</p></div><a asp-controller="DienThoai" asp-action="Manage" asp-route-stock="LOW" class="overview-section-link">Xem kho <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></header>
        @if (Model.SanPhamSapHetHang.Count == 0) { <p class="admin-empty-note">Hiện không có phiên bản hết hàng hoặc tồn dưới 5 máy.</p> }
        else
        {
            <div class="overview-stock-list">@foreach (var phone in Model.SanPhamSapHetHang) { <a asp-controller="DienThoai" asp-action="Edit" asp-route-id="@phone.MaSP"><img src="@phone.HinhAnh" alt="" loading="lazy" /><span><b>@phone.TenSP</b><small>@phone.MaSP</small></span><strong class="@(phone.SoLuongTon == 0 ? "is-empty" : "")">@(phone.SoLuongTon == 0 ? "Hết hàng" : $"{phone.SoLuongTon} máy")</strong></a> }</div>
        }
        <footer class="overview-section-foot">Giá trị tồn theo giá bán: <b>@Money(Model.GiaTriTonKho)</b></footer>
    </section>
    <aside class="admin-card overview-work">
        <header class="overview-section-heading"><div><h2>Cần xử lý</h2><p>Đơn mua và yêu cầu hỗ trợ hiện tại, không giới hạn theo kỳ.</p></div></header>
        <a asp-controller="Orders" asp-action="Manage" asp-route-status="Pending" class="overview-work-total"><span><i class="fa-solid fa-bag-shopping" aria-hidden="true"></i> Đơn chờ xác nhận</span><strong>@Model.SoDonChoXacNhan</strong></a>
        <div class="overview-work-list">@foreach (var order in Model.DonChoXacNhan.Take(3)) { <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"><b>@order.CustomerName</b><small>@order.Id</small><span>@Money(order.Total)</span></a> }@if (Model.SoDonChoXacNhan == 0) { <p class="admin-empty-note">Đã xử lý hết đơn chờ xác nhận.</p> }</div>
        <a asp-controller="Support" asp-action="Index" class="overview-work-total"><span><i class="fa-regular fa-comments" aria-hidden="true"></i> Tin nhắn chưa đọc</span><strong>@Model.SoTinChuaDoc</strong></a>
        <div class="overview-work-list">@foreach (var message in Model.HoiThoaiChuaDoc.Take(2)) { <a asp-controller="Support" asp-action="Index"><b>@message.CustomerName</b><small>@message.Preview</small><span>@message.Unread tin</span></a> }@if (Model.SoTinChuaDoc == 0) { <p class="admin-empty-note">Không có tin nhắn chưa đọc.</p> }</div>
    </aside>
</div>
<script type="application/json" id="overview-data">@Html.Raw(JsonSerializer.Serialize(new {
    days = Model.TheoNgay,
    pos = Model.DoanhThuPos,
    online = Model.DoanhThuOnline,
    brands = chartBrands,
    products = Model.SanPhamBanChay,
    statuses = Model.TrangThaiDon
}, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/admin-overview.js" asp-append-version="true"></script>
}
