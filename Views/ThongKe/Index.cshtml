@model QuanLyBanDienThoai.Models.ThongKeViewModel
@{
    ViewData["Title"] = "Bảng điều khiển";
}

<!-- STAT CARDS ROW -->
<div class="stat-row">
    <div class="glass stat-card" style="--stat-accent:#6C6BF5">
        <div class="stat-top">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 17l5-5 4 4 8-9"/>
                </svg>
            </div>
            <span class="stat-trend trend-up"><i class="fa-solid fa-arrow-trend-up"></i> Tăng trưởng</span>
        </div>
        <div class="stat-value">@Model.TongDoanhThu.ToString("#,##0") <small style="font-size: 0.8rem; font-weight: 500;">VNĐ</small></div>
        <div class="stat-label">Tổng doanh thu bán hàng XML</div>
    </div>

    <div class="glass stat-card" style="--stat-accent:#3ECF8E">
        <div class="stat-top">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 3h9l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M9 12h6"/>
                </svg>
            </div>
            <span class="stat-trend trend-up">+@Model.TongSoHoaDon hóa đơn</span>
        </div>
        <div class="stat-value">@Model.TongSoHoaDon</div>
        <div class="stat-label">Hóa đơn đã lập trong hệ thống</div>
    </div>

    <div class="glass stat-card" style="--stat-accent:#F0B429">
        <div class="stat-top">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>
                </svg>
            </div>
        </div>
        <div class="stat-value">@Model.TongSoSanPham</div>
        <div class="stat-label">Mẫu điện thoại kinh doanh</div>
    </div>

    <div class="glass stat-card" style="--stat-accent:#F0596B">
        <div class="stat-top">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 9v4M12 17h.01"/><path d="M10.3 3.8L2.8 17a1.6 1.6 0 0 0 1.4 2.4h15.6a1.6 1.6 0 0 0 1.4-2.4L13.7 3.8a1.6 1.6 0 0 0-2.8 0z"/>
                </svg>
            </div>
            <span class="stat-trend trend-down">Tồn kho &lt; 5</span>
        </div>
        <div class="stat-value text-danger">@Model.SoSanPhamSapHetHang</div>
        <div class="stat-label">Sản phẩm sắp hết hàng</div>
    </div>
</div>

<!-- GRID 2: CHART & LOW STOCK ALERT -->
<div class="grid-2 mb-4">
    <!-- REVENUE CHART -->
    <div class="glass pad">
        <div class="section-title">
            Doanh thu theo hãng
            <small>Tổng hợp bằng LINQ to XML trên HoaDon.xml — Tự động cập nhật theo thời gian thực</small>
        </div>
        <div class="chart-wrap">
            <canvas id="chartRevenue"></canvas>
        </div>
    </div>

    <!-- LOW STOCK LIST -->
    <div class="glass pad">
        <div class="section-title">
            Cảnh báo tồn kho ít
            <small>Ngưỡng cảnh báo: dưới 5 máy cần nhập hàng</small>
        </div>

        @if (Model.SanPhamSapHetHang != null && Model.SanPhamSapHetHang.Count > 0)
        {
            @foreach (var sp in Model.SanPhamSapHetHang)
            {
                <div class="stock-row">
                    <div class="stock-thumb">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="7" y="2" width="10" height="20" rx="2.4"/></svg>
                    </div>
                    <div class="stock-info">
                        <b>@sp.TenSP</b>
                        <small>@sp.MaSP · @sp.TenHang</small>
                    </div>
                    <span class="qty-badge qty-critical">@sp.SoLuongTon máy</span>
                </div>
            }
        }
        else
        {
            <div class="text-center text-muted py-4">
                <i class="fa-solid fa-circle-check text-success fs-3 mb-2 d-block"></i>
                Tất cả điện thoại trong kho đều có số lượng an toàn!
            </div>
        }

        <div style="margin-top:14px;">
            <a asp-controller="DienThoai" asp-action="Manage" class="btn btn-ghost btn-sm" style="width:100%;justify-content:center;">
                Xem toàn bộ kho sản phẩm XML &rarr;
            </a>
        </div>
    </div>
</div>

<!-- BRAND ANALYTICS TABLE -->
<div class="glass mb-4">
    <div class="table-toolbar">
        <div class="section-title" style="margin:0;">
            Phân tích dữ liệu kinh doanh theo hãng
            <small>Dữ liệu tính toán từ tập tin XML</small>
        </div>
    </div>
    <table>
        <thead>
            <tr>
                <th>Mã Hãng</th>
                <th>Tên Hãng</th>
                <th class="num">Tổng Tồn Kho</th>
                <th class="num">Số Lượng Đã Bán</th>
                <th class="num">Doanh Thu Đạt Được (VNĐ)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var h in Model.DoanhThuTheoHang)
            {
                <tr>
                    <td class="mono">@h.MaHang</td>
                    <td><b>@h.TenHang</b></td>
                    <td class="num">@h.SoLuongTon máy</td>
                    <td class="num">@h.SoLuongDaBan máy</td>
                    <td class="num" style="color:var(--gold); font-weight:700;">@h.TongTienBan.ToString("#,##0") đ</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ctx = document.getElementById('chartRevenue');
            if (!ctx) return;

            const brandLabels = [
                @Html.Raw(string.Join(",", Model.DoanhThuTheoHang.Select(x => $"'{x.TenHang}'")))
            ];
            const revenueData = [
                @Html.Raw(string.Join(",", Model.DoanhThuTheoHang.Select(x => x.TongTienBan)))
            ];

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: brandLabels.length ? brandLabels : ['Apple', 'Samsung', 'Xiaomi', 'OPPO', 'Google'],
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: revenueData.length ? revenueData : [299900000, 279900000, 214900000, 150000000, 90000000],
                        backgroundColor: [
                            'rgba(108, 107, 245, 0.75)',
                            'rgba(62, 207, 142, 0.75)',
                            'rgba(240, 180, 41, 0.75)',
                            'rgba(240, 89, 107, 0.75)',
                            'rgba(156, 123, 240, 0.75)'
                        ],
                        borderColor: [
                            '#6C6BF5',
                            '#3ECF8E',
                            '#F0B429',
                            '#F0596B',
                            '#9C7BF0'
                        ],
                        borderWidth: 1.5,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { color: '#8B95AC' }
                        },
                        y: {
                            grid: { color: 'rgba(255, 255, 255, 0.06)' },
                            ticks: {
                                color: '#8B95AC',
                                callback: function (value) {
                                    return (value / 1000000).toLocaleString() + ' Tr';
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
