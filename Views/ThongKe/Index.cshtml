@model QuanLyBanDienThoai.Models.ThongKeViewModel
@{
    ViewData["Title"] = "Bảng điều khiển";
}

<!-- EXECUTIVE KPI STATS ROW -->
<div class="admin-stats-grid">
    <!-- Stat 1: Doanh thu -->
    <div class="admin-stat-card" style="--stat-glow: #6366F1;">
        <div class="admin-stat-top">
            <div class="admin-stat-icon">
                <i class="fa-solid fa-chart-line"></i>
            </div>
            <span class="admin-stat-pill pill-up">
                <i class="fa-solid fa-arrow-trend-up"></i> Tăng trưởng
            </span>
        </div>
        <div class="admin-stat-value">
            @Model.TongDoanhThu.ToString("#,##0") <small style="font-size: 13px; font-weight: 500; color: var(--admin-text-muted);">VNĐ</small>
        </div>
        <div class="admin-stat-label">Tổng doanh thu bán hàng XML</div>
    </div>

    <!-- Stat 2: Hóa đơn -->
    <div class="admin-stat-card" style="--stat-glow: #10B981;">
        <div class="admin-stat-top">
            <div class="admin-stat-icon">
                <i class="fa-solid fa-receipt"></i>
            </div>
            <span class="admin-stat-pill pill-up">
                +@Model.TongSoHoaDon đơn
            </span>
        </div>
        <div class="admin-stat-value">@Model.TongSoHoaDon</div>
        <div class="admin-stat-label">Hóa đơn XML đã lập</div>
    </div>

    <!-- Stat 3: Mẫu sản phẩm -->
    <div class="admin-stat-card" style="--stat-glow: #F59E0B;">
        <div class="admin-stat-top">
            <div class="admin-stat-icon">
                <i class="fa-solid fa-mobile-screen"></i>
            </div>
            <span class="admin-stat-pill" style="color: var(--admin-warning); background: rgba(245, 158, 11, 0.15);">
                DienThoai.xml
            </span>
        </div>
        <div class="admin-stat-value">@Model.TongSoSanPham</div>
        <div class="admin-stat-label">Mẫu điện thoại kinh doanh</div>
    </div>

    <!-- Stat 4: Sắp hết hàng -->
    <div class="admin-stat-card" style="--stat-glow: #F43F5E;">
        <div class="admin-stat-top">
            <div class="admin-stat-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <span class="admin-stat-pill pill-down">
                Tồn &lt; 5 máy
            </span>
        </div>
        <div class="admin-stat-value text-danger" style="color: var(--admin-danger) !important;">
            @Model.SoSanPhamSapHetHang
        </div>
        <div class="admin-stat-label">Sản phẩm sắp hết hàng</div>
    </div>
</div>

<!-- OPERATIONS GRID: CHART & LOW STOCK RADAR -->
<div class="row g-4 mb-4">
    <!-- REVENUE CHART -->
    <div class="col-lg-8">
        <div class="admin-card h-100 mb-0">
            <div class="admin-card-header">
                <div>
                    <h3 class="admin-card-title">
                        <i class="fa-solid fa-chart-column"></i>
                        <span>Doanh thu theo hãng sản xuất</span>
                    </h3>
                    <div class="admin-card-desc">Tổng hợp bằng LINQ to XML trên tập tin HoaDon.xml</div>
                </div>
                <span class="badge" style="background: rgba(99, 102, 241, 0.15); color: var(--admin-primary); font-family: var(--font-mono); font-size: 11px; padding: 4px 8px; border-radius: 6px;">
                    Real-time XML
                </span>
            </div>
            <div class="admin-card-body">
                <div style="height: 300px; position: relative;">
                    <canvas id="chartRevenue"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- LOW STOCK LIST RADAR -->
    <div class="col-lg-4">
        <div class="admin-card h-100 mb-0 d-flex flex-column">
            <div class="admin-card-header">
                <div>
                    <h3 class="admin-card-title">
                        <i class="fa-solid fa-bell text-danger"></i>
                        <span>Cảnh báo tồn kho ít</span>
                    </h3>
                    <div class="admin-card-desc">Ngưỡng: dưới 5 máy cần nhập kho</div>
                </div>
            </div>
            <div class="admin-card-body flex-grow-1" style="overflow-y: auto; max-height: 300px;">
                @if (Model.SanPhamSapHetHang != null && Model.SanPhamSapHetHang.Count > 0)
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var sp in Model.SanPhamSapHetHang)
                        {
                            <div class="d-flex align-items-center gap-3 p-2 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--admin-card-border);">
                                <div style="width: 38px; height: 38px; border-radius: 8px; background: rgba(244, 63, 94, 0.12); color: var(--admin-danger); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                    <i class="fa-solid fa-mobile-screen"></i>
                                </div>
                                <div style="flex: 1; min-width: 0;">
                                    <div class="text-truncate fw-semibold" style="font-size: 13px; color: var(--admin-text-main);">@sp.TenSP</div>
                                    <small style="font-family: var(--font-mono); font-size: 11px; color: var(--admin-text-faint);">@sp.MaSP · @sp.TenHang</small>
                                </div>
                                <span class="badge" style="background: rgba(244, 63, 94, 0.15); color: var(--admin-danger); font-family: var(--font-mono); font-weight: 700; font-size: 11px; border-radius: 99px; padding: 4px 8px;">
                                    @sp.SoLuongTon máy
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fa-solid fa-circle-check fs-1 text-success mb-2 d-block"></i>
                        <div>Tất cả sản phẩm đều có số lượng an toàn!</div>
                    </div>
                }
            </div>
            <div class="p-3 border-top" style="border-color: var(--admin-card-border) !important;">
                <a asp-controller="DienThoai" asp-action="Manage" class="admin-btn admin-btn-secondary w-100" style="justify-content: center;">
                    <span>Xem toàn bộ kho sản phẩm XML</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- BRAND ANALYTICS DATA TABLE -->
<div class="admin-card">
    <div class="admin-card-header">
        <div>
            <h3 class="admin-card-title">
                <i class="fa-solid fa-table-list"></i>
                <span>Phân tích dữ liệu kinh doanh theo hãng sản xuất</span>
            </h3>
            <div class="admin-card-desc">Báo cáo tổng hợp doanh thu và số lượng bán từ các tệp XML</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="HoaDon" asp-action="Index" class="admin-btn admin-btn-secondary admin-btn-sm">
                <i class="fa-solid fa-receipt"></i>
                <span>Xem hóa đơn</span>
            </a>
            <a asp-controller="DienThoai" asp-action="XsltView" class="admin-btn admin-btn-primary admin-btn-sm">
                <i class="fa-solid fa-file-code"></i>
                <span>Xem XSLT</span>
            </a>
        </div>
    </div>
    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Mã Hãng</th>
                    <th>Tên Hãng Sản Xuất</th>
                    <th class="text-end">Tổng Tồn Kho</th>
                    <th class="text-end">Số Lượng Đã Bán</th>
                    <th class="text-end">Doanh Thu Đạt Được (VNĐ)</th>
                    <th>Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model.DoanhThuTheoHang)
                {
                    string brandClass = h.MaHang.ToUpper() switch
                    {
                        "APPLE" => "brand-apple",
                        "SAMSUNG" => "brand-samsung",
                        "XIAOMI" => "brand-xiaomi",
                        "OPPO" => "brand-oppo",
                        "GOOGLE" => "brand-google",
                        _ => ""
                    };

                    <tr>
                        <td class="cell-code">@h.MaHang</td>
                        <td>
                            <span class="admin-badge-brand @brandClass">
                                @h.TenHang
                            </span>
                        </td>
                        <td class="cell-num">@h.SoLuongTon máy</td>
                        <td class="cell-num" style="color: var(--admin-accent);">@h.SoLuongDaBan máy</td>
                        <td class="cell-num" style="color: var(--amber-500); font-size: 14.5px;">
                            @h.TongTienBan.ToString("#,##0") đ
                        </td>
                        <td>
                            <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: var(--admin-accent); font-family: var(--font-mono); font-size: 11px;">
                                <i class="fa-solid fa-check me-1"></i> Đồng bộ
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ctx = document.getElementById('chartRevenue');
            if (!ctx) return;

            const brandLabels = [
                @Html.Raw(string.Join(",", Model.DoanhThuTheoHang.Select(x => $"'{x.TenHang}'")))
            ];
            const revenueData = [
                @Html.Raw(string.Join(",", Model.DoanhThuTheoHang.Select(x => x.TongTienBan)))
            ];

            const isDark = document.documentElement.getAttribute('data-theme') !== 'light';

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: brandLabels.length ? brandLabels : ['Apple', 'Samsung', 'Xiaomi', 'OPPO', 'Google'],
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: revenueData.length ? revenueData : [299900000, 279900000, 214900000, 150000000, 90000000],
                        backgroundColor: [
                            'rgba(99, 102, 241, 0.85)',
                            'rgba(16, 185, 129, 0.85)',
                            'rgba(245, 158, 11, 0.85)',
                            'rgba(244, 63, 94, 0.85)',
                            'rgba(6, 182, 212, 0.85)'
                        ],
                        borderColor: [
                            '#6366F1',
                            '#10B981',
                            '#F59E0B',
                            '#F43F5E',
                            '#06B6D4'
                        ],
                        borderWidth: 1.5,
                        borderRadius: 10,
                        maxBarThickness: 48
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: isDark ? 'rgba(15, 23, 42, 0.95)' : 'rgba(255, 255, 255, 0.95)',
                            titleColor: isDark ? '#fff' : '#0F172A',
                            bodyColor: isDark ? '#E2E8F0' : '#334155',
                            borderColor: 'rgba(99, 102, 241, 0.3)',
                            borderWidth: 1,
                            padding: 12,
                            boxPadding: 6,
                            usePointStyle: true,
                            callbacks: {
                                label: function(context) {
                                    return ' ' + context.parsed.y.toLocaleString('vi-VN') + ' VNĐ';
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { 
                                color: isDark ? '#94A3B8' : '#64748B',
                                font: { family: 'Inter', weight: 500 }
                            }
                        },
                        y: {
                            grid: { 
                                color: isDark ? 'rgba(255, 255, 255, 0.06)' : 'rgba(15, 23, 42, 0.06)',
                                drawBorder: false
                            },
                            ticks: {
                                color: isDark ? '#94A3B8' : '#64748B',
                                font: { family: 'Fira Code', size: 11 },
                                callback: function (value) {
                                    return (value / 1000000).toLocaleString() + ' Tr';
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
