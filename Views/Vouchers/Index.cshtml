@model List<VoucherDefinition>
@using System.Globalization
@{ ViewData["Title"] = "Mã & thẻ giảm giá"; var vi = CultureInfo.GetCultureInfo("vi-VN"); }
<header class="overview-heading"><div><p class="overview-eyebrow">Ưu đãi người mua</p><h1>Mã &amp; thẻ giảm giá</h1><p>Tạo mã cho đơn online, giới hạn lượt và công khai quyền lợi mua hàng.</p></div><div class="overview-heading-actions"><a asp-controller="Promotions" asp-action="Index" class="btn-saas btn-saas-secondary">Xem thẻ trên cửa hàng</a><a asp-action="Create" class="btn-saas btn-saas-primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> Tạo thẻ giảm giá</a></div></header>
<section class="overview-metrics overview-metrics--three" aria-label="Chương trình giảm giá"><article class="overview-metric"><span>Đang áp dụng</span><strong>@Model.Count(x => x.Available)</strong><p>Đúng thời hạn và còn lượt</p></article><article class="overview-metric"><span>Thẻ công khai khả dụng</span><strong>@Model.Count(x => x.Public && x.Available)</strong><p>Hiển thị trên cửa hàng và trang sản phẩm</p></article><article class="overview-metric"><span>Lượt đang giữ / đã dùng</span><strong>@Model.Sum(x => x.UsedCount)</strong><p>Đơn chưa hủy giữ lượt; hủy đơn sẽ trả lượt</p></article></section>
<section class="admin-card" data-admin-list data-admin-list-noun="mã giảm giá"><header class="overview-section-heading"><div><h2>Danh sách chương trình</h2><p>Các đơn đã lưu giữ nguyên số tiền khi bạn sửa chương trình.</p></div></header><div class="admin-list-controls"><label>Tìm mã hoặc nội dung<input type="search" data-admin-keyword placeholder="Mã, tên chương trình…" /></label><label>Hiệu lực<select data-admin-status><option value="">Tất cả</option><option value="active">Đang áp dụng</option><option value="inactive">Chưa / ngừng áp dụng</option></select></label><span data-admin-list-count role="status"></span></div>
<div class="admin-table-scroll"><table class="admin-data-table"><thead><tr><th>Mã / thẻ</th><th>Mức giảm</th><th>Thời hạn (UTC+7)</th><th>Lượt giữ / giới hạn</th><th>Phạm vi</th><th>Hiển thị</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var voucher in Model) { <tr data-admin-row data-search="@voucher.Code @voucher.Title @voucher.Description" data-status="@(voucher.Available ? "active" : "inactive")"><td><b>@voucher.Code</b><small>@voucher.Title</small></td><td>@voucher.DiscountLabel<small>Tối thiểu @voucher.MinOrderAmount.ToString("N0", vi) ₫ tiền sản phẩm áp dụng</small>@if (voucher.MaxDiscount.HasValue) { <small>Tối đa @voucher.MaxDiscount.Value.ToString("N0", vi) ₫</small> }</td><td>@voucher.StartDate?.ToString("dd/MM/yyyy")<small>đến @voucher.ExpiryDate?.ToString("dd/MM/yyyy")</small></td><td>@voucher.UsedCount / @voucher.UsageLimit<small>@voucher.PerAccountLimit lượt / tài khoản</small></td><td>@(voucher.ProductIds.Count == 0 ? "Tất cả sản phẩm" : $"{voucher.ProductIds.Count} phiên bản")</td><td>@(voucher.Public ? "Công khai" : "Theo mã riêng")</td><td>@voucher.StatusLabel</td><td><a asp-action="Edit" asp-route-id="@voucher.Code" class="admin-row-link">Chỉnh sửa</a><form asp-action="Toggle" method="post"><input type="hidden" name="code" value="@voucher.Code" /><input type="hidden" name="enabled" value="@((!voucher.Enabled).ToString().ToLowerInvariant())" /><button type="submit" class="admin-row-link">@(voucher.Enabled ? "Tắt mã" : "Bật mã")</button></form></td></tr> }
</tbody></table></div><p class="admin-empty-note" data-admin-empty hidden>Chưa có mã phù hợp.</p><partial name="_AdminPagination" /></section>
