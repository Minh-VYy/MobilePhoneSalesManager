@model VoucherFormViewModel
@{ ViewData["Title"] = Model.Editing ? "Chỉnh sửa thẻ giảm giá" : "Tạo thẻ giảm giá"; }
<header class="overview-heading"><div><p class="overview-eyebrow">Ưu đãi đơn online</p><h1>@ViewData["Title"]</h1><p>Mỗi đơn áp dụng một mã. Giá trị tối thiểu tính trên các sản phẩm được áp dụng.</p></div><a asp-action="Index" class="btn-saas btn-saas-secondary">Danh sách mã</a></header>
<form asp-action="Save" method="post" class="admin-card"><input type="hidden" name="editing" value="@Model.Editing.ToString().ToLowerInvariant()" /><div asp-validation-summary="All" class="admin-form-errors" role="alert"></div><div class="admin-form-grid">
<div class="admin-form-field"><label asp-for="Input.Code">Mã giảm giá *</label><input asp-for="Input.Code" maxlength="32" required readonly="@Model.Editing" class="form-input" /><small>Không đổi mã sau khi tạo để giữ lịch sử sử dụng.</small><span asp-validation-for="Input.Code"></span></div>
<div class="admin-form-field"><label asp-for="Input.Title">Tên thẻ / chương trình *</label><input asp-for="Input.Title" maxlength="120" required class="form-input" /><span asp-validation-for="Input.Title"></span></div>
<div class="admin-form-field"><label asp-for="Input.DiscountType">Cách giảm *</label><select asp-for="Input.DiscountType" class="form-select"><option value="FixedAmount">Số tiền (₫)</option><option value="Percentage">Phần trăm (%)</option></select></div>
<div class="admin-form-field"><label asp-for="Input.DiscountValue">Mức giảm *</label><input asp-for="Input.DiscountValue" type="number" min="0.01" max="1000000000" step="0.01" required class="form-input" /><small>Phần trăm không vượt 100%; số tiền dùng đồng Việt Nam nguyên.</small></div>
<div class="admin-form-field"><label asp-for="Input.MinOrderAmount">Giá trị sản phẩm áp dụng tối thiểu (₫)</label><input asp-for="Input.MinOrderAmount" type="number" min="0" max="1000000000000" step="1" required class="form-input" /></div>
<div class="admin-form-field"><label asp-for="Input.MaxDiscount">Giảm tối đa mỗi đơn (₫)</label><input asp-for="Input.MaxDiscount" type="number" min="1" max="1000000000" step="1" class="form-input" /><small>Để trống nếu không đặt trần; không giảm quá giá trị sản phẩm áp dụng.</small></div>
<div class="admin-form-field"><label asp-for="Input.StartDate">Từ ngày *</label><input asp-for="Input.StartDate" type="date" required class="form-input" /></div><div class="admin-form-field"><label asp-for="Input.ExpiryDate">Đến hết ngày *</label><input asp-for="Input.ExpiryDate" type="date" required class="form-input" /><small>Theo giờ Việt Nam (UTC+7).</small></div>
<div class="admin-form-field"><label asp-for="Input.UsageLimit">Tổng số lượt *</label><input asp-for="Input.UsageLimit" type="number" min="1" max="1000000" required class="form-input" /></div><div class="admin-form-field"><label asp-for="Input.PerAccountLimit">Số lượt mỗi tài khoản *</label><input asp-for="Input.PerAccountLimit" type="number" min="1" max="1000000" required class="form-input" /></div>
<div class="admin-form-field admin-form-field--full"><label asp-for="Input.ProductIds">Các phiên bản được áp dụng</label><select asp-for="Input.ProductIds" multiple size="7" class="form-select">@foreach (var product in Model.Products) { <option value="@product.MaSP">@product.MaSP · @product.TenSP</option> }</select><small>Không chọn phiên bản nào: áp dụng tất cả. Giữ Ctrl/Cmd để chọn nhiều phiên bản trên máy tính.</small></div>
<div class="admin-form-field admin-form-field--full"><label asp-for="Input.Description">Thông báo ưu đãi cho khách</label><textarea asp-for="Input.Description" rows="2" maxlength="400" class="form-textarea"></textarea></div>
<div class="admin-form-field admin-form-field--full"><label asp-for="Input.Benefits">Quyền lợi kèm theo / điều kiện nhận</label><textarea asp-for="Input.Benefits" rows="4" maxlength="1200" class="form-textarea" placeholder="Mỗi quyền lợi một dòng; ghi rõ điều kiện, thời hạn và sản phẩm áp dụng."></textarea><small>Chỉ ghi quyền lợi cửa hàng thực sự cung cấp. Nội dung này hiển thị trên thẻ, sản phẩm và banner liên kết; không tự tạo thêm quà tặng hay đổi chính sách bảo hành.</small></div>
<label class="admin-check-field"><input asp-for="Input.Enabled" /> Bật nhận mã</label><label class="admin-check-field"><input asp-for="Input.Public" /> Công khai thẻ trên cửa hàng</label>
</div><footer class="admin-panel-footer"><a asp-action="Index" class="btn-saas btn-saas-secondary">Hủy</a><button type="submit" class="btn-saas btn-saas-primary">Lưu thẻ giảm giá</button></footer></form>
