@model QuanLyBanDienThoai.Models.TinTucModel
@{
    ViewData["Title"] = Model.TieuDe;
    Layout = "_LayoutUser";
    var related = ViewBag.RelatedNews as List<QuanLyBanDienThoai.Models.TinTucModel> ?? new List<QuanLyBanDienThoai.Models.TinTucModel>();
}

<article class="article-detail-page" style="max-width: 960px; margin: 0 auto; padding: 24px 16px;">
    <!-- BREADCRUMB -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb" style="font-size: 13px;">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="TinTuc" asp-action="Index">Tin tức</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.DanhMuc</li>
        </ol>
    </nav>

    <!-- ARTICLE HEADER -->
    <header class="mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-primary" style="font-weight: 500; font-size: 12px;">@Model.DanhMuc</span>
            <span class="text-muted" style="font-size: 13px;"><i class="fa-regular fa-clock me-1"></i> @Model.NgayDang.ToString("dd/MM/yyyy HH:mm")</span>
            <span class="text-muted" style="font-size: 13px;">&middot; <i class="fa-regular fa-eye me-1"></i> @Model.LuotXem lượt xem</span>
        </div>
        <h1 class="h2 mb-3" style="font-weight: 800; color: var(--text-heading); line-height: 1.35;">
            @Model.TieuDe
        </h1>
        <div class="d-flex align-items-center justify-content-between p-3 rounded-3 glass mb-4" style="background: var(--bg-surface); border: 1px solid var(--border-default);">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-feather text-primary fs-5"></i>
                <div>
                    <div style="font-size: 13px; font-weight: 600;">@Model.TacGia</div>
                    <div class="text-muted" style="font-size: 11px;">Nguồn dữ liệu thời gian thực</div>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.LienKetGoc))
            {
                <a href="@Model.LienKetGoc" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary" style="border-radius: 8px; font-size: 12px;">
                    <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Xem bài viết gốc
                </a>
            }
        </div>
    </header>

    <!-- COVER IMAGE -->
    @if (!string.IsNullOrWhiteSpace(Model.HinhAnh))
    {
        <div class="mb-4 text-center rounded-4 overflow-hidden shadow-sm" style="max-height: 480px; background: rgba(0,0,0,0.2);">
            <img src="@Model.HinhAnh" alt="@Model.TieuDe" style="width: 100%; max-height: 480px; object-fit: cover;" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&fit=crop&w=800&q=80';" />
        </div>
    }

    <!-- SUMMARY LEAD -->
    <div class="p-3 mb-4 rounded-3" style="background: rgba(59, 130, 246, 0.08); border-left: 4px solid var(--accent-primary, #3b82f6); font-size: 16px; font-weight: 500; line-height: 1.6; color: var(--text-body);">
        @Model.TomTat
    </div>

    <!-- MAIN BODY CONTENT -->
    <div class="article-content mb-5" style="font-size: 16px; line-height: 1.8; color: var(--text-body);">
        @foreach (var paragraph in Model.NoiDung.Split(new[] { "\n\n", "\r\n\r\n" }, StringSplitOptions.RemoveEmptyEntries))
        {
            <p>@paragraph</p>
        }
    </div>

    <!-- CTA STORE EXPLORE -->
    <div class="p-4 rounded-3 glass text-center mb-5" style="border: 1px solid var(--border-default); background: var(--bg-surface);">
        <h4 class="h5 mb-2" style="font-weight: 700; color: var(--text-heading);">Khám Phá Các Dòng Smartphone Mới Nhất Tại PhoneStore</h4>
        <p class="text-muted mb-3" style="font-size: 14px;">Bảo hành 12 tháng chính hãng, thu cũ đổi mới trợ giá 3 triệu, trả góp 0% lãi suất.</p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="DienThoai" asp-action="Index" class="btn btn-primary px-4 py-2" style="border-radius: 10px; font-weight: 600;">Xem Cửa Hàng</a>
            <a asp-controller="TinTuc" asp-action="Index" class="btn btn-outline-secondary px-3 py-2" style="border-radius: 10px;">Về Trang Tin Tức</a>
        </div>
    </div>

    <!-- RELATED ARTICLES -->
    @if (related.Count > 0)
    {
        <section class="related-news mt-5" style="margin-top: 40px;">
            <h3 class="h5 mb-3" style="font-weight: 700; color: var(--text-heading); display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                <i class="fa-solid fa-layer-group text-primary"></i> Bài Viết Liên Quan
            </h3>
            <div class="related-news-grid">
                @foreach (var item in related)
                {
                    <a asp-action="Details" asp-route-id="@item.MaTT" class="related-news-card">
                        <div style="height: 130px; overflow: hidden; position: relative;">
                            <img src="@item.HinhAnh" alt="@item.TieuDe" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1598327105666-5b89351aff97?auto=format&fit=crop&w=400&q=80';" />
                            <span class="badge-tag badge-primary" style="position: absolute; top: 8px; left: 8px; font-size: 10px;">@item.DanhMuc</span>
                        </div>
                        <div style="padding: 12px; display: flex; flex-direction: column; flex-grow: 1;">
                            <span class="text-muted mb-1" style="font-size: 11px;"><i class="fa-regular fa-clock me-1"></i> @item.NgayDang.ToString("dd/MM/yyyy")</span>
                            <h5 style="font-size: 13px; font-weight: 600; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: var(--text-heading); margin-bottom: 0;">
                                @item.TieuDe
                            </h5>
                        </div>
                    </a>
                }
            </div>
        </section>
    }
</article>

<style>
.related-news-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
}
@@media (max-width: 900px) {
    .related-news-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}
@@media (max-width: 500px) {
    .related-news-grid {
        grid-template-columns: 1fr;
    }
}
.related-news-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-surface, #ffffff);
    border: 1px solid var(--border-default, rgba(0, 0, 0, 0.08));
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    height: 100%;
}
.related-news-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
    border-color: rgba(59, 130, 246, 0.45);
}
.badge-tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
}
.badge-tag.badge-primary {
    background: #3b82f6;
    color: #ffffff;
}
</style>
