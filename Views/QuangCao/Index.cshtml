@model List<QuangCaoModel>
@{ ViewData["Title"] = "Banner quảng cáo"; }
<header class="overview-heading">
    <div><p class="overview-eyebrow">Nội dung cửa hàng</p><h1>Banner quảng cáo</h1><p>Quản lý nội dung và các ảnh tự động trình chiếu trên trang chủ.</p></div>
    <a asp-action="Create" class="btn-saas btn-saas-primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> Thêm banner</a>
</header>
<section class="overview-metrics overview-metrics--three" aria-label="Tình trạng banner">
    <article class="overview-metric"><span>Tổng banner</span><strong>@Model.Count</strong><p>Nội dung đã lưu trong hệ thống</p><i class="fa-regular fa-images" aria-hidden="true"></i></article>
    <article class="overview-metric"><span>Đang hiển thị</span><strong>@Model.Count(x => x.DangHienThi)</strong><p>Được đưa vào trình chiếu trang chủ</p><i class="fa-regular fa-eye" aria-hidden="true"></i></article>
    <article class="overview-metric"><span>Chu kỳ trình chiếu</span><strong>@Model.Where(x => x.DangHienThi).Sum(x => x.ThoiGianChuyenGiay) giây</strong><p>Tổng thời gian các banner đang bật</p><i class="fa-regular fa-clock" aria-hidden="true"></i></article>
</section>
<section class="admin-card" data-admin-list data-admin-list-noun="banner">
    <header class="overview-section-heading"><div><h2>Danh sách banner</h2><p>Sắp xếp theo thứ tự trình chiếu; mở chỉnh sửa để xem trước nội dung.</p></div><a asp-controller="Home" asp-action="Index" class="admin-row-link">Xem trang chủ</a></header>
    <div class="admin-list-controls"><label>Tìm nội dung<input type="search" data-admin-keyword placeholder="Tiêu đề, mô tả…" /></label><label>Hiển thị<select data-admin-status><option value="">Tất cả</option><option value="active">Đang hiển thị</option><option value="hidden">Tạm ẩn</option></select></label><span data-admin-list-count role="status"></span></div>
    <div class="admin-banner-list">
    @foreach (var ad in Model.OrderBy(x => x.ThuTu))
    {
        <article class="admin-banner-row" data-admin-row data-search="@ad.TieuDe @ad.MoTa" data-status="@(ad.DangHienThi ? "active" : "hidden")">
            <img src="@Url.Content(ad.HinhAnh)" alt="@ad.TieuDe" loading="lazy" />
            <div class="admin-banner-content"><div><span class="inventory-stock @(ad.DangHienThi ? "" : "is-low")">@(ad.DangHienThi ? "Đang hiển thị" : "Tạm ẩn")</span><small>Thứ tự @ad.ThuTu · @ad.ThoiGianChuyenGiay giây / ảnh</small></div><h3>@ad.TieuDe</h3><p>@ad.MoTa</p><small class="admin-banner-source">@ad.HinhAnh</small></div>
            <div class="admin-banner-actions">
                <a asp-action="Edit" asp-route-id="@ad.MaQC" class="btn-saas btn-saas-secondary"><i class="fa-solid fa-pen" aria-hidden="true"></i> Chỉnh sửa</a>
                <form asp-action="Toggle" method="post"><input type="hidden" name="id" value="@ad.MaQC" /><input type="hidden" name="enabled" value="@(!ad.DangHienThi ? "true" : "false")" /><button type="submit" class="admin-row-link">@(ad.DangHienThi ? "Tạm ẩn" : "Bật hiển thị")</button></form>
                <form asp-action="Delete" method="post" data-confirm="Xóa banner @ad.TieuDe?"><input type="hidden" name="id" value="@ad.MaQC" /><button type="submit" class="admin-row-link inventory-delete"><i class="fa-regular fa-trash-can" aria-hidden="true"></i> Xóa</button></form>
            </div>
        </article>
    }
    </div>
    <p class="admin-empty-note" data-admin-empty hidden>Chưa có banner phù hợp. Bạn có thể thêm banner mới hoặc đổi điều kiện tìm kiếm.</p>
    <partial name="_AdminPagination" />
</section>
