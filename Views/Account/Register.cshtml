@model RegisterInput
@{ ViewData["Title"] = "Tạo tài khoản"; Layout = "_LayoutUser"; }
<section class="auth-page">
    <div class="auth-intro"><a asp-controller="Home" asp-action="Index" class="auth-back"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Về cửa hàng</a><h1>Bắt đầu cùng PhoneStore.</h1><p>Lưu thông tin nhận hàng, theo dõi mỗi đơn mua và nhận tư vấn khi bạn cần.</p></div>
    <div class="auth-panel glass">
        <h2>Tạo tài khoản</h2><p class="auth-caption">Thông tin của bạn giúp cửa hàng hỗ trợ đơn mua chính xác hơn.</p>
        <form asp-action="Register" method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>
            <partial name="_RegistrationFields" model="Model" />
            <button type="submit" class="store-action btn btn-primary account-submit">Tạo tài khoản</button>
        </form>
        <p class="auth-foot">Đã có tài khoản? <a asp-action="Login" class="store-action store-action--quiet store-action--compact">Đăng nhập <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></p>
    </div>
</section>
