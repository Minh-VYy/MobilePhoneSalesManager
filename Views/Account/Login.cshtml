@{
    ViewData["Title"] = "Đăng Nhập — PhoneStore 3D";
    Layout = "_LayoutUser";
}

<div style="max-width: 460px; margin: 40px auto; padding: 0 16px;">
    <div class="glass" style="padding: 36px 32px; border-radius: var(--radius-lg); box-shadow: 0 20px 50px -15px rgba(0,0,0,0.4);">
        <div style="text-align: center; margin-bottom: 28px;">
            <div class="brand-mark" style="margin: 0 auto 14px; width: 48px; height: 48px;">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><rect x="7" y="2" width="10" height="20" rx="2.4"/><line x1="11" y1="18.3" x2="13" y2="18.3"/></svg>
            </div>
            <h2 style="font-family: var(--font-head); font-weight: 800; font-size: 24px; margin: 0 0 6px;">ĐĂNG NHẬP HỆ THỐNG</h2>
            <p style="color: var(--text-muted); font-size: 13.5px; margin: 0;">Truy cập giao diện Khách hàng hoặc Bảng điều khiển Quản trị</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="validate-line v-err" style="margin-bottom: 20px; border-radius: 10px;">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.8L2.8 17a1.6 1.6 0 0 0 1.4 2.4h15.6a1.6 1.6 0 0 0 1.4-2.4L13.7 3.8a1.6 1.6 0 0 0-2.8 0z"/></svg>
                <div><b>Lỗi đăng nhập:</b><span>@ViewBag.Error</span></div>
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <!-- Role Selector Tabs -->
            <div class="field">
                <label>VAI TRÒ TRUY CẬP</label>
                <select name="role" id="login-role" class="field input" style="width: 100%;">
                    <option value="User">👤 Khách Hàng (User Storefront)</option>
                    <option value="Admin">🛡️ Quản Trị Viên (Admin Dashboard)</option>
                </select>
            </div>

            <div class="field">
                <label for="username">TÊN ĐĂNG NHẬP / EMAIL</label>
                <input type="text" id="username" name="username" placeholder="Nhập tên đăng nhập..." required />
            </div>

            <div class="field">
                <label for="password">MẬT KHẨU</label>
                <input type="password" id="password" name="password" placeholder="••••••••" required />
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; font-size: 12.5px;">
                <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; color: var(--text-muted);">
                    <input type="checkbox" name="rememberMe" style="accent-color: var(--primary);" /> Ghi nhớ đăng nhập
                </label>
                <a href="#" style="color: var(--primary-2);">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 12px; font-size: 14.5px;">
                <i class="fa-solid fa-right-to-bracket"></i> Đăng Nhập
            </button>
        </form>

        <!-- Fast Demo Quick Logins for Testing -->
        <div style="margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--border); text-align: center;">
            <div style="font-size: 12px; color: var(--text-faint); margin-bottom: 12px; font-family: var(--font-code);">
                ⚡ CHUYỂN NHANH DÀNH CHO KIỂM THỬ:
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <a asp-controller="Account" asp-action="SwitchRole" asp-route-role="User" class="btn btn-sm" style="justify-content: center;">
                    <i class="fa-solid fa-user"></i> Demo Khách Hàng
                </a>
                <a asp-controller="Account" asp-action="SwitchRole" asp-route-role="Admin" class="btn btn-primary btn-sm" style="justify-content: center; background: linear-gradient(135deg, #F0596B, #E0231C);">
                    <i class="fa-solid fa-shield-halved"></i> Demo Admin
                </a>
            </div>
        </div>
    </div>
</div>
