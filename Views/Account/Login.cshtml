@model LoginInput
@{ ViewData["Title"] = "Đăng nhập"; Layout = "_LayoutUser"; }
<section class="auth-page">
    <div class="auth-intro"><a asp-controller="Home" asp-action="Index" class="auth-back"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Về cửa hàng</a><h1>Chào bạn trở lại.</h1><p>Đăng nhập để theo dõi đơn hàng và trò chuyện với đội ngũ PhoneStore.</p></div>
    <div class="auth-panel glass">
        <h2>Đăng nhập</h2><p class="auth-caption">Sử dụng tài khoản bạn đã đăng ký.</p>
        <form asp-action="Login" method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>
            <input asp-for="ReturnUrl" type="hidden" />
            <label asp-for="Username">Tên đăng nhập hoặc email</label>
            <input asp-for="Username" autocomplete="username" maxlength="254" required autofocus />
            <span asp-validation-for="Username" class="field-error"></span>
            <label asp-for="Password">Mật khẩu</label>
            <div class="password-field"><input asp-for="Password" type="password" autocomplete="current-password" maxlength="128" required /><button type="button" data-toggle-password aria-label="Hiện mật khẩu" aria-pressed="false"><i class="fa-regular fa-eye" aria-hidden="true"></i></button></div>
            <span asp-validation-for="Password" class="field-error"></span>
            <button type="submit" class="store-action btn btn-primary account-submit">Đăng nhập <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
        </form>
        <p class="auth-foot">Chưa có tài khoản? <a asp-action="Register" class="store-action store-action--quiet store-action--compact">Đăng ký <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></p>
        <p class="auth-foot">Cần hỗ trợ tài khoản? <a href="tel:0901176222">Gọi 0901.176.222</a></p>
        @if (ViewBag.HasAdmin == false) { <a asp-action="Setup" class="auth-setup-link">Thiết lập quản trị viên lần đầu</a> }
    </div>
</section>
