@model ChangePasswordInput
@{ ViewData["Title"] = "Đổi mật khẩu"; Layout = User.IsInRole("Admin") ? "_Layout" : "_LayoutUser"; }
<section class="customer-page"><header class="customer-heading"><h1>Đổi mật khẩu</h1><p>Sau khi đổi mật khẩu, các phiên đăng nhập cũ sẽ hết hiệu lực.</p></header>
    @if (!User.IsInRole("Admin")) { <partial name="_BuyerNav" /> }
    <div class="account-card glass"><form asp-action="ChangePassword" method="post" class="account-form">
        <div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>
        <label asp-for="CurrentPassword">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" required /><span asp-validation-for="CurrentPassword" class="field-error"></span>
        <label asp-for="Password">Mật khẩu mới</label><div class="password-field"><input asp-for="Password" type="password" autocomplete="new-password" minlength="10" maxlength="128" required /><button type="button" data-toggle-password aria-label="Hiện mật khẩu" aria-pressed="false"><i class="fa-regular fa-eye" aria-hidden="true"></i></button></div><span asp-validation-for="Password" class="field-error"></span>
        <label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="10" maxlength="128" required /><span asp-validation-for="ConfirmPassword" class="field-error"></span>
        <button type="submit" class="store-action btn btn-primary account-submit">Lưu mật khẩu mới</button>
    </form></div>
</section>
